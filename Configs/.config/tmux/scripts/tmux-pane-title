#!/usr/bin/env bash
set -euo pipefail

LABEL_MAX_CHARS=18
HOST_MAX_CHARS=14
AGENT_TITLE_MAX_CHARS=24

plain=0
if [[ ${1:-} == --plain ]]; then plain=1; shift; fi
cmd="${1:-}"
tty="${2:-}"
pane_title="${3:-}"

trim_into() {
  local -n trimmed_ref="$1"
  local value="${2:-}" max="${3:-$LABEL_MAX_CHARS}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  trimmed_ref="${value:0:max}"
}

basename_into() {
  local -n base_ref="$1"
  local path="$2" suffix="${3:-}"
  if [[ $path == -?* ]]; then
    base_ref="$(basename "$path" ${suffix:+"$suffix"} 2>/dev/null || printf '%s' "$path")"
    return
  fi
  [[ $path =~ ^/+$ ]] && { base_ref=/; return; }
  path="${path%"${path##*[!/]}"}"
  path="${path##*/}"
  [[ -n $suffix && $path != "$suffix" ]] && path="${path%"$suffix"}"
  base_ref="$path"
}

foreground_process_into() {
  local -n proc_ref="$1" args_ref="$2"
  local tty="$3" stat="" fields=() last_proc="" last_args=""
  while read -r -a fields; do
    stat="${fields[0]}" last_proc="${fields[1]:-}" last_args="${fields[*]:2}"
    [[ $stat =~ ^[^TXZ\ ]*\+ ]] && break
  done < <(ps -t "$tty" -o stat= -o comm= -o args= 2>/dev/null)
  proc_ref="${last_proc##*/}" args_ref="$last_args"
}

resolve_process_into() {
  local -n process_name_ref="$1"
  local tty="$2" fallback="$3" proc="" args="" script=""
  [[ -n $tty ]] || { process_name_ref="${fallback:-shell}"; return; }
  foreground_process_into proc args "$tty"
  [[ -n $proc || -n $args ]] || { process_name_ref="${fallback:-shell}"; return; }

  if [[ $args =~ (^|[[:space:]/])(codex|claude|anthropic|aider)([[:space:]]|$) ]]; then
    process_name_ref="${BASH_REMATCH[2]}"
  elif [[ $args =~ (^|[[:space:]])(g?(view|n?vim?x?)(diff)?)([[:space:]]|$) ]]; then
    process_name_ref=nvim
  elif [[ $proc == node && $args =~ node([[:space:]]+[^[:space:]-][^[:space:]]*) ]]; then
    trim_into script "${BASH_REMATCH[1]}"
    basename_into script "$script" .js
    case "$script" in npm | npx | yarn | pnpm | bun) process_name_ref="$script" ;; *) trim_into process_name_ref "$script" ;; esac
  elif [[ $proc =~ ^python || $proc == uv ]]; then
    if [[ $args =~ python[^[:space:]]*[[:space:]]+-m[[:space:]]+([^[:space:]]+) ]]; then
      trim_into process_name_ref "${BASH_REMATCH[1]}"
    elif [[ $args =~ (^|[[:space:]])([^[:space:]]+\.py)([[:space:]]|$) ]]; then
      basename_into script "${BASH_REMATCH[2]}" .py
      trim_into process_name_ref "$script"
    else
      process_name_ref=python
    fi
  elif [[ $proc =~ ^(bash|zsh|sh|fish)$ && $args =~ ${proc}[[:space:]]+([^[:space:]-][^[:space:]]*) ]]; then
    basename_into script "${BASH_REMATCH[1]}"
    script="${script%.sh}"; script="${script%.bash}"; script="${script%.zsh}"
    if [[ $script =~ ^(\.|config|rc|profile)$ || -z $script ]]; then trim_into process_name_ref "$proc"; else trim_into process_name_ref "$script"; fi
  elif [[ $proc =~ ^(ssh|mosh)$ && $args =~ ${proc}[[:space:]]+([^[:space:]]+@)?([^[:space:]]+) ]]; then
    trim_into script "${BASH_REMATCH[2]}" "$HOST_MAX_CHARS"
    process_name_ref="$proc:$script"
  elif [[ $args =~ /nix/store/[^/]+/bin/([^[:space:]]+) ]]; then
    trim_into process_name_ref "${BASH_REMATCH[1]}"
  else
    trim_into process_name_ref "${proc:-${fallback:-shell}}"
  fi
}

resolved=""
resolve_process_into resolved "$tty" "$cmd" 2>/dev/null || true
[[ -n $resolved ]] && cmd="$resolved"

case "$cmd" in
  codex | claude | anthropic | aider)
    icon=󰚩; trim_into label "$pane_title"; trim_into label "${label:-$cmd}" "$AGENT_TITLE_MAX_CHARS" ;;
  nvim | vim | vi | view) icon=; label=nvim ;;
  zsh | bash | fish | sh) icon=; label="$cmd" ;;
  ssh:* | mosh:*) icon=󰣀; label="${cmd#*:}" ;;
  ssh | mosh) icon=󰣀; label="$cmd" ;;
  lazygit | git) icon=󰊢; label="$cmd" ;;
  ranger | yazi | lf) icon=; label="$cmd" ;;
  htop | btop | top) icon=󰓅; label="$cmd" ;;
  pytest | python | python3 | ipython) icon=; label="$cmd" ;;
  node | nodejs | npm | pnpm | yarn | bun | vite | next | deno | astro | tsx) icon=; label="$cmd" ;;
  cargo | rustc) icon=; label="$cmd" ;;
  docker | docker-compose | podman) icon=; label="$cmd" ;;
  tmux) icon=; label="$cmd" ;;
  '') icon=; label=shell ;;
  *) icon=; label="$cmd" ;;
esac

((plain)) && printf '%s\n' "$label" || printf ' %s %s \n' "$icon" "$label"
