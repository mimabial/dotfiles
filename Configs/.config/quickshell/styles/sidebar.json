{
  "#taskbar button": {
    "border": 1.2,
    "fill": ["bg", 0.3],
    "hover": { "fill": ["hvr_bg", 0.2], "outline": ["hvr_br", 0.4] },
    "margin": [2.0, 0.0, 2.0, 0.0],
    "outline": ["br", 0.0],
    "padding": [4.0, 2.0, 4.0, 2.0]
  },
  "cpuinfo": {
    "border": 1.2,
    "edge": { "color": ["c7", 0.4], "left": false, "right": false, "top": false },
    "hover": { "fill": null, "content": ["hvr_fg", 1.0] },
    "margin": [2.0, 0.0, 2.0, 0.0]
  },
  "fanspeedinfo": {
    "border": 1.2,
    "edge": { "color": ["c7", 0.4], "left": false, "right": false, "top": false },
    "fontSize": 12.0,
    "fontWeight": 700,
    "hover": { "fill": null, "content": ["hvr_fg", 1.0] },
    "justify": "right",
    "margin": [2.0, 0.0, 2.0, 0.0],
    "padding": [0.0, 2.0, 0.0, 2.0]
  },
  "gpuinfo": {
    "border": 1.2,
    "edge": { "color": ["c7", 0.4], "left": false, "right": false, "top": false },
    "hover": { "fill": null, "content": ["hvr_fg", 1.0] },
    "margin": [2.0, 0.0, 2.0, 0.0]
  },
  "hyprmenu": {
    "border": 1.0,
    "fill": null,
    "hover": { "fill": null, "outline": ["hvr_br", 0.55], "content": ["fg"] },
    "margin": [2.0, 1.5, 2.0, 1.5],
    "outline": ["br", 0.0],
    "padding": [4.0, 3.0, 4.0, 3.0]
  },
  "mediaplayer": { "edge": { "color": ["hvr_br", 0.7], "left": true } },
  "weather": { "hover": { "fill": null, "content": ["hvr_fg", 1.0] } },
  "disk": {
    "border": 1.2,
    "edge": { "color": ["c7", 0.4], "left": false, "right": false, "top": false },
    "hover": { "fill": null, "content": ["hvr_fg", 1.0] },
    "margin": [2.0, 0.0, 2.0, 0.0]
  },
  "memory": {
    "border": 1.2,
    "edge": { "color": ["c7", 0.4], "left": false, "right": false, "top": false },
    "hover": { "fill": null, "content": ["hvr_fg", 1.0] },
    "margin": [2.0, 0.0, 2.0, 0.0]
  },
  "taskbar": { "margin": [2.0, 0.0, 2.0, 0.0] },
  "tray": { "border": 1.5, "margin": [2.0, 2.0, 2.0, 2.0], "outline": ["alt_br", 0.0] },
  "workspaces": { "margin": [0.0, 0.0, 0.0, 0.0] },
  "#taskbar button.active": { "outline": ["act_br", 0.4] },
  "#workspaces button.active": {
    "border": 1.5,
    "fill": ["alt_bg", 0.1],
    "hover": { "fill": null, "outline": ["hvr_br", 0.4], "content": ["fg"] },
    "margin": [2.0, 1.0, 2.0, 1.0],
    "outline": ["act_br", 0.0]
  },
  "network.speed": { "hover": { "fill": null, "outline": null, "content": ["hvr_fg", 1.0] } }
}
