  "#workspaces button.active": {
    "border": 0,
    "fill": ["alt_bg", 0.1],
    "hover": { "outline": null, "fill": ["hvr_br", 0.4], "content": ["fg"] },
    "margin": [4.0, 2.0, 4.0, 2.0],
    "padding": [8.0, 0.0, 8.0, 0.0],
    "outline": ["act_br", 0.0]
  },
  "taskbar": { "margin": [0.0, 0.0, 0.0, 0.0], "iconSize": 30 },
  "#taskbar button": {
    "border": 2,
    "fill": ["bg", 0.1],
