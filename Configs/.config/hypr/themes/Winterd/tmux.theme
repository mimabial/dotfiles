$HOME/.config/tmux/theme.conf

set -g @color0 "#3f3f3f"
set -g @color1 "#295fb0"
set -g @color2 "#509be8"
set -g @color3 "#295fb0"
set -g @color4 "#509bee"
set -g @color5 "#70aae5"
set -g @color6 "#bbddff"
set -g @color7 "#c1c1c1"
set -g @color8 "#3f3f3f"
set -g @color9 "#509bee"
set -g @color10 "#70aae5"
set -g @color11 "#70aae5"
set -g @color12 "#509bee"
set -g @color13 "#295fb0"
set -g @color14 "#bbddff"
set -g @color15 "#e6e6e6"

set -g @theme_bg "#f3f3f3"
set -g @theme_black "#e6e6e6"
set -g @theme_fg "#3f3f3f"
set -g @theme_accent "#509bee"
set -g @theme_gray "#c1c1c1"
set -g @theme_red "#295fb0"
set -g @theme_green "#509be8"
set -g @theme_yellow "#70aae5"

set -g status-style "bg=default,fg=#3f3f3f"
set -g message-style "bg=#f3f3f3,fg=#295fb0"
set -g message-command-style "bg=#f3f3f3,fg=#295fb0"
set -g pane-border-style "fg=#c1c1c1"
set -g pane-active-border-style "fg=#509bee"
set -g window-status-style "fg=#c1c1c1"
set -g window-status-current-style "fg=#295fb0,bold"
set -g mode-style "bg=#bbddff,fg=#3f3f3f"
set -g clock-mode-colour "#509bee"
