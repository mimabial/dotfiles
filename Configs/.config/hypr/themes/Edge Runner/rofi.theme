$HOME/.config/rofi/theme.rasi
* {
    background:            #181818e6;
    background-alpha:    #18181859;
    foreground:            #FFDD33ff;
    border:                #ffa6c2ff;
    accent:                #2CF6B3ff;
    selected-background:   #5032ACff;
    selected-foreground:   #FADA16ff;
    separator:             #80808080;
    urgent:                #ffa6c2ff;
    active:                #f5e0dcff;
}
