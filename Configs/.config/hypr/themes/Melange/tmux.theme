$HOME/.config/tmux/theme.conf

# Standard 16 color palette
set -g @color0 "#E9E1DB"
set -g @color1 "#C77B8B"
set -g @color2 "#6E9B72"
set -g @color3 "#BC5C00"
set -g @color4 "#7892BD"
set -g @color5 "#BE79BB"
set -g @color6 "#739797"
set -g @color7 "#7D6658"
set -g @color8 "#A98A78"
set -g @color9 "#BF0021"
set -g @color10 "#3A684A"
set -g @color11 "#A06D00"
set -g @color12 "#465AA4"
set -g @color13 "#904180"
set -g @color14 "#3D6568"
set -g @color15 "#54433A"

# Semantic color aliases
set -g @theme_bg "#F1F1F1"
set -g @theme_black "#E9E1DB"
set -g @theme_fg "#54433A"
set -g @theme_accent "#7892BD"
set -g @theme_gray "#A98A78"
set -g @theme_red "#C77B8B"
set -g @theme_green "#6E9B72"
set -g @theme_yellow "#BC5C00"

# Tmux color settings
set -g status-style "bg=default,fg=#54433A"
set -g message-style "bg=#F1F1F1,fg=#BC5C00"
set -g message-command-style "bg=#F1F1F1,fg=#BC5C00"
set -g pane-border-style "fg=#7D6658"
set -g pane-active-border-style "fg=#739797"
set -g window-status-style "fg=#A98A78"
set -g window-status-current-style "fg=#BC5C00,bold"
set -g mode-style "bg=#BC5C00,fg=#F1F1F1"
set -g clock-mode-colour "#BC5C00"
