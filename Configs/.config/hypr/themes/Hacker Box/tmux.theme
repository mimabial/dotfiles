$HOME/.config/tmux/theme.conf

set -g @color0 "#000000"
set -g @color1 "#ff3e3e"
set -g @color2 "#9fef00"
set -g @color3 "#ffaf00"
set -g @color4 "#004cff"
set -g @color5 "#9f00ff"
set -g @color6 "#2ee7b6"
set -g @color7 "#ffffff"
set -g @color8 "#666666"
set -g @color9 "#ff8484"
set -g @color10 "#c5f467"
set -g @color11 "#ffcc5c"
set -g @color12 "#5cb2ff"
set -g @color13 "#c16cfa"
set -g @color14 "#5cecc6"
set -g @color15 "#ffffff"
set -g @theme_bg "#1a2332"
set -g @theme_black "#000000"
set -g @theme_fg "#a4b1cd"
set -g @theme_accent "#004cff"
set -g @theme_gray "#666666"
set -g @theme_red "#ff3e3e"
set -g @theme_green "#9fef00"
set -g @theme_yellow "#ffaf00"

set -g status-style "bg=#1a2332,fg=#a4b1cd"
set -g window-status-current-style "bg=#004cff,fg=#1a2332,bold"
set -g window-status-style "bg=#1a2332,fg=#a4b1cd"
set -g pane-active-border-style "fg=#004cff"
set -g pane-border-style "fg=#666666"
set -g message-style "bg=#666666,fg=#a4b1cd"
set -g message-command-style "bg=#666666,fg=#a4b1cd"
set -g mode-style "bg=#004cff,fg=#1a2332"
