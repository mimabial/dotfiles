$HOME/.config/tmux/theme.conf

set -g @color0 "#1f2523"
set -g @color1 "#ff9933"
set -g @color2 "#b3d966"
set -g @color3 "#ff9933"
set -g @color4 "#7daea3"
set -g @color5 "#ff708c"
set -g @color6 "#73ccb8"
set -g @color7 "#fffcd8"
set -g @color8 "#444d4a"
set -g @color9 "#ffad4d"
set -g @color10 "#cce680"
set -g @color11 "#ffad4d"
set -g @color12 "#7daea3"
set -g @color13 "#ff8ca3"
set -g @color14 "#8ce6cc"
set -g @color15 "#ffffff"
set -g @theme_bg "#0e0600"
set -g @theme_black "#1f2523"
set -g @theme_fg "#fffcd8"
set -g @theme_accent "#fabd2f"
set -g @theme_gray "#444d4a"
set -g @theme_red "#ff9933"
set -g @theme_green "#b3d966"
set -g @theme_yellow "#ff9933"

set -g status-style "bg=default,fg=#fffcd8"
set -g message-style "bg=#0e0600,fg=#fabd2f"
set -g message-command-style "bg=#0e0600,fg=#fabd2f"
set -g pane-border-style "fg=#444d4a"
set -g pane-active-border-style "fg=#d79921"
set -g window-status-style "fg=#a89984"
set -g window-status-current-style "bg=#1d2021,fg=#d4be98,bold"
set -g mode-style "bg=#d4be98,fg=#1d2021"
set -g clock-mode-colour "#fabd2f"
