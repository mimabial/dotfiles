$HOME/.config/hypr/themes/theme.meta|> $HOME/.config/hypr/themes/colors.meta

$ICON_THEME = Tela-circle-yellow
$COLOR_SCHEME = prefer-dark
$NVIM_SCHEME = hypr
$NVIM_BACKGROUND = dark
$NVIM_TRANSPARENCY = false
$CURSOR_THEME = BattleCursor
$CURSOR_SIZE = 24
$FONT = CommitMono Nerd Font
$BAR_FONT = CommitMono Nerd Font
$MENU_FONT = CommitMono Nerd Font
$MONOSPACE_FONT = CommitMono Nerd Font
$TERMINAL_FONT = CommitMono Nerd Font
$NOTIFICATION_FONT = CommitMono Nerd Font Mono

general {
    gaps_in = 3
    gaps_out = 8
    border_size = 2
    col.active_border = rgba(d79921ff)
    col.inactive_border = rgba(665c54cc) rgba(3c3836cc) 45deg
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(d79921ff)
    col.border_inactive = rgba(665c54cc) rgba(3c3836cc) 45deg
    col.border_locked_active = rgba(d79921ff)
    col.border_locked_inactive = rgba(665c54cc) rgba(3c3836cc) 45deg
}

decoration {
    rounding = 3

    blur {
        enabled = yes
        size = 6
        passes = 3
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }

    shadow {
        enabled = false
    }
}
