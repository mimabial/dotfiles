$HOME/.config/tmux/theme.conf

set -g @color0 "#d0d0c8"
set -g @color1 "#db0030"
set -g @color2 "#2e3125"
set -g @color3 "#51573b"
set -g @color4 "#DE6A41"
set -g @color5 "#43432b"
set -g @color6 "#6b1f2f"
set -g @color7 "#383835"
set -g @color8 "#6b7360"
set -g @color9 "#db0030"
set -g @color10 "#2e3125"
set -g @color11 "#51573b"
set -g @color12 "#DE6A41"
set -g @color13 "#43432b"
set -g @color14 "#6b1f2f"
set -g @color15 "#242424"
set -g @theme_bg "#d0d0c8"
set -g @theme_black "#d0d0c8"
set -g @theme_fg "#242424"
set -g @theme_accent "#DE6A41"
set -g @theme_gray "#6b7360"
set -g @theme_red "#db0030"
set -g @theme_green "#2e3125"
set -g @theme_yellow "#51573b"

set -g status-style "bg=default,fg=#242424"
set -g message-style "bg=#d0d0c8,fg=#DE6A41"
set -g message-command-style "bg=#d0d0c8,fg=#DE6A41"
set -g pane-border-style "fg=#6b7360"
set -g pane-active-border-style "fg=#DE6A41"
set -g window-status-style "fg=#6b7360"
set -g window-status-current-style "fg=#DE6A41,bold"
set -g mode-style "bg=#DE6A41,fg=#d0d0c8"
set -g clock-mode-colour "#DE6A41"
