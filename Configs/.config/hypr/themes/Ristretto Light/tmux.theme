$HOME/.config/tmux/theme.conf

set -g @color0 "#7a6550"
set -g @color1 "#df2b0d"
set -g @color2 "#29472a"
set -g @color3 "#8a6c3e"
set -g @color4 "#5e8e28"
set -g @color5 "#28473f"
set -g @color6 "#3d6b52"
set -g @color7 "#24201d"
set -g @color8 "#a09080"
set -g @color9 "#e03c20"
set -g @color10 "#1b2e1c"
set -g @color11 "#6b5237"
set -g @color12 "#496c1e"
set -g @color13 "#28463c"
set -g @color14 "#4a6b4d"
set -g @color15 "#22211d"
set -g @theme_bg "#fdf6ee"
set -g @theme_black "#7a6550"
set -g @theme_fg "#22211d"
set -g @theme_accent "#5e8e28"
set -g @theme_gray "#a09080"
set -g @theme_red "#df2b0d"
set -g @theme_green "#29472a"
set -g @theme_yellow "#8a6c3e"

set -g status-style "bg=#fdf6ee,fg=#22211d"
set -g window-status-current-style "bg=#5e8e28,fg=#fdf6ee,bold"
set -g window-status-style "bg=#fdf6ee,fg=#22211d"
set -g pane-active-border-style "fg=#5e8e28"
set -g pane-border-style "fg=#a09080"
set -g message-style "bg=#a09080,fg=#22211d"
set -g message-command-style "bg=#a09080,fg=#22211d"
set -g mode-style "bg=#5e8e28,fg=#fdf6ee"
