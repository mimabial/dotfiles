$HOME/.config/dunst/theme.conf

@define-color fg-primary #22211d;
@define-color fg-secondary #22211d;
@define-color bg-primary #fdf6ee;
@define-color bg-secondary #fdf6ee;
@define-color bg-tertiary #fdf6ee;
@define-color accent-red #df2b0d;
@define-color accent-green #29472a;
@define-color accent-yellow #8a6c3e;
@define-color accent-blue #5e8e28;
@define-color accent-purple #28473f;
@define-color accent-aqua #3d6b52;
@define-color accent-orange #6b5237;
@define-color border-primary #5e8e28;
@define-color border-secondary #a09080;
@define-color gray #a09080;
