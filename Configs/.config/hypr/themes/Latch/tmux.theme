$HOME/.config/tmux/theme.conf

set -g @color0 "#EAEAEA"
set -g @color1 "#4a514d"
set -g @color2 "#58615d"
set -g @color3 "#67726c"
set -g @color4 "#59635e"
set -g @color5 "#555e59"
set -g @color6 "#505854"
set -g @color7 "#333534"
set -g @color8 "#3f4241"
set -g @color9 "#313734"
set -g @color10 "#404643"
set -g @color11 "#4f5753"
set -g @color12 "#85938c"
set -g @color13 "#818e87"
set -g @color14 "#7b8882"
set -g @color15 "#262827"

set -g @theme_bg "#EAEAEA"
set -g @theme_black "#D6DAD8"
set -g @theme_fg "#262827"
set -g @theme_accent "#59635e"
set -g @theme_gray "#6F7572"
set -g @theme_red "#4a514d"
set -g @theme_green "#58615d"
set -g @theme_yellow "#67726c"

set -g status-style "bg=default,fg=#262827"
set -g message-style "bg=#EAEAEA,fg=#59635e"
set -g message-command-style "bg=#EAEAEA,fg=#59635e"
set -g pane-border-style "fg=#B3B4B4"
set -g pane-active-border-style "fg=#2B2C2B"
set -g window-status-style "fg=#6F7572"
set -g window-status-current-style "fg=#262827,bold"
set -g mode-style "bg=#D6DAD8,fg=#262827"
set -g clock-mode-colour "#59635e"
