$HOME/.config/tmux/theme.conf

# Generated by render/tmux
set -g status-style "bg=#0b0d11,fg=#f0b7ca"
set -g window-status-current-style "bg=#67dd82,fg=#0b0d11,bold"
set -g window-status-style "bg=#0b0d11,fg=#f0b7ca"
set -g pane-active-border-style "fg=#67dd82"
set -g pane-border-style "fg=#678270"
set -g message-style "bg=#678270,fg=#f0b7ca"
set -g message-command-style "bg=#678270,fg=#f0b7ca"
set -g mode-style "bg=#67dd82,fg=#0b0d11"
