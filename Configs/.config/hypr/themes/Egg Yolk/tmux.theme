$HOME/.config/tmux/theme.conf

set -g @color0 "#292025"
set -g @color1 "#cf7358"
set -g @color2 "#9fad68"
set -g @color3 "#c8964b"
set -g @color4 "#c87d2a"
set -g @color5 "#c98c97"
set -g @color6 "#9eb8b2"
set -g @color7 "#fff4d8"
set -g @color8 "#a58c82"
set -g @color9 "#e58a70"
set -g @color10 "#b9c97f"
set -g @color11 "#e4c56d"
set -g @color12 "#df9850"
set -g @color13 "#ddb0b8"
set -g @color14 "#c2d5d0"
set -g @color15 "#fffaf0"
set -g @theme_bg "#292025"
set -g @theme_black "#292025"
set -g @theme_fg "#fff4d8"
set -g @theme_accent "#c87d2a"
set -g @theme_gray "#a58c82"
set -g @theme_red "#cf7358"
set -g @theme_green "#9fad68"
set -g @theme_yellow "#c8964b"

set -g status-style "bg=#292025,fg=#fff4d8"
set -g window-status-current-style "bg=#c87d2a,fg=#292025,bold"
set -g window-status-style "bg=#292025,fg=#fff4d8"
set -g pane-active-border-style "fg=#c87d2a"
set -g pane-border-style "fg=#a58c82"
set -g message-style "bg=#a58c82,fg=#fff4d8"
set -g message-command-style "bg=#a58c82,fg=#fff4d8"
set -g mode-style "bg=#c87d2a,fg=#292025"
