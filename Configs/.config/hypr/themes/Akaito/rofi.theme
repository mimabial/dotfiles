$HOME/.config/rofi/theme.rasi

* {
    background:          #f3e4cb;
    background-alpha:    #9f825359;
    foreground:          #4d2e1a;
    border:              #e84d31;
    accent:              #e48e3e;
    selected-background: #a32f1a;
    selected-foreground: #f3e4cb;
    separator:           #9f8253;
    urgent:              #a4373c;
    active:              #a46d2d;
}
