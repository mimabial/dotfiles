$HOME/.config/tmux/theme.conf

set -g @color0 "#DEDBC8"
set -g @color1 "#4B0304"
set -g @color2 "#725c0a"
set -g @color3 "#2E311A"
set -g @color4 "#005C32"
set -g @color5 "#762b2f"
set -g @color6 "#3B3B3B"
set -g @color7 "#665e4a"
set -g @color8 "#9a9078"
set -g @color9 "#4B0304"
set -g @color10 "#725c0a"
set -g @color11 "#005C32"
set -g @color12 "#2E311A"
set -g @color13 "#762b2f"
set -g @color14 "#3B3B3B"
set -g @color15 "#0c0c14"
set -g @theme_bg "#DEDBC8"
set -g @theme_black "#DEDBC8"
set -g @theme_fg "#0c0c14"
set -g @theme_accent "#005C32"
set -g @theme_gray "#9a9078"
set -g @theme_red "#4B0304"
set -g @theme_green "#725c0a"
set -g @theme_yellow "#2E311A"

set -g status-style "bg=default,fg=#0c0c14"
set -g message-style "bg=#DEDBC8,fg=#005C32"
set -g message-command-style "bg=#DEDBC8,fg=#005C32"
set -g pane-border-style "fg=#9a9078"
set -g pane-active-border-style "fg=#005C32"
set -g window-status-style "fg=#9a9078"
set -g window-status-current-style "fg=#005C32,bold"
set -g mode-style "bg=#005C32,fg=#DEDBC8"
set -g clock-mode-colour "#005C32"
