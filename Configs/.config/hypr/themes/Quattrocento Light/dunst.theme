@define-color accent-blue #3f5378;
@define-color accent-purple #8c3a58;
@define-color accent-aqua #3a6367;
@define-color accent-orange #95521a;
@define-color border-primary #8a4a2c;
@define-color border-secondary #8a7a5e;
