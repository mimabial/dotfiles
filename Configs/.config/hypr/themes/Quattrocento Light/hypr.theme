$HOME/.config/hypr/themes/theme.meta|> $HOME/.config/hypr/themes/colors.meta

$ICON_THEME = Tela-red
$COLOR_SCHEME = prefer-light
$NVIM_SCHEME = hypr
$NVIM_BACKGROUND = light
$NVIM_TRANSPARENCY = false
$CURSOR_THEME = Colloid-cursors
$CURSOR_SIZE = 30
$FONT = CommitMono Nerd Font
$BAR_FONT = CommitMono Nerd Font
$MENU_FONT = CommitMono Nerd Font
$MONOSPACE_FONT = CommitMono Nerd Font
$TERMINAL_FONT = CommitMono Nerd Font
$NOTIFICATION_FONT = CommitMono Nerd Font Mono

general {
    gaps_in = 4
    gaps_out = 8
    border_size = 2
    col.active_border = rgba(8a4a2cee) rgba(33291bee) 45deg
    col.inactive_border = rgba(d8c9adaa)
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(8a4a2cee) rgba(33291bee) 45deg
    col.border_inactive = rgba(d8c9adaa)
    col.border_locked_active = rgba(8a4a2cee) rgba(33291bee) 45deg
    col.border_locked_inactive = rgba(d8c9adaa)
}

decoration {
    rounding = 4
    rounding_power = 4
    active_opacity = 0.90
    inactive_opacity = 0.85
    blur {
        enabled = true
        size = 6
        passes = 2
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
    shadow {
        enabled = true
        range = 20
        render_power = 4
        color = rgba(f0e6d399)
        color_inactive = rgba(f0e6d366)
    }
}
