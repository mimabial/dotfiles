$HOME/.config/tmux/theme.conf

set -g @color0 "#f0e6d3"
set -g @color1 "#a32d2a"
set -g @color2 "#3f6b4a"
set -g @color3 "#7d5a10"
set -g @color4 "#3f5378"
set -g @color5 "#8c3a58"
set -g @color6 "#3a6367"
set -g @color7 "#33291b"
set -g @color8 "#8a7a5e"
set -g @color9 "#8e2622"
set -g @color10 "#355c3f"
set -g @color11 "#6d4e0c"
set -g @color12 "#354764"
set -g @color13 "#752f49"
set -g @color14 "#2f5457"
set -g @color15 "#1c150c"
set -g @theme_bg "#f0e6d3"
set -g @theme_black "#f0e6d3"
set -g @theme_fg "#33291b"
set -g @theme_accent "#8a4a2c"
set -g @theme_gray "#8a7a5e"
set -g @theme_red "#a32d2a"
set -g @theme_green "#3f6b4a"
set -g @theme_yellow "#7d5a10"

set -g status-style "bg=default,fg=#33291b"
set -g message-style "bg=#f0e6d3,fg=#8a4a2c"
set -g message-command-style "bg=#f0e6d3,fg=#8a4a2c"
set -g pane-border-style "fg=#8a7a5e"
set -g pane-active-border-style "fg=#8a4a2c"
set -g window-status-style "fg=#8a7a5e"
set -g window-status-current-style "fg=#8a4a2c,bold"
set -g mode-style "bg=#8a4a2c,fg=#f0e6d3"
set -g clock-mode-colour "#8a4a2c"
