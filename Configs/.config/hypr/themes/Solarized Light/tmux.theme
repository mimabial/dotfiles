$HOME/.config/tmux/theme.conf

# Generated by render/tmux
set -g status-style "bg=#fdf6e3,fg=#586e75"
set -g window-status-current-style "bg=#268bd2,fg=#fdf6e3,bold"
set -g window-status-style "bg=#fdf6e3,fg=#586e75"
set -g pane-active-border-style "fg=#268bd2"
set -g pane-border-style "fg=#002b36"
set -g message-style "bg=#002b36,fg=#586e75"
set -g message-command-style "bg=#002b36,fg=#586e75"
set -g mode-style "bg=#268bd2,fg=#fdf6e3"
