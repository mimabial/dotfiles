$HOME/.config/tmux/theme.conf

set -g @color0 "#100F0F"
set -g @color1 "#AF3029"
set -g @color2 "#66800B"
set -g @color3 "#AD8301"
set -g @color4 "#205EA6"
set -g @color5 "#A02F6F"
set -g @color6 "#24837B"
set -g @color7 "#6F6E69"
set -g @color8 "#6F6E69"
set -g @color9 "#D14D41"
set -g @color10 "#879A39"
set -g @color11 "#D0A215"
set -g @color12 "#4385BE"
set -g @color13 "#CE5D97"
set -g @color14 "#3AA99F"
set -g @color15 "#100F0F"

set -g @theme_bg "#FFFCF0"
set -g @theme_black "#100F0F"
set -g @theme_fg "#100F0F"
set -g @theme_accent "#205EA6"
set -g @theme_gray "#6F6E69"
set -g @theme_red "#AF3029"
set -g @theme_green "#66800B"
set -g @theme_yellow "#AD8301"

set -g status-style "bg=default,fg=#100F0F"
set -g message-style "bg=#FFFCF0,fg=#205EA6"
set -g message-command-style "bg=#FFFCF0,fg=#205EA6"
set -g pane-border-style "fg=#6F6E69"
set -g pane-active-border-style "fg=#205EA6"
set -g window-status-style "fg=#6F6E69"
set -g window-status-current-style "fg=#205EA6,bold"
set -g mode-style "bg=#205EA6,fg=#FFFCF0"
set -g clock-mode-colour "#205EA6"
