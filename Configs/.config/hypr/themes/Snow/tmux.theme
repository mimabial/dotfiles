$HOME/.config/tmux/theme.conf

set -g @color0 "#ffffff"
set -g @color1 "#0a0a0a"
set -g @color2 "#0a0a0a"
set -g @color3 "#0a0a0a"
set -g @color4 "#0a0a0a"
set -g @color5 "#0a0a0a"
set -g @color6 "#0a0a0a"
set -g @color7 "#0a0a0a"
set -g @color8 "#919191"
set -g @color9 "#0a0a0a"
set -g @color10 "#0a0a0a"
set -g @color11 "#0a0a0a"
set -g @color12 "#0a0a0a"
set -g @color13 "#0a0a0a"
set -g @color14 "#0a0a0a"
set -g @color15 "#000000"
set -g @theme_bg "#ffffff"
set -g @theme_black "#ffffff"
set -g @theme_fg "#0a0a0a"
set -g @theme_accent "#0a0a0a"
set -g @theme_gray "#919191"
set -g @theme_red "#0a0a0a"
set -g @theme_green "#0a0a0a"
set -g @theme_yellow "#0a0a0a"

set -g status-style "bg=#ffffff,fg=#0a0a0a"
set -g window-status-current-style "bg=#0a0a0a,fg=#ffffff,bold"
set -g window-status-style "bg=#ffffff,fg=#0a0a0a"
set -g pane-active-border-style "fg=#0a0a0a"
set -g pane-border-style "fg=#919191"
set -g message-style "bg=#919191,fg=#0a0a0a"
set -g message-command-style "bg=#919191,fg=#0a0a0a"
set -g mode-style "bg=#0a0a0a,fg=#ffffff"
