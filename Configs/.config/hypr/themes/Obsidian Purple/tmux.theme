$HOME/.config/tmux/theme.conf

# Generated by render/tmux
set -g status-style "bg=#1A1626,fg=#F8F8F2"
set -g window-status-current-style "bg=#92AAFF,fg=#1A1626,bold"
set -g window-status-style "bg=#1A1626,fg=#F8F8F2"
set -g pane-active-border-style "fg=#92AAFF"
set -g pane-border-style "fg=#6272A4"
set -g message-style "bg=#6272A4,fg=#F8F8F2"
set -g message-command-style "bg=#6272A4,fg=#F8F8F2"
set -g mode-style "bg=#92AAFF,fg=#1A1626"
