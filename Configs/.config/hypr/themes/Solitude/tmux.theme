$HOME/.config/tmux/theme.conf

# Generated by render/tmux
set -g status-style "bg=#101315,fg=#cacccc"
set -g window-status-current-style "bg=#798186,fg=#101315,bold"
set -g window-status-style "bg=#101315,fg=#cacccc"
set -g pane-active-border-style "fg=#798186"
set -g pane-border-style "fg=#4b4e55"
set -g message-style "bg=#4b4e55,fg=#cacccc"
set -g message-command-style "bg=#4b4e55,fg=#cacccc"
set -g mode-style "bg=#798186,fg=#101315"
