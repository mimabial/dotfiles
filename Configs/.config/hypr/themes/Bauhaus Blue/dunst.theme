$HOME/.config/dunst/theme.conf

/* Foreground colors */
@define-color fg-primary #778899;     /* base00 - primary content */
@define-color fg-secondary #268bd2;   /* base1 - secondary content */

/* Background colors */
@define-color bg-primary #fdf6e3;     /* base3 - primary background */
@define-color bg-secondary #eee8d5;   /* base2 - secondary background */
@define-color bg-tertiary #e6dfd0;    /* slightly darker than base2 */

/* Accent colors - Solarized palette */
@define-color accent-red #D0021B;     /* red */
@define-color accent-green #00A651;   /* green */
@define-color accent-yellow #FFC425;  /* yellow */
@define-color accent-blue #005CAB;    /* blue */
@define-color accent-purple #9B26AF;  /* violet */
@define-color accent-aqua #00A6A6;    /* cyan */
@define-color accent-orange #E85D00;  /* orange */

/* Border colors */
@define-color border-primary #003DA5;    /* base1 */
@define-color border-secondary #4A4A4A;  /* base0 */

/* Gray */
@define-color gray #93a1a1;           /* base1 */
