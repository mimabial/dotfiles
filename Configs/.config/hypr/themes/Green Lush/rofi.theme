$HOME/.config/rofi/theme.rasi
* {
    background:            #28432FB3;
    background-alpha:      #0c102180;
    foreground:            #AAF0F0E6;
    border:                #11b811E6;
    accent:                #AAF0F080;
    selected-background:   #AAF0AA80;
    selected-foreground:   #AAF0F0E6;
    separator:             #808080FF;
    urgent:                #153550E6;
    active:                #578F8FE6;
}
