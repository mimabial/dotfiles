$HOME/.config/tmux/theme.conf

# Generated by render/tmux
set -g status-style "bg=#e0d6c8,fg=#0f2838"
set -g window-status-current-style "bg=#2d6870,fg=#e0d6c8,bold"
set -g window-status-style "bg=#e0d6c8,fg=#0f2838"
set -g pane-active-border-style "fg=#2d6870"
set -g pane-border-style "fg=#4a5a65"
set -g message-style "bg=#4a5a65,fg=#0f2838"
set -g message-command-style "bg=#4a5a65,fg=#0f2838"
set -g mode-style "bg=#2d6870,fg=#e0d6c8"
