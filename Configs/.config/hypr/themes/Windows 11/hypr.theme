$HOME/.config/hypr/themes/theme.meta|> $HOME/.config/hypr/themes/colors.meta

$ICON_THEME = Coffee
$COLOR_SCHEME = prefer-dark
$NVIM_SCHEME = tokyonight
$NVIM_VARIANT = night
$NVIM_BACKGROUND = dark
$NVIM_TRANSPARENCY = false

$CURSOR_THEME = Cursor-Windows
$CURSOR_SIZE = 30

general {
    gaps_in = 4
    gaps_out = 10
    border_size = 2
    col.active_border = rgba(494949dd)
    col.inactive_border = rgba(494949aa)
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(2770C0FF)
    col.border_inactive = rgba(A44185CC)
    col.border_locked_active = rgba(2770C0FF)
    col.border_locked_inactive = rgba(A44185CC)
}

decoration {
    rounding = 3
    active_opacity = 0.95
    inactive_opacity = 0.85

    blur {
        enabled = yes
        size = 5
        passes = 4
        new_optimizations = on
        ignore_opacity = false
        xray = false
    }

    shadow {
        enabled = true
        range = 9
        render_power = 3
    }

    dim_inactive = false
    dim_strength = 0.1
    dim_special = 0
}
