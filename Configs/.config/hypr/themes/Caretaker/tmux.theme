$HOME/.config/tmux/theme.conf

set -g @color0 "#8B9B8E"
set -g @color1 "#D9D7C3"
set -g @color2 "#D9D7C3"
set -g @color3 "#B8B584"
set -g @color4 "#8B9B8E"
set -g @color5 "#8B9B8E"
set -g @color6 "#EAD6DA"
set -g @color7 "#D9D7C3"
set -g @color8 "#909768"
set -g @color9 "#EAD6DA"
set -g @color10 "#EAD6DA"
set -g @color11 "#9B9A62"
set -g @color12 "#8B9B8E"
set -g @color13 "#8B9B8E"
set -g @color14 "#EAD6DA"
set -g @color15 "#EAD6DA"
set -g @theme_bg "#3d4745"
set -g @theme_black "#8B9B8E"
set -g @theme_fg "#EAD6DA"
set -g @theme_accent "#EAD6DA"
set -g @theme_gray "#909768"
set -g @theme_red "#D9D7C3"
set -g @theme_green "#D9D7C3"
set -g @theme_yellow "#B8B584"

set -g status-style "bg=default,fg=#EAD6DA"
set -g message-style "bg=#3d4745,fg=#EAD6DA"
set -g message-command-style "bg=#3d4745,fg=#EAD6DA"
set -g pane-border-style "fg=#35403a"
set -g pane-active-border-style "fg=#6f8579"
set -g window-status-style "fg=#2B2D1F"
set -g window-status-current-style "bg=#2B2D1F,fg=#3d4745,bold"
set -g mode-style "bg=#8B9B8E,fg=#3d4745"
set -g clock-mode-colour "#EAD6DA"
