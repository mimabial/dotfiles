$HOME/.config/hypr/themes/theme.meta|> $HOME/.config/hypr/themes/colors.meta

$ICON_THEME = Gruvbox-Plus-Dark
$COLOR_SCHEME = prefer-dark
$NVIM_SCHEME = hypr
$NVIM_BACKGROUND = dark
$NVIM_TRANSPARENCY = false
$CURSOR_THEME = Gruvbox-Retro
$CURSOR_SIZE = 20
$FONT = CommitMono Nerd Font
$BAR_FONT = CommitMono Nerd Font
$MENU_FONT = CommitMono Nerd Font
$MONOSPACE_FONT = CommitMono Nerd Font
$TERMINAL_FONT = CommitMono Nerd Font
$NOTIFICATION_FONT = CommitMono Nerd Font Mono

general {
    gaps_in = 3
    gaps_out = 8
    border_size = 2
    col.active_border = rgba(D9D7C3ff) rgba(909768ff) 90deg
    col.inactive_border = rgba(8B9B8Eff) rgba(6f8579ff) 90deg
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(90ceaaff) rgba(ecd3a0ff) 45deg
    col.border_inactive = rgba(86aaeccc) rgba(93cee9cc) 45deg
    col.border_locked_active = rgba(90ceaaff) rgba(ecd3a0ff) 45deg
    col.border_locked_inactive = rgba(86aaeccc) rgba(93cee9cc) 45deg
}

decoration {
    rounding = 5
    shadow:enabled = false

    active_opacity = 0.95
    inactive_opacity = 0.90

    blur {
        enabled = yes
        size = 5
        passes = 2
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
}
