$HOME/.config/tmux/theme.conf

# Generated by render/tmux
set -g status-style "bg=#faf9f5,fg=#4d2e1a"
set -g window-status-current-style "bg=#a32f1a,fg=#dfd2c4,bold"
set -g window-status-style "bg=#e6e5e1,fg=#4d2e1a"
set -g pane-active-border-style "fg=#a32f1a"
set -g pane-border-style "fg=#9f8253"
set -g message-style "bg=#9f8253,fg=#4d2e1a"
set -g message-command-style "bg=#9f8253,fg=#4d2e1a"
set -g mode-style "bg=#a32f1a,fg=#dfd2c4"
