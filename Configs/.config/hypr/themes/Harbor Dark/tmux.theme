$HOME/.config/tmux/theme.conf

set -g @color0 "#1B1B1B"
set -g @color1 "#F44336"
set -g @color2 "#e75a50"
set -g @color3 "#a99b7a"
set -g @color4 "#e58980"
set -g @color5 "#77838a"
set -g @color6 "#6d6d6d"
set -g @color7 "#E1CE98"
set -g @color8 "#817f68"
set -g @color9 "#e75a50"
set -g @color10 "#77838a"
set -g @color11 "#a99b7a"
set -g @color12 "#e58980"
set -g @color13 "#9ba2a6"
set -g @color14 "#888888"
set -g @color15 "#efebdc"

set -g @theme_bg "#1B1B1B"
set -g @theme_black "#323232"
set -g @theme_fg "#EFEBDC"
set -g @theme_accent "#E75A50"
set -g @theme_gray "#817F68"
set -g @theme_red "#F44336"
set -g @theme_green "#A99B7A"
set -g @theme_yellow "#E1CE98"

set -g status-style "bg=default,fg=#EFEBDC"
set -g message-style "bg=#1B1B1B,fg=#E75A50"
set -g message-command-style "bg=#1B1B1B,fg=#E75A50"
set -g pane-border-style "fg=#817F68"
set -g pane-active-border-style "fg=#A99B7A"
set -g window-status-style "fg=#929292"
set -g window-status-current-style "fg=#E75A50,bold"
set -g mode-style "bg=#E75A50,fg=#1B1B1B"
set -g clock-mode-colour "#E1CE98"
