[Unit]
Description=Auto Theme Daemon (sunrise/sunset)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/state/hypr/pip_env/bin/python %h/.local/lib/hypr/theme/auto_theme.py
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=%C/hypr/pycache

[Install]
WantedBy=graphical-session.target
