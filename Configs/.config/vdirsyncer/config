# Read-only .ics feeds pulled into vdirs that khal reads as calendars.
#
# A feed lives outside ~/.calendars/* on purpose: khal's `[[local]]` block
# discovers everything under that glob, so a feed placed there would be
# registered twice — once readonly from its own block, once writable from
# discovery — and every event would appear in the agenda twice.

[general]
status_path = "~/.local/state/vdirsyncer/status/"

[pair holidays]
a = "holidays_local"
b = "holidays_remote"
collections = null
conflict_resolution = "b wins"
# the remote cannot be written to, so a local delete is put back rather than
# reported as a sync error
partial_sync = "revert"

[storage holidays_local]
type = "filesystem"
path = "~/.local/share/khal/calendars/holidays/"
fileext = ".ics"

[storage holidays_remote]
type = "http"
url = "https://calendar.google.com/calendar/ical/fr.french%23holiday%40group.v.calendar.google.com/public/basic.ics"

# The two-way hub. Unlike the read-only feed above, this pair's local side
# belongs inside ~/.calendars/* precisely so khal discovers it — it is the
# calendar the agenda already reads, not a second copy of it.
#
# item_types is deliberately unset: the default carries every component, and
# the personal collection holds khal's VEVENTs and todoman's VTODOs together.
# Restricting it to VEVENT would drop the todos without reporting an error.
#
# conflict_resolution is deliberately unset too, so a genuine two-sided edit
# raises and leaves both copies intact rather than silently discarding one.
[pair personal]
a = "personal_local"
b = "personal_remote"
collections = ["from a", "from b"]

[storage personal_local]
type = "filesystem"
path = "~/.calendars/"
fileext = ".ics"

[storage personal_remote]
type = "caldav"
url = "http://localhost:5232/"
username = "rifle"
password.fetch = ["command", "cat", "~/.local/state/vdirsyncer/caldav.pw"]
