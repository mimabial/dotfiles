#!/usr/bin/env bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
config_path="${RMPC_CONFIG_PATH:-${config_home}/rmpc/config.ron}"
prepare_configs="${config_home}/rmpc/lib/prepare_configs.py"
target_theme="${1:-}"
target_theme_path="${2:-${config_home}/rmpc/themes/${target_theme}.ron}"
snapshot_path="${cache_home}/rmpc/configs/${target_theme}.ron"

if [[ "${target_theme}" == "--prepare" ]]; then
  exec python3 "${prepare_configs}"
fi

[[ -n "${target_theme}" ]] || exit 2
[[ -f "${config_path}" ]] || exit 1
[[ -f "${target_theme_path}" ]] || exit 1

if [[ "${RMPC_PREPARE_FORCE:-0}" == "1" ||
  ! -f "${snapshot_path}" ||
  "${target_theme_path}" -nt "${snapshot_path}" ]]; then
  python3 "${prepare_configs}"
fi

if [[ "${RMPC_APPLY_FORCE:-0}" != "1" ]]; then
  current_theme=""
  while IFS= read -r line; do
    if [[ "${line}" == *'theme: Some("'* ]]; then
      current_theme="${line#*'theme: Some("'}"
      current_theme="${current_theme%%'"'*}"
      break
    fi
  done <"${config_path}"
  [[ "${current_theme}" != "${target_theme}" ]] || exit 0
fi

cp "${snapshot_path}" "${config_path}"
