#!/usr/bin/env bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
rmpc_lib="${config_home}/rmpc/lib"
themes_dir="${config_home}/rmpc/themes"
rmpc_bin="/usr/bin/rmpc"
resize_src="${rmpc_lib}/onresize.c"
resize_bin="${XDG_DATA_HOME:-$HOME/.local/share}/rmpc/bin/rmpc-onresize"

# shellcheck source=/dev/null
source "${rmpc_lib}/theme-size.bash"

if [[ ! -x "$resize_bin" || "$resize_src" -nt "$resize_bin" ]] &&
  compiler="$(command -v "${CC:-cc}")"; then
  mkdir -p "${resize_bin%/*}"
  resize_tmp="$(mktemp "${resize_bin}.XXXXXX")"
  trap 'rm -f "$resize_tmp"' EXIT
  if "$compiler" -O2 -s "$resize_src" -o "$resize_tmp"; then
    mv -f "$resize_tmp" "$resize_bin"
  fi
  rm -f "$resize_tmp"
  trap - EXIT
fi

theme_name="pywal16-big"
if [[ "${HYPR_SUMMON_EXPECTED_FLOAT:-}" != "false" ]]; then
  terminal_size="$(rmpc_terminal_size || true)"
  if [[ -n "${terminal_size}" ]]; then
    read -r rows columns <<<"${terminal_size}"
    sized_theme="$(rmpc_theme_for_size "${columns}" "${rows}" || true)"
    if [[ -n "${sized_theme}" ]]; then
      theme_name="${sized_theme}"
    fi
  fi
fi
theme_path="${themes_dir}/${theme_name}.ron"
"${rmpc_lib}/apply_theme" "${theme_name}" "${theme_path}"
exec "${rmpc_bin}" --theme "${theme_path}" "$@"
