#!/usr/bin/env sh

MEDIA_LIB="$HOME/.local/lib/hypr/media"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
DEBUG_DIR="$STATE_HOME/hypr/lyrics"
DEBUG_LOG="$DEBUG_DIR/fetch.log"
ORIGINAL_LRC_FILE="${LRC_FILE:-}"

if [ -r "$MEDIA_LIB/lyrics_paths.lib.sh" ]; then
  # shellcheck source=/dev/null
  . "$MEDIA_LIB/lyrics_paths.lib.sh"
  [ -n "$ORIGINAL_LRC_FILE" ] && LRC_FILE="$(lyrics_lrc_path "$ORIGINAL_LRC_FILE")"
fi

notify() {
  rmpc remote --pid "${PID:-}" status "$1" --level "$2" >/dev/null 2>&1 || true
}

if [ -z "${LRC_FILE:-}" ]; then
  notify "Lyrics path not provided" error
  exit 0
fi
if [ -s "$LRC_FILE" ]; then
  rmpc remote --pid "${PID:-}" indexlrc --path "$LRC_FILE" >/dev/null 2>&1 || true
  exit 0
fi

case "${FILE:-}" in
  /*) AUDIO_FILE="$FILE" ;;
  ?*) AUDIO_FILE="${MUSIC_LIBRARY_ROOT:-$HOME/Music}/$FILE" ;;
  *)
    AUDIO_FILE=""
    base_path="${ORIGINAL_LRC_FILE%.*}"
    for extension in flac mp3 m4a ogg opus wav aac; do
      [ -f "$base_path.$extension" ] || continue
      AUDIO_FILE="$base_path.$extension"
      break
    done
    ;;
esac

if [ ! -f "$AUDIO_FILE" ]; then
  notify "Audio file not found for lyrics lookup" error
  exit 0
fi
if [ ! -r "$MEDIA_LIB/lyrics_runtime.sh" ] || [ ! -f "$MEDIA_LIB/fetch_track_lyrics.py" ]; then
  notify "Lyrics fetcher is not installed" error
  exit 0
fi

# shellcheck source=/dev/null
. "$MEDIA_LIB/lyrics_runtime.sh"
PYTHON_EXEC="$(resolve_lyrics_python 2>/dev/null || true)"
if [ -z "$PYTHON_EXEC" ]; then
  notify "No Python interpreter available for lyrics fetch" error
  exit 0
fi

timeout_seconds="${LYRICS_MAX_TOTAL_SEC:-20}"
case "$timeout_seconds" in '' | *[!0-9]* | 0) timeout_seconds=20 ;; esac
tmp_log="$(mktemp "${TMPDIR:-/tmp}/fetch_lyrics.XXXXXX" 2>/dev/null || true)"
[ -n "$tmp_log" ] && trap 'rm -f "$tmp_log"' EXIT HUP INT TERM

set -- "$PYTHON_EXEC" "$MEDIA_LIB/fetch_track_lyrics.py" \
  --audio-file "$AUDIO_FILE" \
  --scan-root "${MUSIC_LIBRARY_ROOT:-$HOME/Music}" \
  --lrc-file "$LRC_FILE"
rc=0
if command -v timeout >/dev/null 2>&1; then
  timeout "$timeout_seconds" "$@" >"${tmp_log:-/dev/null}" 2>&1 || rc=$?
else
  "$@" >"${tmp_log:-/dev/null}" 2>&1 || rc=$?
fi

if [ "$rc" -eq 0 ] && [ -s "$LRC_FILE" ]; then
  rmpc remote --pid "${PID:-}" indexlrc --path "$LRC_FILE" >/dev/null 2>&1 || true
  lyrics_kind="$(sed -n 's/^LYRICS_RESULT=//p' "${tmp_log:-/dev/null}" | tail -n 1)"
  notify "Downloaded ${lyrics_kind:-lyrics} for ${ARTIST:-Unknown Artist} - ${TITLE:-Unknown Title}" info
  exit 0
fi

if [ "$rc" -eq 124 ] || [ "$rc" -ge 2 ]; then
  mkdir -p "$DEBUG_DIR" 2>/dev/null || true
  {
    printf '[%s] rc=%s file=%s artist=%s title=%s\n' \
      "$(date '+%Y-%m-%d %H:%M:%S')" "$rc" "${FILE:-}" "${ARTIST:-}" "${TITLE:-}"
    [ -s "$tmp_log" ] && sed -n '1,200p' "$tmp_log"
    printf '\n'
  } >>"$DEBUG_LOG" 2>/dev/null || true
  notify "Lyrics lookup failed (see $DEBUG_LOG)" error
else
  notify "Lyrics for ${ARTIST:-Unknown Artist} - ${TITLE:-Unknown Title} not found" warn
fi
exit 0
