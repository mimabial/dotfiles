# khal configuration for the quickshell clock popup agenda.
# ~/.calendars is a vdir: one directory per calendar, one .ics file per event.
# Point vdirsyncer at the same tree to sync CalDAV accounts into it.

[calendars]

[[local]]
path = ~/.calendars/*
type = discover

[default]
default_calendar = personal

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
firstweekday = 0
