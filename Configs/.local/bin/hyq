#!/usr/bin/env python3
"""Query values from Hyprland configuration files."""

import argparse
import json
import logging
import os
import re
import sys
from typing import Any

sys.path.insert(0, __file__.rsplit("/.local/", 1)[0] + "/.local/lib/hypr")
from pyutils.hyprlang import HyprlangParser  # noqa: E402

logger = logging.getLogger("hyq")


class SchemaLoader:
    def __init__(self, schema_path: str):
        self.defaults: dict[str, Any] = {}
        if not os.path.exists(schema_path):
            logger.error("Schema file not found: %s", schema_path)
            return

        try:
            with open(schema_path) as schema_file:
                schema = json.load(schema_file)
            options = (
                schema.get("hyprlang_schema", []) if isinstance(schema, dict) else []
            )
            self.defaults = {
                option["value"]: option["data"]["default"]
                for option in options
                if "value" in option and "default" in option.get("data", {})
            }
            logger.debug("Loaded schema from %s", schema_path)
        except json.JSONDecodeError as error:
            logger.error("Failed to parse schema JSON: %s", error)

    def get_default(self, key: str) -> Any | None:
        return self.defaults.get(key)


def infer_scalar_type(value: Any) -> str:
    if value is None:
        return "NULL"
    elif isinstance(value, bool):
        return "BOOL"
    elif isinstance(value, int):
        return "INT"
    elif isinstance(value, float):
        return "FLOAT"
    elif isinstance(value, str):
        if value.startswith(("rgb", "0x", "#")):
            return "COLOR"
        return "STRING"
    else:
        return "CUSTOM"


def infer_type(value: Any) -> str:
    if isinstance(value, list):
        item_types = {infer_scalar_type(item) for item in value}
        item_types.discard("NULL")
        if not item_types:
            return "NULL"
        if len(item_types) == 1:
            return item_types.pop()
        return "CUSTOM"
    return infer_scalar_type(value)


def normalize_type(type_str: str) -> str:
    return type_str.upper().replace("_", "").replace("-", "")


def stringify_value(value: Any) -> str:
    if isinstance(value, list):
        return "\n".join(stringify_value(item) for item in value)
    return str(value)


def escape_env_value(value: str) -> str:
    value = value.replace("\\", "\\\\")
    value = value.replace('"', '\\"')
    value = value.replace("$", "\\$")
    value = value.replace("`", "\\`")
    value = value.replace("\n", "\\n")
    return value


def matches_regex(value: str, pattern: str) -> bool:
    try:
        return bool(re.match(pattern, value))
    except re.error:
        logger.error(f"Invalid regex pattern: {pattern}")
        return False


def filter_value(value: Any, predicate) -> Any | None:
    if isinstance(value, list):
        filtered = [item for item in value if predicate(item)]
        if not filtered:
            return None
        if len(filtered) == 1:
            return filtered[0]
        return filtered
    return value if predicate(value) else None


def parse_query_input(query_str: str) -> tuple[str, str | None, str | None]:
    """Split query[expectedType][expectedRegex]."""
    match = re.match(r"^([^\[]+)(?:\[([^\]]*)\])?(?:\[([^\]]*)\])?", query_str)
    if not match:
        return query_str, None, None

    return match.group(1), match.group(2) or None, match.group(3) or None


def process_query(
    parser: HyprlangParser,
    schema: SchemaLoader | None,
    query_str: str,
) -> dict[str, Any]:
    query, expected_type, expected_regex = parse_query_input(query_str)

    value = parser.query(query)

    if value is None and schema:
        value = schema.get_default(query)

    if value is None:
        return {"key": query, "value": "", "type": "NULL", "flags": []}

    if expected_type:
        expected_type_norm = normalize_type(expected_type)
        value = filter_value(
            value,
            lambda item: normalize_type(infer_type(item)) == expected_type_norm,
        )
        if value is None:
            return {"key": query, "value": "", "type": "NULL", "flags": []}

    if expected_regex:
        value = filter_value(
            value, lambda item: matches_regex(stringify_value(item), expected_regex)
        )
        if value is None:
            return {"key": query, "value": "", "type": "NULL", "flags": []}

    return {"key": query, "value": value, "type": infer_type(value), "flags": []}


def export_json(results: list[dict[str, Any]]):
    output = [
        {
            "key": result["key"],
            "val": result["value"],
            "type": result["type"],
            "flags": result["flags"],
        }
        for result in results
    ]
    print(json.dumps(output, indent=2))


def export_env(results: list[dict[str, Any]], queries: list[str]):
    for result, raw_query in zip(results, queries):
        query = raw_query.removeprefix("$")

        query = re.sub(r"\[.*?\]", "", query)

        env_key = query.replace(":", "_").replace("-", "_")

        is_dynamic = raw_query.startswith("$")
        prefix = "__" if is_dynamic else "_"

        env_value = escape_env_value(stringify_value(result["value"]))
        print(f'{prefix}{env_key}="{env_value}"')


def export_plain(results: list[dict[str, Any]], delimiter: str):
    values = [
        stringify_value(r["value"]) if r["type"] != "NULL" else "" for r in results
    ]
    print(delimiter.join(values))


def main():
    parser = argparse.ArgumentParser(
        description="Query hyprlang .conf/.meta files. "
        "Does not parse the Lua compositor config.",
        epilog="""query syntax:
  section:key[TYPE][REGEX]   nested key, optionally filtered
  $VARIABLE                  hyprlang variable, recursively resolved
  TYPE  keeps list items inferred as BOOL INT FLOAT COLOR STRING CUSTOM
  REGEX keeps list items matching it

A repeated key yields a list, printed one item per line; --delimiter joins the
results of separate -Q flags, not the items within one.
Exit status is 1 if any query resolved to nothing, unless --allow-missing.

examples:
  hyq -Q '$CURSOR_THEME' ~/.config/hypr/themes/theme.meta
  hyq -Q general:lock_cmd ~/.config/hypr/hypridle.conf
  hyq -Q 'listener:on-timeout[][loginctl]' ~/.config/hypr/hypridle.conf
  hyq -Q '$FONT' -Q '$CURSOR_SIZE' -D' | ' ~/.config/hypr/themes/theme.meta
  hyq -s -Q background:path ~/.config/hypr/hyprlock.conf
""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument("config_file", help="Configuration file")
    parser.add_argument(
        "--query",
        "-Q",
        action="append",
        dest="queries",
        required=True,
        help="Query to execute (format: query[expectedType][expectedRegex])",
    )
    parser.add_argument("--schema", help="Schema file")
    parser.add_argument(
        "--allow-missing", action="store_true", help="Allow missing values"
    )
    parser.add_argument(
        "--export", choices=["json", "env"], help="Export format: json or env"
    )
    parser.add_argument(
        "--source", "-s", action="store_true", help="Follow the source command"
    )
    parser.add_argument("--debug", action="store_true", help="Enable debug logging")
    parser.add_argument(
        "--delimiter",
        "-D",
        default="\n",
        help="Delimiter for plain output (default: newline)",
    )

    args = parser.parse_args()

    if args.debug:
        logging.basicConfig(level=logging.DEBUG, format="[%(levelname)s] %(message)s")
    else:
        logging.basicConfig(level=logging.WARNING)

    config_file = args.config_file
    if not os.path.exists(config_file):
        print(
            f"Error: Configuration file does not exist: {config_file}", file=sys.stderr
        )
        return 1

    schema = SchemaLoader(args.schema) if args.schema else None

    hypr_parser = HyprlangParser(follow_source=args.source)
    hypr_parser.parse_file(config_file)

    results = [process_query(hypr_parser, schema, query) for query in args.queries]

    if args.export == "json":
        export_json(results)
    elif args.export == "env":
        export_env(results, args.queries)
    else:
        export_plain(results, args.delimiter)

    return int(not args.allow_missing and any(r["type"] == "NULL" for r in results))


if __name__ == "__main__":
    sys.exit(main())
