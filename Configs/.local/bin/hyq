#!/usr/bin/env python3
import argparse
import os
import sys
from pathlib import Path
from typing import Any

HYPR_LIB_DIR = Path(__file__).resolve().parent.parent / "lib/hypr"
sys.path.insert(0, str(HYPR_LIB_DIR))
from pyutils.hyprlang import HyprlangParser  # noqa: E402


def stringify_value(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, list):
        return "\n".join(stringify_value(item) for item in value)
    return str(value)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Query hyprlang .conf/.meta files. "
        "Does not parse the Lua compositor config.",
        epilog="""query syntax:
  section:key         nested key
  $VARIABLE           hyprlang variable, recursively resolved

A repeated key yields a list, printed one item per line.
Exit status is 1 if any query resolved to nothing.

examples:
  hyq -Q '$CURSOR_THEME' ~/.config/hypr/themes/theme.meta
  hyq -Q general:lock_cmd ~/.config/hypr/hypridle.conf
""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument("config_file", help="Configuration file")
    parser.add_argument(
        "--query",
        "-Q",
        action="append",
        dest="queries",
        required=True,
        help="Query to execute (section:key or $VARIABLE)",
    )
    return parser


def main():
    args = build_parser().parse_args()

    config_file = args.config_file
    if not os.path.exists(config_file):
        print(
            f"Error: Configuration file does not exist: {config_file}", file=sys.stderr
        )
        return 1

    hypr_parser = HyprlangParser()
    hypr_parser.parse_file(config_file)

    values = [hypr_parser.query(query) for query in args.queries]
    print("\n".join(stringify_value(value) for value in values))

    return int(any(value is None for value in values))


if __name__ == "__main__":
    sys.exit(main())
