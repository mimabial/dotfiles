#!/bin/sh
# Export compositor sockets before starting the per-user runit supervisor.

set -u

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

i=0
hypr_socket=""
while [ "$i" -lt 100 ]; do
	for s in "$runtime"/hypr/*/.socket.sock; do
		[ -S "$s" ] && { hypr_socket="$s"; break; }
	done
	[ -n "$hypr_socket" ] && break
	i=$((i + 1))
	sleep 0.1
done

if [ -n "$hypr_socket" ]; then
	sig_dir=${hypr_socket%/*}
	HYPRLAND_INSTANCE_SIGNATURE=${sig_dir##*/}
	export HYPRLAND_INSTANCE_SIGNATURE
fi

for w in "$runtime"/wayland-*; do
	if [ -S "$w" ] && [ -e "$w.lock" ]; then
		WAYLAND_DISPLAY=${w##*/}
		export WAYLAND_DISPLAY
		break
	fi
done

export SVDIR="${SVDIR:-${HYPR_USER_SV_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/sv}}"
exec runsvdir "$SVDIR"
