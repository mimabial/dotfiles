#!/bin/sh
set -eu

usage() {
	cat <<'USAGE'
Usage: hypr-session

Launch Hyprland without uwsm: ensure a session dbus, export the environment,
source the uwsm env.d files, then exec the compositor. Takes no options.
USAGE
}

case "${1:-}" in
	-h | --help)
		usage
		exit 0
		;;
	"") ;;
	*)
		printf 'hypr-session: unknown option: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
esac

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
	exec dbus-run-session -- "$0"
fi

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland

export APP2UNIT_SLICES="${APP2UNIT_SLICES:-a=app-graphical.slice b=background-graphical.slice s=session-graphical.slice}"
for env_file in "$XDG_CONFIG_HOME"/uwsm/env.d/*.sh "$XDG_CONFIG_HOME"/uwsm/env-hyprland.d/*.sh; do
	[ -r "$env_file" ] && . "$env_file"
done

exec Hyprland
