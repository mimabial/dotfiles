#!/usr/bin/env python3
import ctypes
import curses
import fcntl
import json
import os
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import time
from collections.abc import Callable
from datetime import datetime
from pathlib import Path
from typing import Any, NamedTuple

HYPR_LIB_DIR = Path(__file__).resolve().parent.parent / "lib/hypr"
sys.path.insert(0, str(HYPR_LIB_DIR))
from pyutils.xdg_base_dirs import xdg_cache_home
from system.agents.usage_records import LimitRecord, ModelTokens, TokenParts, UsageRecord


class AgentSpec(NamedTuple):
    name: str
    command: str
    shortcut: str
    app_id: str


class DashboardLayout(NamedTuple):
    bottom: int
    label_x: int
    label_width: int
    bar_x: int
    chart_value_x: int
    chart_bar_width: int
    percent_x: int
    reset_x: int
    limit_bar_width: int
    title_gap: int
    section_gap: int
    accent: int
    dim: int


class ChartRow(NamedTuple):
    label: str
    value: int
    label_attr: int
    value_attr: int


class Section(NamedTuple):
    title: str
    rows: list[Any]
    draw_rows: Callable[..., None]


DEFAULT_APP_SCRIPT = HYPR_LIB_DIR / "setup/default-app.sh"
CACHE_FILE = Path(os.environ.get("HYPR_CACHE_HOME") or xdg_cache_home() / "hypr") / "agents" / "usage.json"
CLAUDE_CREDENTIALS = (
    Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser() / ".credentials.json"
)
AGENTS = {
    "claude": AgentSpec("Claude Code", "claude", "c", "org.agent.Claude"),
    "codex": AgentSpec("Codex", "codex", "x", "org.agent.Codex"),
    "opencode": AgentSpec("OpenCode", "opencode", "o", "org.agent.OpenCode"),
}
TOKEN_PART_FIELDS = tuple(TokenParts.__annotations__)

PAIR_ACCENT = 1
PAIR_DIM = 2
PAIR_ERROR = 3
PAIR_HIGHLIGHT = 4
BRIGHT_BLACK = 8
WINSIZE_STRUCT = struct.Struct("HHHH")

PERCENT_WIDTH = 5
RESET_WIDTH = 10
CHART_VALUE_WIDTH = 8
LEFT_MARGIN = 1
RIGHT_MARGIN = 2
LABEL_COLUMN = 3
LABEL_WIDTH_DIVISOR = 4
COLUMN_GAP = 2
SHORT_WINDOW = "short"
LONG_WINDOW = "long"
USAGE_BAR_SEGMENTS = {SHORT_WINDOW: 5, LONG_WINDOW: 7}
USAGE_WINDOWS = (SHORT_WINDOW, LONG_WINDOW)
USAGE_SUMMARY_LABELS = {SHORT_WINDOW: "5h", LONG_WINDOW: "weekly"}
TITLE_ROW = 0
TITLE_RULE_ROW = TITLE_ROW + 1
TAB_ROW = TITLE_RULE_ROW + 1
CURRENT_SIZE_ROW = TITLE_RULE_ROW + 1
HEAD_ROW = TAB_ROW + 2
RECOMMENDED_ROW = HEAD_ROW + 1
FIRST_SECTION_ROW = RECOMMENDED_ROW + 1
SECTION_TITLE_ROWS = 1
FOOTER_GAP_ROWS = 1
FOOTER_ROWS = 3
MIN_ROWS = 24
MIN_COLS = 72
MIN_LABEL_WIDTH = 16
MAX_LABEL_WIDTH = 24
SECTION_GAP_MIN = 1
SECTION_GAP_MAX = 2
MODEL_ROWS = 5
MIN_BAR_WIDTH = 8
APP_TITLE = "Agent Hub"
USAGE = (
    "Usage: agent-tui [--size]\n"
    "AI coding subscription dashboard.\n"
    "  --size  print the terminal columns and rows needed for the current dashboard"
)
AGENT_HUB_APP_ID = "org.tui.AgentHub"
HEADER_GAP = 4
SECTION_RULE_GAP = 1
ALERT_FRACTION = 0.9
REFRESH_NOTE_SECONDS = 60
SECONDS_PER_MINUTE = 60
MINUTES_PER_HOUR = 60
HOURS_PER_DAY = 24
MINUTES_PER_DAY = HOURS_PER_DAY * MINUTES_PER_HOUR
CACHE_MAX_AGE_SECONDS = 900
HYPRCTL_TIMEOUT_SECONDS = 1
DEFAULT_APP_TIMEOUT_SECONDS = 2
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_DELETE = 0x00000200
NOTE_SECONDS = 4
EVENT_READ_BYTES = 4096
RULE_GLYPH = "\u2500"
BAR_GLYPH = "\u2584"
SELECTED_TAB_GLYPH = "\u258c"
DOT_SEPARATOR = " \u00b7 "
KEY_HINT = "\u2190\u2192 agent   Enter launch   d default   s set default   r refresh"
CLOSE_HINT = "q close"


def init_colors():
    curses.start_color()
    curses.use_default_colors()
    accent = curses.COLOR_BLUE
    dim_color_index = BRIGHT_BLACK if curses.COLORS > BRIGHT_BLACK else curses.COLOR_WHITE
    curses.init_pair(PAIR_ACCENT, accent, -1)
    curses.init_pair(PAIR_DIM, dim_color_index, -1)
    curses.init_pair(PAIR_ERROR, curses.COLOR_RED, -1)
    curses.init_pair(PAIR_HIGHLIGHT, curses.COLOR_CYAN, -1)


def load_records() -> list[UsageRecord]:
    try:
        value = json.loads(CACHE_FILE.read_text())
        return (
            [record for record in value if isinstance(record, dict)]
            if isinstance(value, list)
            else []
        )
    except (OSError, json.JSONDecodeError):
        return []


def limit_window(limit: LimitRecord) -> str:
    label = str(limit.get("label") or "").lower()
    compact_label = label.replace(" ", "")
    if "week" in label or "day" in label:
        return LONG_WINDOW
    if (
        "hour" in label
        or "session" in label
        or any(f"{n}h" in compact_label for n in range(1, HOURS_PER_DAY + 1))
    ):
        return SHORT_WINDOW
    return ""


def mtime_ns(path):
    try:
        return path.stat().st_mtime_ns
    except OSError:
        return 0


def watch_cache_changes():
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    libc = ctypes.CDLL(None, use_errno=True)
    event_fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
    if event_fd < 0:
        raise OSError(ctypes.get_errno(), "inotify_init1")
    if libc.inotify_add_watch(event_fd, os.fsencode(CACHE_FILE.parent), IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_DELETE) < 0:
        error = OSError(ctypes.get_errno(), "inotify_add_watch")
        os.close(event_fd)
        raise error
    return event_fd


def parse_time(value):
    try:
        parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return parsed if parsed.tzinfo else parsed.astimezone()
    except (TypeError, ValueError):
        return None


def reported_usage_fraction(limit: LimitRecord) -> float | None:
    try:
        return float(limit.get("usageFraction"))
    except (TypeError, ValueError):
        return None


def limit_expired(limit: LimitRecord) -> bool:
    reset = parse_time(limit.get("resetsAt"))
    return bool(reset and reset <= datetime.now().astimezone())


def peak_window_usage(record: UsageRecord, window: str, reset_expired: bool = False) -> float | None:
    fractions = [
        0.0 if reset_expired and limit_expired(limit) else reported_usage_fraction(limit)
        for limit in record.get("limits") or []
        if limit_window(limit) == window
    ]
    return max((min(1.0, fraction) for fraction in fractions if fraction is not None), default=None)


def is_go_plan_record(record):
    return "goStatus" in record


def recommended_agent(records: list[UsageRecord]) -> UsageRecord | None:
    best_score = None
    best_agent = None
    for record in records:
        if is_go_plan_record(record):
            continue
        usage = [peak_window_usage(record, window, reset_expired=True) for window in USAGE_WINDOWS]
        known_usage = [value for value in usage if value is not None]
        if not known_usage:
            continue
        missing_window_penalty = len(USAGE_WINDOWS) - len(known_usage)
        penalized_peak_usage = max(known_usage) + missing_window_penalty
        combined_usage = sum(known_usage)
        score = (penalized_peak_usage, combined_usage)
        if best_score is None or score < best_score:
            best_score, best_agent = score, record
    return best_agent


def format_compact_number(value):
    number = float(value or 0)
    for threshold, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "K")):
        if number >= threshold:
            return f"{number / threshold:.1f}{suffix}"
    return str(round(number))


def resets_in(value):
    target = parse_time(value)
    if not target:
        return ""
    minutes = max(0, round((target - datetime.now().astimezone()).total_seconds() / SECONDS_PER_MINUTE))
    days, minutes = divmod(minutes, MINUTES_PER_DAY)
    hours, minutes = divmod(minutes, MINUTES_PER_HOUR)
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"


def usage_summary(record):
    parts = []
    for window, label in USAGE_SUMMARY_LABELS.items():
        value = peak_window_usage(record, window)
        if value is not None:
            parts.append(f"{round(value * 100)}% {label} used")
    return DOT_SEPARATOR.join(parts)


def token_total(usage: ModelTokens) -> int:
    return int(usage.get("totalTokens") or 0) or sum(int(usage.get(field) or 0) for field in TOKEN_PART_FIELDS)


def model_totals(record):
    models = []
    for name, usage in (record.get("modelUsage") or {}).items():
        models.append((str(name), token_total(usage)))
    return sorted(models, key=lambda item: item[1], reverse=True)


def go_limit_status(record):
    if is_go_plan_record(record) and not record.get("limits"):
        return str(record.get("goStatus") or "No OpenCode Go key configured")
    return ""


def limits_section(record: UsageRecord) -> Section:
    title = "GO LIMITS" if is_go_plan_record(record) else "LIMITS"
    if status := go_limit_status(record):
        return Section(title, [status], Dashboard.draw_status_rows)
    readings = [
        (limit, fraction)
        for limit in record.get("limits") or []
        if (fraction := reported_usage_fraction(limit)) is not None
    ]
    return Section(title, readings, Dashboard.draw_limit_rows)


def dashboard_sections(record: UsageRecord) -> tuple[Section, ...]:
    return (
        limits_section(record),
        Section("TOKENS BY DAY", record.get("recentDays") or [], Dashboard.draw_day_rows),
        Section("TOKENS BY MODEL", model_totals(record)[:MODEL_ROWS], Dashboard.draw_model_rows),
    )


def content_height(record, title_gap=1):
    return FIRST_SECTION_ROW + FOOTER_ROWS + sum(
        SECTION_GAP_MIN + SECTION_TITLE_ROWS + title_gap + len(section.rows)
        for section in dashboard_sections(record)
    )


def tallest_content(records, title_gap=1):
    return max((content_height(record, title_gap) for record in records), default=0)


def footer_hint(agent_paths):
    return KEY_HINT, CLOSE_HINT + "".join(
        f"   {spec.shortcut} {spec.name}"
        for spec in AGENTS.values()
        if agent_paths[spec.command]
    )


def installed_agent_paths():
    return {spec.command: shutil.which(spec.command) for spec in AGENTS.values()}


def required_terminal_size(records, agent_paths):
    return (
        max(MIN_COLS, max(map(len, footer_hint(agent_paths))) + RIGHT_MARGIN),
        max(MIN_ROWS, tallest_content(records) + FOOTER_GAP_ROWS),
    )


def format_progress_bar(value, width, divisions=1):
    width = max(1, width)
    fraction = max(0.0, min(1.0, float(value)))
    divisions = max(1, divisions)
    cells = width - (divisions - 1)
    if cells < divisions * 2:
        divisions, cells = 1, width
    used = round(cells * fraction)
    if fraction > 0:
        used = max(1, used)
    segments = []
    for index in range(divisions):
        size = cells // divisions + (index < cells % divisions)
        filled = min(size, max(0, used))
        used -= filled
        segments.append(BAR_GLYPH * filled + " " * (size - filled))
    return " ".join(segments)


class Dashboard:
    def __init__(self, screen):
        self.screen = screen
        self.records = load_records()
        self.selected = 0
        self.refresh_process = None
        self.refresh_pidfd = None
        self.message = ""
        self.tab_spans = []
        self.message_error = False
        self.message_until = 0.0
        self.last_mtime = mtime_ns(CACHE_FILE)
        self.default_agent = self.read_default_agent()
        self.agent_paths = installed_agent_paths()
        self.configure_screen()
        if self.cache_is_stale():
            self.refresh(force=False)

    def configure_screen(self):
        curses.curs_set(0)
        self.screen.nodelay(True)
        self.screen.keypad(True)
        curses.mousemask(curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED)
        curses.mouseinterval(0)
        if curses.has_colors():
            init_colors()

    def fit_window_to_content(self):
        rows, columns = self.screen.getmaxyx()
        needed_columns, needed_rows = required_terminal_size(self.records, self.agent_paths)
        if rows >= needed_rows and columns >= needed_columns:
            return
        try:
            _, _, text_width, text_height = WINSIZE_STRUCT.unpack(
                fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, bytes(WINSIZE_STRUCT.size))
            )
            if not text_width or not text_height:
                return
            response = subprocess.check_output(
                ["hyprctl", "-j", "--batch", "clients;monitors"],
                stderr=subprocess.DEVNULL, timeout=HYPRCTL_TIMEOUT_SECONDS,
            )
            clients, monitors = [json.loads(chunk) for chunk in response.split(b"\n\n", 1)]
            window = next((client for client in clients
                           if client.get("pid") == os.getppid()
                           and client.get("class") == AGENT_HUB_APP_ID
                           and client.get("floating")), None)
            if window is None:
                return
            monitor = next((item for item in monitors if item["id"] == window["monitor"]), None)
            if monitor is None:
                return
            left, top, right, bottom = monitor["reserved"]
            width, height = window["size"]
            width = min(width + max(0, needed_columns - columns) * text_width // columns,
                        int(monitor["width"] / monitor["scale"] - left - right))
            height = min(height + max(0, needed_rows - rows) * text_height // rows,
                         int(monitor["height"] / monitor["scale"] - top - bottom))
            selector = json.dumps("address:" + window["address"])
            resize = f"hl.dsp.window.resize({{x={width}, y={height}, exact=true, window={selector}}})"
            center = f"hl.dsp.window.center({{window={selector}, respect_reserved=true}})"
            subprocess.run(
                ["hyprctl", "-q", "--batch", f"dispatch {resize};dispatch {center}"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=HYPRCTL_TIMEOUT_SECONDS, check=False,
            )
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            return

    @staticmethod
    def read_default_agent():
        configured = os.environ.get("HYPR_DEFAULT_AGENT", "")
        if configured:
            return configured
        try:
            return subprocess.run(
                [DEFAULT_APP_SCRIPT, "agent"],
                capture_output=True,
                text=True,
                timeout=DEFAULT_APP_TIMEOUT_SECONDS,
                check=False,
            ).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            return ""

    @staticmethod
    def cache_age():
        try:
            return time.time() - CACHE_FILE.stat().st_mtime
        except OSError:
            return float("inf")

    def cache_is_stale(self):
        return (
            not self.records
            or self.cache_age() > CACHE_MAX_AGE_SECONDS
            or self.last_mtime < mtime_ns(CLAUDE_CREDENTIALS)
        )

    def note(self, message, seconds=NOTE_SECONDS, error=False):
        self.message = message
        self.message_error = error
        self.message_until = time.monotonic() + seconds

    def refresh(self, force=True):
        if self.refresh_process:
            self.note("Usage refresh is already running")
            return
        command = [HYPR_LIB_DIR / "system/agent-usage.sh", "--write"]
        if force:
            command.append("--force")
        try:
            process = subprocess.Popen(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            self.refresh_pidfd = os.pidfd_open(process.pid)
            self.refresh_process = process
            self.note("Refreshing usage...", REFRESH_NOTE_SECONDS)
        except OSError as error:
            self.note(f"Could not refresh: {error}", error=True)

    def update_cache(self, force=False):
        mtime = mtime_ns(CACHE_FILE)
        if mtime != self.last_mtime or force:
            current_id = record.get("id") if (record := self.current()) else ""
            self.records = load_records()
            self.selected = next(
                (
                    i
                    for i, item in enumerate(self.records)
                    if item.get("id") == current_id
                ),
                0,
            )
            self.last_mtime = mtime
            self.fit_window_to_content()

    def finish_refresh(self):
        status = self.refresh_process.wait()
        os.close(self.refresh_pidfd)
        self.refresh_pidfd = None
        self.refresh_process = None
        self.update_cache(force=status == 0)
        self.note("Usage refreshed" if status == 0 else "Usage refresh failed", error=status != 0)

    def click(self):
        try:
            _, x, y, _, _ = curses.getmouse()
        except curses.error:
            return
        if y != TAB_ROW:
            return
        for start, width, index in self.tab_spans:
            if start <= x < start + width and index < len(self.records):
                self.selected = index
                return

    def current(self):
        return self.records[self.selected] if self.records else None

    def launch(self, agent_id):
        if not agent_id:
            self.note("No default agent is configured", error=True)
            return
        spec = AGENTS.get(agent_id)
        if not spec or not self.agent_paths[spec.command]:
            self.note(f"{spec.name if spec else agent_id} is not installed", error=True)
            return
        try:
            subprocess.Popen(
                [
                    HYPR_LIB_DIR / "launch/tui.sh",
                    "--app-id",
                    spec.app_id,
                    "--title",
                    spec.name,
                    "--",
                    spec.command,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.note(f"Opening {spec.name}")
        except OSError as error:
            self.note(f"Could not launch {spec.name}: {error}", error=True)

    def set_default(self):
        record = self.current()
        agent_id = str(record.get("id", "")) if record else ""
        spec = AGENTS.get(agent_id)
        if not spec or not self.agent_paths[spec.command]:
            self.note("The selected provider cannot be set as an agent", error=True)
            return
        result = subprocess.run(
            [DEFAULT_APP_SCRIPT, "agent", agent_id],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            self.default_agent = agent_id
            self.note(f"Default agent set to {spec.name}")
        else:
            self.note("Could not update the default agent", error=True)

    def draw_text(self, y, x, text, attr=0, limit=None):
        height, width = self.screen.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        available = max(0, width - x - 1)
        if limit is not None:
            available = min(available, limit)
        try:
            self.screen.addnstr(y, x, str(text), available, attr)
        except curses.error:
            pass

    def draw_section_title(self, y, title):
        self.draw_text(y, LEFT_MARGIN, title, curses.color_pair(PAIR_ACCENT) | curses.A_BOLD)
        self.draw_text(y, LEFT_MARGIN + len(title) + SECTION_RULE_GAP, RULE_GLYPH * self.screen.getmaxyx()[1], curses.color_pair(PAIR_DIM))

    def draw_header(self, record, width, accent, dim):
        self.draw_text(TITLE_ROW, LEFT_MARGIN, APP_TITLE, accent | curses.A_BOLD)
        updated = ""
        if record and record.get("updatedAt"):
            stamp = parse_time(record.get("updatedAt"))
            if stamp:
                updated = "updated " + stamp.astimezone().strftime("%H:%M")
        self.draw_text(TITLE_ROW, max(LEFT_MARGIN + len(APP_TITLE) + HEADER_GAP, width - len(updated) - RIGHT_MARGIN), updated, dim)
        self.draw_text(TITLE_RULE_ROW, LEFT_MARGIN, RULE_GLYPH * width, dim)

        x = LEFT_MARGIN
        self.tab_spans = []
        for index, item in enumerate(self.records):
            agent_id = str(item.get("id", ""))
            selected = index == self.selected
            entry = (SELECTED_TAB_GLYPH if selected else " ") + f" {index + 1} "
            entry += str(item.get("name", agent_id))
            self.draw_text(TAB_ROW, x, entry, (accent | curses.A_BOLD) if selected else dim)
            span = len(entry)
            if agent_id == self.default_agent:
                marker = " [default]"
                self.draw_text(TAB_ROW, x + span, marker, dim)
                span += len(marker)
            self.tab_spans.append((x, span, index))
            x += span + COLUMN_GAP

        if not record:
            return

        tier = str(record.get("tierLabel") or record.get("usageStatusText") or "")
        heading = DOT_SEPARATOR.join(
            part
            for part in (str(record.get("name", "Agent")), tier, usage_summary(record))
            if part
        )
        self.draw_text(HEAD_ROW, LEFT_MARGIN, heading, curses.A_BOLD)
        chosen = recommended_agent(self.records)
        if chosen:
            name = chosen.get("name", chosen.get("id", "Agent"))
            self.draw_text(
                RECOMMENDED_ROW,
                LEFT_MARGIN,
                f"Recommended  {name}{DOT_SEPARATOR}{usage_summary(chosen)}",
                curses.color_pair(PAIR_HIGHLIGHT),
            )

    def section_spacing(self, height, section_count):
        for title_gap in (1, 0):
            needed = tallest_content(self.records, title_gap)
            if needed <= height:
                break
        return title_gap, min(SECTION_GAP_MAX, SECTION_GAP_MIN + max(0, height - needed) // section_count)

    def draw_status_rows(self, y, statuses, layout):
        for row_y, status in zip(range(y, layout.bottom), statuses):
            self.draw_text(row_y, layout.label_x, status, layout.dim)

    def draw_limit_rows(self, y, readings, layout):
        for row_y, (limit, reading) in zip(range(y, layout.bottom), readings):
            fraction = max(0.0, min(1.0, reading))
            gauge = curses.color_pair(PAIR_ERROR) if fraction >= ALERT_FRACTION else layout.accent
            self.draw_text(
                row_y,
                layout.label_x,
                str(limit.get("label") or "Limit"),
                0,
                layout.label_width,
            )
            divisions = USAGE_BAR_SEGMENTS.get(limit_window(limit), 1)
            self.draw_text(row_y, layout.bar_x, format_progress_bar(fraction, layout.limit_bar_width, divisions), gauge)
            self.draw_text(
                row_y, layout.percent_x, f"{fraction:.0%}".rjust(PERCENT_WIDTH), gauge | curses.A_BOLD
            )
            self.draw_text(
                row_y,
                layout.reset_x,
                resets_in(limit.get("resetsAt")).rjust(RESET_WIDTH),
                layout.dim,
            )

    def draw_day_rows(self, y, days, layout):
        today = datetime.now().astimezone().strftime("%Y-%m-%d")
        rows = []
        for day in days:
            value = int(day.get("tokenCount") or 0)
            date = str(day.get("date") or "")
            try:
                label = (
                    "Today"
                    if date == today
                    else datetime.fromisoformat(date).strftime("%a")
                )
            except ValueError:
                label = date[-len("MM-DD"):]
            today_attr = curses.A_BOLD if date == today else 0
            rows.append(ChartRow(label, value, today_attr, today_attr or layout.dim))
        self.draw_chart_rows(y, rows, layout)

    def draw_model_rows(self, y, models, layout):
        self.draw_chart_rows(y, [ChartRow(name, value, 0, curses.A_BOLD) for name, value in models], layout)

    def draw_chart_rows(self, y, rows, layout):
        peak = max((row.value for row in rows), default=0)
        for row_y, row in zip(range(y, layout.bottom), rows):
            self.draw_text(row_y, layout.label_x, row.label, row.label_attr, layout.label_width)
            self.draw_text(
                row_y,
                layout.bar_x,
                format_progress_bar(row.value / peak if peak else 0, layout.chart_bar_width),
                layout.accent,
            )
            self.draw_text(row_y, layout.chart_value_x, f"{format_compact_number(row.value):>{CHART_VALUE_WIDTH}}", row.value_attr)

    def draw(self):
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        accent, dim = curses.color_pair(PAIR_ACCENT), curses.color_pair(PAIR_DIM)
        if height < MIN_ROWS or width < MIN_COLS:
            self.draw_too_small(height, width, dim)
        else:
            record = self.current()
            self.draw_header(record, width, accent, dim)
            if record:
                sections = dashboard_sections(record)
                self.draw_sections(sections, self.dashboard_layout(height, width, accent, dim, len(sections)))
            else:
                self.draw_empty(dim)
            self.draw_footer(height, width)
        self.screen.refresh()

    def draw_too_small(self, height, width, dim):
        self.draw_text(
            TITLE_ROW,
            LEFT_MARGIN,
            f"{APP_TITLE} needs at least {MIN_COLS} columns x {MIN_ROWS} rows.",
            curses.color_pair(PAIR_ERROR) | curses.A_BOLD,
        )
        self.draw_text(CURRENT_SIZE_ROW, LEFT_MARGIN, f"Current terminal: {width} x {height}", dim)
        self.draw_text(height - 1, LEFT_MARGIN, CLOSE_HINT, dim)

    def draw_empty(self, dim):
        self.draw_text(HEAD_ROW, LEFT_MARGIN, "No AI coding subscription data found.", curses.A_BOLD)
        self.draw_text(
            FIRST_SECTION_ROW,
            LEFT_MARGIN,
            "A refresh is running\u2026" if self.refresh_process else "Press r to collect usage.",
            dim,
        )

    def dashboard_layout(self, height, width, accent, dim, section_count):
        label_width = max(MIN_LABEL_WIDTH, min(MAX_LABEL_WIDTH, width // LABEL_WIDTH_DIVISOR))
        bar_x = LABEL_COLUMN + label_width + COLUMN_GAP
        title_gap, section_gap = self.section_spacing(height, section_count)
        chart_value_x = width - RIGHT_MARGIN - CHART_VALUE_WIDTH
        reset_x = width - RIGHT_MARGIN - RESET_WIDTH
        percent_x = reset_x - PERCENT_WIDTH
        return DashboardLayout(
            bottom=height - FOOTER_ROWS,
            label_x=LABEL_COLUMN,
            label_width=label_width,
            bar_x=bar_x,
            chart_value_x=chart_value_x,
            chart_bar_width=max(MIN_BAR_WIDTH, chart_value_x - bar_x - COLUMN_GAP),
            percent_x=percent_x,
            reset_x=reset_x,
            limit_bar_width=max(MIN_BAR_WIDTH, percent_x - bar_x - COLUMN_GAP),
            title_gap=title_gap,
            section_gap=section_gap,
            accent=accent,
            dim=dim,
        )

    def draw_sections(self, sections, layout):
        y = FIRST_SECTION_ROW
        for section in sections:
            title_row = y + layout.section_gap
            body_row = title_row + SECTION_TITLE_ROWS + layout.title_gap
            if body_row >= layout.bottom:
                return
            self.draw_section_title(title_row, section.title)
            section.draw_rows(self, body_row, section.rows, layout)
            y = body_row + len(section.rows)

    def draw_footer(self, height, width):
        first_hint, second_hint = footer_hint(self.agent_paths)
        rule_row, hint_row, status_row = range(height - FOOTER_ROWS, height)
        self.draw_text(rule_row, LEFT_MARGIN, RULE_GLYPH * width, curses.color_pair(PAIR_DIM))
        self.draw_text(hint_row, LEFT_MARGIN, first_hint, curses.color_pair(PAIR_DIM))
        if self.message and time.monotonic() < self.message_until:
            attr = curses.color_pair(PAIR_ERROR if self.message_error else PAIR_HIGHLIGHT)
            self.draw_text(status_row, LEFT_MARGIN, self.message, attr | curses.A_BOLD)
            return
        self.draw_text(status_row, LEFT_MARGIN, second_hint, curses.color_pair(PAIR_DIM))

    def move_selection(self, offset):
        if self.records:
            self.selected = (self.selected + offset) % len(self.records)

    def launch_current(self):
        record = self.current()
        if record:
            self.launch(str(record.get("id", "")))

    def launch_shortcut(self, key):
        agent_id = next(
            (
                agent_id
                for agent_id, spec in AGENTS.items()
                if key == ord(spec.shortcut)
            ),
            "",
        )
        if agent_id:
            self.launch(agent_id)

    def handle_key(self, key):
        if key == ord("q"):
            return False
        if key == curses.KEY_MOUSE:
            self.click()
        elif key in (curses.KEY_RIGHT, ord("l"), ord("\t")):
            self.move_selection(1)
        elif key in (curses.KEY_LEFT, ord("h"), curses.KEY_BTAB):
            self.move_selection(-1)
        elif ord("1") <= key <= ord("9") and key - ord("1") < len(self.records):
            self.selected = key - ord("1")
        elif key in (ord("\n"), ord("\r"), ord("a")):
            self.launch_current()
        elif key == ord("d"):
            self.launch(self.default_agent)
        elif key == ord("s"):
            self.set_default()
        elif key == ord("r"):
            self.refresh()
        else:
            self.launch_shortcut(key)
        return True

    def run(self):
        cache_events_fd = watch_cache_changes()
        resize_read, resize_write = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        previous_wakeup_fd = signal.set_wakeup_fd(resize_write, warn_on_full_buffer=False)
        previous_resize_handler = signal.signal(signal.SIGWINCH, lambda *_: None)
        stdin_fd = sys.stdin.fileno()
        try:
            self.update_cache()
            self.fit_window_to_content()
            self.draw()
            while True:
                watched = [stdin_fd, cache_events_fd, resize_read]
                if self.refresh_pidfd is not None:
                    watched.append(self.refresh_pidfd)
                timeout = max(0, self.message_until - time.monotonic()) if self.message else None
                ready, _, _ = select.select(watched, [], [], timeout)
                if not ready:
                    self.message = ""
                if resize_read in ready and signal.SIGWINCH in os.read(resize_read, EVENT_READ_BYTES):
                    size = os.get_terminal_size(stdin_fd)
                    curses.resizeterm(size.lines, size.columns)
                    self.fit_window_to_content()
                if cache_events_fd in ready:
                    os.read(cache_events_fd, EVENT_READ_BYTES)
                    self.update_cache()
                if self.refresh_pidfd in ready:
                    self.finish_refresh()
                if stdin_fd in ready:
                    key = self.screen.getch()
                    while key != curses.ERR:
                        if not self.handle_key(key):
                            return
                        key = self.screen.getch()
                self.draw()
        finally:
            if previous_resize_handler is not None:
                signal.signal(signal.SIGWINCH, previous_resize_handler)
            signal.set_wakeup_fd(previous_wakeup_fd)
            os.close(resize_read)
            os.close(resize_write)
            os.close(cache_events_fd)
            if self.refresh_pidfd is not None:
                os.close(self.refresh_pidfd)


def main():
    arguments = sys.argv[1:]
    if arguments in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if arguments == ["--size"]:
        print(*required_terminal_size(load_records(), installed_agent_paths()))
        return 0
    if arguments:
        print(USAGE, file=sys.stderr)
        return 2
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("agent-tui: the interactive dashboard requires a terminal", file=sys.stderr)
        return 2
    curses.wrapper(lambda screen: Dashboard(screen).run())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
