#!/usr/bin/env python3
"""Interactive terminal view of the cached AI-agent usage records."""

import argparse
import curses
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Any, NamedTuple, TypedDict


class UsageRecord(TypedDict, total=False):
    id: str
    name: str
    tierLabel: str
    usageStatusText: str
    goStatus: str
    updatedAt: str
    limits: list[dict[str, Any]]
    recentDays: list[dict[str, Any]]
    modelUsage: dict[str, dict[str, int]]


class AgentSpec(NamedTuple):
    name: str
    command: str
    shortcut: str


class DashboardLayout(NamedTuple):
    width: int
    bottom: int
    label_x: int
    label_width: int
    bar_x: int
    value_x: int
    chart_width: int
    title_gap: int
    section_gap: int
    accent: int
    dim: int


cache_root = Path(
    os.environ.get("HYPR_CACHE_HOME")
    or Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "hypr"
)
CACHE_FILE = cache_root / "agents" / "usage.json"
CLAUDE_CREDENTIALS = (
    Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser() / ".credentials.json"
)
AGENTS = {
    "claude": AgentSpec("Claude Code", "claude", "c"),
    "codex": AgentSpec("Codex", "codex", "x"),
    "opencode": AgentSpec("OpenCode", "opencode", "o"),
}
TOKEN_FIELDS = (
    "totalTokens",
    "inputTokens",
    "outputTokens",
    "cacheCreationInputTokens",
    "cacheReadInputTokens",
)

# The rendered terminal ANSI slots keep this palette theme-aware.
PAIR_ACCENT = 1
PAIR_DIM = 2
PAIR_ERROR = 3
PAIR_BAR = 4

VALUE_WIDTH = 5
RESET_WIDTH = 10
TOKEN_VALUE_WIDTH = 8
RIGHT_MARGIN = 2
USAGE_BAR_SEGMENTS = {"hourly": 5, "weekly": 7}
USAGE_WINDOWS = ("hourly", "weekly")
TAB_ROW = 2
HEAD_ROW = TAB_ROW + 2
MIN_ROWS = 24
MIN_COLS = 72
MIN_LABEL_WIDTH = 16
MAX_LABEL_WIDTH = 24
SECTION_GAP_MAX = 1
CACHE_MAX_AGE_SECONDS = 900
HINT = "\u2190\u2192 agent   Enter launch   d default   s set default   r refresh   q close"


def init_colors():
    curses.start_color()
    curses.use_default_colors()
    accent = curses.COLOR_BLUE
    dim_color_index = 8 if curses.COLORS >= 16 else curses.COLOR_WHITE
    curses.init_pair(PAIR_ACCENT, accent, -1)
    curses.init_pair(PAIR_DIM, dim_color_index, -1)
    curses.init_pair(PAIR_ERROR, curses.COLOR_RED, -1)
    curses.init_pair(PAIR_BAR, curses.COLOR_CYAN, -1)


def load_records() -> list[UsageRecord]:
    try:
        value = json.loads(CACHE_FILE.read_text())
        return (
            [record for record in value if isinstance(record, dict)]
            if isinstance(value, list)
            else []
        )
    except (OSError, json.JSONDecodeError):
        return []


def window_kind(limit):
    label = str(limit.get("label") or limit.get("title") or "").lower()
    compact_label = label.replace(" ", "")
    if "week" in label or "day" in label:
        return "weekly"
    if (
        "hour" in label
        or "session" in label
        or any(f"{n}h" in compact_label for n in range(1, 25))
    ):
        return "hourly"
    return ""


def mtime_ns(path):
    try:
        return path.stat().st_mtime_ns
    except OSError:
        return 0


def parse_time(value):
    try:
        parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return parsed if parsed.tzinfo else parsed.astimezone()
    except (TypeError, ValueError):
        return None


def limit_percent(limit):
    """Return the last reading, retaining stale values until a collector updates them."""
    try:
        return float(limit.get("percent", -1))
    except (TypeError, ValueError):
        return -1.0


def limit_expired(limit):
    reset = parse_time(limit.get("resetsAt"))
    return bool(reset and reset <= datetime.now().astimezone())


def peak_window_usage(record, kind, reset_expired=False):
    percentages = [
        min(1.0, 0.0 if reset_expired and limit_expired(limit) else limit_percent(limit))
        for limit in record.get("limits") or []
        if window_kind(limit) == kind
    ]
    return max((value for value in percentages if value >= 0), default=None)


def recommended_agent(records: list[UsageRecord]) -> UsageRecord | None:
    best_score = None
    best_agent = None
    for record in records:
        if record.get("id") == "opencode":
            continue
        usage = [peak_window_usage(record, kind, reset_expired=True) for kind in USAGE_WINDOWS]
        known_usage = [value for value in usage if value is not None]
        if not known_usage:
            continue
        missing_window_penalty = len(USAGE_WINDOWS) - len(known_usage)
        penalized_peak_usage = max(known_usage) + missing_window_penalty
        combined_usage = sum(known_usage)
        score = (penalized_peak_usage, combined_usage)
        if best_score is None or score < best_score:
            best_score, best_agent = score, record
    return best_agent


def compact(value):
    number = float(value or 0)
    for threshold, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "K")):
        if number >= threshold:
            return f"{number / threshold:.1f}{suffix}"
    return str(round(number))


def resets_in(value):
    target = parse_time(value)
    if not target:
        return ""
    minutes = max(0, round((target - datetime.now().astimezone()).total_seconds() / 60))
    if minutes >= 1440:
        return f"{minutes // 1440}d {(minutes % 1440) // 60}h"
    if minutes >= 60:
        return f"{minutes // 60}h {minutes % 60}m"
    return f"{minutes}m"


def usage_summary(record):
    parts = []
    for kind, label in (("hourly", "5h"), ("weekly", "weekly")):
        value = peak_window_usage(record, kind)
        if value is not None:
            parts.append(f"{round(value * 100)}% {label} used")
    return " \u00b7 ".join(parts)


def model_totals(record):
    models = []
    for name, usage in (record.get("modelUsage") or {}).items():
        models.append(
            (str(name), sum(int(usage.get(field) or 0) for field in TOKEN_FIELDS))
        )
    return sorted(models, key=lambda item: item[1], reverse=True)


def go_limit_status(record):
    if record.get("id") == "opencode" and not record.get("limits"):
        return str(record.get("goStatus") or "No OpenCode Go key configured")
    return ""


def content_height(record, title_gap=1):
    sections = (
        len(record.get("limits") or []) or bool(go_limit_status(record)),
        len(record.get("recentDays") or []),
        len(model_totals(record)[:5]),
    )
    # Header, section titles/rows/gaps, footer rule, and hint.
    total = HEAD_ROW + 3
    for index, count in enumerate(sections):
        total += 1 if index else 0
        total += 1
        if count:
            total += title_gap + count
    return total + 2  # footer rule and hint


def required_rows(records, spare=2):
    needed = max((content_height(record) for record in records), default=0)
    return max(MIN_ROWS, needed + spare)


def progress(value, width, divisions=1):
    width = max(1, width)
    fraction = max(0.0, min(1.0, float(value)))
    divisions = max(1, divisions)
    cells = width - (divisions - 1)
    if cells < divisions * 2:
        divisions, cells = 1, width
    used = round(cells * fraction)
    if fraction > 0:
        used = max(1, used)
    segments = []
    for index in range(divisions):
        size = cells // divisions + (index < cells % divisions)
        filled = min(size, max(0, used))
        used -= filled
        segments.append("\u2584" * filled + " " * (size - filled))
    return " ".join(segments)


def snapshot(records, selected_id=""):
    if not records:
        return "Agent Hub\n\nNo AI coding subscription data found. Press r in the TUI to collect usage."
    selected = next(
        (record for record in records if record.get("id") == selected_id), records[0]
    )
    chosen = recommended_agent(records)
    lines = ["Agent Hub", "\u2500" * 72]
    tabs = [f"[{record.get('name', record.get('id', 'Agent'))}]" for record in records]
    headline = (selected.get("name", "Agent"), selected.get("tierLabel") or selected.get("usageStatusText"), usage_summary(selected))
    lines += ["  ".join(tabs), " \u00b7 ".join(str(part) for part in headline if part)]
    if chosen:
        lines.append(
            f"Recommended  {chosen.get('name', chosen.get('id', 'Agent'))} \u00b7 {usage_summary(chosen)}"
        )
    lines += ["", "GO LIMITS" if selected.get("id") == "opencode" else "LIMITS"]
    if status := go_limit_status(selected):
        lines.append(status)
    for limit in selected.get("limits") or []:
        percent = max(0.0, min(1.0, limit_percent(limit)))
        reset = resets_in(limit.get("resetsAt"))
        lines.append(
            f"{limit.get('label', 'Limit')!s:22} "
            f"[{progress(percent, 28, USAGE_BAR_SEGMENTS.get(window_kind(limit), 1))}] "
            f"{percent:>4.0%}  resets in {reset}"
        )
    lines += ["", "TOKENS BY DAY"]
    days = selected.get("recentDays") or []
    peak = max((int(day.get("messageCount") or 0) for day in days), default=0)
    for day in days:
        value = int(day.get("messageCount") or 0)
        lines.append(
            f"{day.get('date', '')!s:12} [{progress(value / peak if peak else 0, 28)}] {compact(value):>7}"
        )
    lines += ["", "TOKENS BY MODEL"]
    models = model_totals(selected)[:5]
    peak = models[0][1] if models else 0
    for name, value in models:
        lines.append(
            f"{name[:24]:24} [{progress(value / peak if peak else 0, 26)}] {compact(value):>7}"
        )
    return "\n".join(lines)


class Dashboard:
    def __init__(self, screen):
        self.screen = screen
        self.records = load_records()
        self.selected = 0
        self.refresh_process = None
        self.message = ""
        self.tab_spans = []
        self.message_error = False
        self.message_until = 0.0
        self.last_mtime = mtime_ns(CACHE_FILE)
        self.default_agent = self.read_default_agent()
        self.agent_paths = {
            spec.command: shutil.which(spec.command) for spec in AGENTS.values()
        }
        self.configure_screen()
        if (
            not self.records
            or self.cache_age() > CACHE_MAX_AGE_SECONDS
            or self.last_mtime < mtime_ns(CLAUDE_CREDENTIALS)
        ):
            self.refresh(force=False)

    def configure_screen(self):
        curses.curs_set(0)
        self.screen.timeout(250)
        self.screen.keypad(True)
        # Avoid curses' click-delay because this UI does not distinguish drags.
        curses.mousemask(curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED)
        curses.mouseinterval(0)
        if curses.has_colors():
            init_colors()

    @staticmethod
    def read_default_agent():
        configured = os.environ.get("HYPR_DEFAULT_AGENT", "")
        if configured:
            return configured
        try:
            return subprocess.run(
                ["hyprshell", "setup/default.sh", "agent"],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            ).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            return ""

    @staticmethod
    def cache_age():
        try:
            return time.time() - CACHE_FILE.stat().st_mtime
        except OSError:
            return float("inf")

    def note(self, message, seconds=4, error=False):
        self.message = message
        self.message_error = error
        self.message_until = time.monotonic() + seconds

    def refresh(self, force=True):
        if self.refresh_process and self.refresh_process.poll() is None:
            self.note("Usage refresh is already running")
            return
        command = ["hyprshell", "system/agent-usage", "--write"]
        if force:
            command.append("--force")
        try:
            self.refresh_process = subprocess.Popen(
                command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            self.note("Refreshing usage...", 60)
        except OSError as error:
            self.note(f"Could not refresh: {error}", error=True)

    def poll(self):
        status = None
        if self.refresh_process and self.refresh_process.poll() is not None:
            status = self.refresh_process.returncode
            self.refresh_process = None
        mtime = mtime_ns(CACHE_FILE)
        if mtime != self.last_mtime or status == 0:
            current_id = self.current().get("id") if self.current() else ""
            self.records = load_records()
            self.selected = next(
                (
                    i
                    for i, item in enumerate(self.records)
                    if item.get("id") == current_id
                ),
                0,
            )
            self.last_mtime = mtime
        if status is not None:
            self.note(
                "Usage refreshed" if status == 0 else "Usage refresh failed",
                error=status != 0,
            )

    def click(self):
        try:
            _, x, y, _, _ = curses.getmouse()
        except curses.error:
            return
        if y != TAB_ROW:
            return
        for start, width, index in self.tab_spans:
            if start <= x < start + width:
                self.selected = index
                return

    def current(self):
        if not self.records:
            return None
        self.selected %= len(self.records)
        return self.records[self.selected]

    def launch(self, agent_id):
        spec = AGENTS.get(agent_id)
        if not agent_id:
            self.note("No default agent is configured", error=True)
            return
        if not spec or not shutil.which(spec.command):
            self.note(f"{spec.name if spec else agent_id} is not installed", error=True)
            return
        try:
            subprocess.Popen(
                [
                    "hyprshell",
                    "launch/tui.sh",
                    "--app-id",
                    f"org.agent.{agent_id.title()}",
                    "--title",
                    spec.name,
                    "--",
                    spec.command,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            self.note(f"Opening {spec.name}")
        except OSError as error:
            self.note(f"Could not launch {spec.name}: {error}", error=True)

    def set_default(self):
        record = self.current()
        agent_id = str(record.get("id", "")) if record else ""
        spec = AGENTS.get(agent_id)
        if not spec or not shutil.which(spec.command):
            self.note("The selected provider cannot be set as an agent", error=True)
            return
        result = subprocess.run(
            ["hyprshell", "setup/default.sh", "agent", agent_id],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            self.default_agent = agent_id
            self.note(f"Default agent set to {spec.name}")
        else:
            self.note("Could not update the default agent", error=True)

    def put(self, y, x, text, attr=0, limit=None):
        height, width = self.screen.getmaxyx()
        if y < 0 or y >= height or x >= width:
            return
        available = max(0, width - x - 1)
        if limit is not None:
            available = min(available, limit)
        try:
            self.screen.addnstr(y, x, str(text), available, attr)
        except curses.error:
            pass

    def section(self, y, title, title_gap=1):
        self.put(y, 1, title, curses.color_pair(PAIR_ACCENT) | curses.A_BOLD)
        self.put(y, 2 + len(title), "\u2500" * 200, curses.color_pair(PAIR_DIM))
        return y + 1 + title_gap

    def hint(self):
        installed = [
            f"{spec.shortcut} {spec.name}"
            for spec in AGENTS.values()
            if self.agent_paths[spec.command]
        ]
        return HINT + ("   " + "   ".join(installed) if installed else "")

    def draw_header(self, record, width, accent, dim):
        self.put(0, 1, "Agent Hub", accent | curses.A_BOLD)
        updated = ""
        if record and record.get("updatedAt"):
            stamp = parse_time(record.get("updatedAt"))
            if stamp:
                updated = "updated " + stamp.astimezone().strftime("%H:%M")
        self.put(0, max(14, width - len(updated) - 2), updated, dim)
        self.put(1, 1, "\u2500" * (width - 2), dim)

        x = 1
        self.tab_spans = []
        for index, item in enumerate(self.records):
            agent_id = str(item.get("id", ""))
            selected = index == self.selected
            entry = ("\u258c" if selected else " ") + f" {index + 1} "
            entry += str(item.get("name", agent_id))
            self.put(TAB_ROW, x, entry, (accent | curses.A_BOLD) if selected else dim)
            span = len(entry)
            if agent_id == self.default_agent:
                marker = " [default]"
                self.put(TAB_ROW, x + span, marker, dim)
                span += len(marker)
            self.tab_spans.append((x, span, index))
            x += span + 2

        if not record:
            return

        tier = str(record.get("tierLabel") or record.get("usageStatusText") or "")
        heading = " \u00b7 ".join(
            part
            for part in (str(record.get("name", "Agent")), tier, usage_summary(record))
            if part
        )
        self.put(HEAD_ROW, 1, heading, curses.A_BOLD)
        chosen = recommended_agent(self.records)
        if chosen:
            name = chosen.get("name", chosen.get("id", "Agent"))
            self.put(
                HEAD_ROW + 1,
                1,
                f"Recommended  {name} \u00b7 {usage_summary(chosen)}",
                curses.color_pair(PAIR_BAR),
            )

    def section_spacing(self, height):
        title_gap = 1
        needed = max(
            (content_height(item, title_gap) for item in self.records), default=0
        )
        if needed > height:
            title_gap = 0
            needed = max(
                (content_height(item, title_gap) for item in self.records), default=0
            )
        return title_gap, 1 + min(SECTION_GAP_MAX, max(0, height - needed) // 3)

    def draw_limits(self, record, y, layout):
        y = self.section(y, "GO LIMITS" if record.get("id") == "opencode" else "LIMITS", layout.title_gap)
        if status := go_limit_status(record):
            self.put(y, layout.label_x, status, layout.dim)
            return y + 1
        reset_x = layout.width - RIGHT_MARGIN - RESET_WIDTH
        percent_x = reset_x - VALUE_WIDTH
        limit_width = max(8, percent_x - layout.bar_x - 2)
        for limit in record.get("limits") or []:
            if y >= layout.bottom:
                break
            percent = max(0.0, min(1.0, limit_percent(limit)))
            gauge = curses.color_pair(PAIR_ERROR) if percent >= 0.9 else layout.accent
            self.put(
                y,
                layout.label_x,
                str(limit.get("label") or "Limit"),
                0,
                layout.label_width,
            )
            divisions = USAGE_BAR_SEGMENTS.get(window_kind(limit), 1)
            self.put(y, layout.bar_x, progress(percent, limit_width, divisions), gauge)
            self.put(
                y, percent_x, f"{percent:.0%}".rjust(VALUE_WIDTH), gauge | curses.A_BOLD
            )
            self.put(
                y,
                reset_x,
                resets_in(limit.get("resetsAt")).rjust(RESET_WIDTH),
                layout.dim,
            )
            y += 1
        return y

    @staticmethod
    def day_chart_rows(record, dim):
        today = datetime.now().astimezone().strftime("%Y-%m-%d")
        rows = []
        for day in record.get("recentDays") or []:
            value = int(day.get("messageCount") or 0)
            date = str(day.get("date") or "")
            try:
                label = (
                    "Today"
                    if date == today
                    else datetime.fromisoformat(date).strftime("%a")
                )
            except ValueError:
                label = date[-5:]
            live = curses.A_BOLD if date == today else 0
            rows.append((label, value, live, live or dim))
        return rows

    def draw_chart(self, y, title, rows, layout):
        y = self.section(y, title, layout.title_gap)
        peak = max((value for _, value, _, _ in rows), default=0)
        for label, value, label_attr, value_attr in rows:
            if y >= layout.bottom:
                break
            self.put(y, layout.label_x, label, label_attr, layout.label_width)
            self.put(
                y,
                layout.bar_x,
                progress(value / peak if peak else 0, layout.chart_width),
                layout.accent,
            )
            self.put(y, layout.value_x, f"{compact(value):>8}", value_attr)
            y += 1
        return y

    def draw(self):
        self.screen.erase()
        height, width = self.screen.getmaxyx()
        accent, dim = curses.color_pair(PAIR_ACCENT), curses.color_pair(PAIR_DIM)

        if height < MIN_ROWS or width < MIN_COLS:
            self.put(
                0,
                1,
                f"Agent Hub needs at least {MIN_COLS} columns x {MIN_ROWS} rows.",
                curses.color_pair(PAIR_ERROR) | curses.A_BOLD,
            )
            self.put(2, 1, f"Current terminal: {width} x {height}", dim)
            self.put(height - 1, 1, "q close", dim)
            self.screen.refresh()
            return

        record = self.current()
        self.draw_header(record, width, accent, dim)
        if not record:
            self.put(4, 1, "No AI coding subscription data found.", curses.A_BOLD)
            self.put(
                6,
                1,
                "A refresh is running\u2026"
                if self.refresh_process
                else "Press r to collect usage.",
                dim,
            )
            self.draw_footer(height, width)
            self.screen.refresh()
            return

        label_x = 3
        label_width = max(MIN_LABEL_WIDTH, min(MAX_LABEL_WIDTH, width // 4))
        bar_x = label_x + label_width + 2
        title_gap, gap = self.section_spacing(height)
        value_x = width - RIGHT_MARGIN - TOKEN_VALUE_WIDTH
        chart_width = max(8, value_x - bar_x - 2)
        layout = DashboardLayout(
            width=width,
            bottom=height - 2,
            label_x=label_x,
            label_width=label_width,
            bar_x=bar_x,
            value_x=value_x,
            chart_width=chart_width,
            title_gap=title_gap,
            section_gap=gap,
            accent=accent,
            dim=dim,
        )
        y = self.draw_limits(record, HEAD_ROW + 2 + layout.section_gap, layout)
        y = self.draw_chart(
            y + layout.section_gap,
            "TOKENS BY DAY",
            self.day_chart_rows(record, dim),
            layout,
        )
        if y + layout.section_gap + layout.title_gap + 1 < layout.bottom:
            model_rows = [
                (name, value, 0, curses.A_BOLD)
                for name, value in model_totals(record)[:5]
            ]
            self.draw_chart(
                y + layout.section_gap, "TOKENS BY MODEL", model_rows, layout
            )

        self.draw_footer(height, width)
        self.screen.refresh()

    def draw_footer(self, height, width):
        self.put(height - 2, 1, "\u2500" * (width - 2), curses.color_pair(PAIR_DIM))
        if self.message and time.monotonic() < self.message_until:
            attr = curses.color_pair(PAIR_ERROR if self.message_error else PAIR_BAR)
            self.put(height - 1, 1, self.message, attr | curses.A_BOLD)
            return
        self.put(height - 1, 1, self.hint(), curses.color_pair(PAIR_DIM))

    def move_selection(self, offset):
        if self.records:
            self.selected = (self.selected + offset) % len(self.records)

    def launch_current(self):
        record = self.current()
        if record:
            self.launch(str(record.get("id", "")))

    def launch_shortcut(self, key):
        agent_id = next(
            (
                agent_id
                for agent_id, spec in AGENTS.items()
                if key == ord(spec.shortcut)
            ),
            "",
        )
        if agent_id:
            self.launch(agent_id)

    def handle_key(self, key):
        if key == ord("q"):
            return False
        if key == curses.KEY_MOUSE:
            self.click()
        elif key in (curses.KEY_RIGHT, ord("l"), 9):
            self.move_selection(1)
        elif key in (curses.KEY_LEFT, ord("h"), curses.KEY_BTAB):
            self.move_selection(-1)
        elif ord("1") <= key <= ord("9") and key - ord("1") < len(self.records):
            self.selected = key - ord("1")
        elif key in (10, 13, ord("a")):
            self.launch_current()
        elif key == ord("d"):
            self.launch(self.default_agent)
        elif key == ord("s"):
            self.set_default()
        elif key == ord("r"):
            self.refresh()
        else:
            self.launch_shortcut(key)
        return True

    def run(self):
        while True:
            self.poll()
            self.draw()
            if not self.handle_key(self.screen.getch()):
                return


def main():
    parser = argparse.ArgumentParser(description="AI coding subscription dashboard")
    parser.add_argument(
        "--snapshot",
        action="store_true",
        help="print the current dashboard data without curses",
    )
    parser.add_argument(
        "--agent", default="", help="provider id to select with --snapshot"
    )
    parser.add_argument(
        "--size",
        action="store_true",
        help="print the terminal columns and rows needed by the launcher",
    )
    args = parser.parse_args()
    records = load_records()
    if args.size:
        print(MIN_COLS, required_rows(records))
        return
    if args.snapshot:
        print(snapshot(records, args.agent))
        return
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error(
            "the interactive dashboard requires a terminal; use --snapshot for plain output"
        )
    curses.wrapper(lambda screen: Dashboard(screen).run())


if __name__ == "__main__":
    main()
