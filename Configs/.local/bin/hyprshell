#!/usr/bin/env bash

executable_path="${BASH_SOURCE[0]:-$0}"
[[ "${executable_path}" == /* && ! -L "${executable_path}" ]] || executable_path="$(realpath "${executable_path}")"
BIN_DIR="${executable_path%/*}"
LIB_DIR="${BIN_DIR%/*}/lib"
unset executable_path
runtime_init="${LIB_DIR}/hypr/runtime/init.bash"

[[ -r "${runtime_init}" ]] || {
  printf 'Error: missing lib %s\n' "${runtime_init}" >&2
  exit 1
}

# shellcheck source=/dev/null
source "${runtime_init}" || exit 1
unset runtime_init

hyprshell_prepend_path() {
  local entry=""
  local prefix=""

  for entry in "$@"; do
    [[ -n "${entry}" ]] || continue
    case ":${PATH}:" in
      *":${entry}:"*) continue ;;
    esac
    prefix="${prefix:+${prefix}:}${entry}"
  done

  PATH="${prefix:+${prefix}:}${PATH}"
}

hyprshell_prepend_path "${BIN_DIR}" "${HYPR_LIB_DIR}"

HYPR_SCRIPTS_PATH="${HYPR_SCRIPTS_PATH:-${LIB_DIR}/hypr}"

export BIN_DIR LIB_DIR PATH HYPR_SCRIPTS_PATH

hyprshell_load_venv_helpers() {
  declare -F hyprshell_ensure_and_activate_python_environment >/dev/null 2>&1 && return 0
  # shellcheck source=/dev/null
  source "${LIB_DIR}/hypr/shell/lib/hyprshell.venv.bash"
}

hyprshell_load_completion_helpers() {
  declare -F hyprshell_print_completions >/dev/null 2>&1 && return 0
  # shellcheck source=/dev/null
  source "${LIB_DIR}/hypr/shell/lib/hyprshell.completion.bash"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" && "${1:-}" == "app" ]]; then
  export PATH="${HYPR_SCRIPTS_PATH}:${PATH}"
  shift
  exec "${HYPR_LIB_DIR}/system/app2unit.sh" "$@"
fi

for hyprshell_lib in \
  "${LIB_DIR}/hypr/shell/lib/hyprshell.discovery.bash" \
  "${LIB_DIR}/hypr/shell/lib/hyprshell.dispatch.bash" \
  "${LIB_DIR}/hypr/shell/lib/hyprshell.commands.bash"; do
  if [[ ! -r "${hyprshell_lib}" ]]; then
    printf 'Error: missing lib %s\n' "${hyprshell_lib}" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "${hyprshell_lib}" || exit 1
done

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  hyprshell_load_venv_helpers || return 1
  hyprshell_load_completion_helpers || return 1
  if ! hypr_runtime_load_shell_environment; then
    printf 'Error: could not load config, broken installation?\n' >&2
    return 1
  fi
  return 0
fi

export HYPR_SHELL_INIT=1

case "${1:-}" in
  init | --init)
    hyprshell_print_init_environment
    ;;
  logout)
    hyprshell_exit_session
    ;;
  pip)
    shift
    hyprshell_load_venv_helpers || exit 1
    hyprshell_run_managed_pip "$@"
    ;;
  -r | reload)
    hyprshell_load_venv_helpers || exit 1
    hyprshell_refresh_python_wallpaper_and_theme
    ;;
  --release-notes | release-notes)
    hyprshell_print_dotfiles_changes
    ;;
  --version | version | -v)
    hyprshell_print_dotfiles_version
    ;;
  --help | help | -h)
    hyprshell_print_usage
    ;;
  "" | list)
    hyprshell_print_described_scripts
    ;;
  --list-script)
    hyprshell_print_script_names
    ;;
  --list-script-path)
    hyprshell_print_script_paths
    ;;
  completions | --completions)
    shift
    hyprshell_load_completion_helpers || exit 1
    hyprshell_print_completions "${1:-}"
    ;;
  pyinit)
    hyprshell_load_venv_helpers || exit 1
    hyprshell_update_python_environment
    ;;
  resolve)
    shift
    hyprshell_print_command_path "${1:-}"
    ;;
  *)
    hyprshell_exec_command "$@"
    ;;
esac
