#!/usr/bin/env bash

executable_path="$(realpath "${BASH_SOURCE[0]:-$0}")"
BIN_DIR="${executable_path%/*}"
LIB_DIR="${BIN_DIR%/*}/lib"
unset executable_path
runtime_init="${LIB_DIR}/hypr/runtime/init.bash"

[[ -r "${runtime_init}" ]] || {
  printf 'Error: missing lib %s\n' "${runtime_init}" >&2
  exit 1
}

# shellcheck source=/dev/null
source "${runtime_init}" || exit 1
unset runtime_init

hyprshell_prepend_path() {
  local entry=""
  local prefix=""

  for entry in "$@"; do
    [[ -n "${entry}" ]] || continue
    case ":${PATH}:" in
      *":${entry}:"*) continue ;;
    esac
    prefix="${prefix:+${prefix}:}${entry}"
  done

  PATH="${prefix:+${prefix}:}${PATH}"
}

hyprshell_prepend_path "${BIN_DIR}" "${HYPR_LIB_DIR}"

HYPR_SCRIPTS_PATH="${HYPR_SCRIPTS_PATH:-${LIB_DIR}/hypr}"

export BIN_DIR LIB_DIR PATH HYPR_SCRIPTS_PATH

hyprshell_load_python_helpers() {
  declare -F python_activate >/dev/null 2>&1 && return 0
  # shellcheck source=/dev/null
  source "${LIB_DIR}/hypr/shell/lib/hyprshell.python.bash"
}

hyprshell_load_completion_helpers() {
  declare -F generate_completions >/dev/null 2>&1 && return 0
  # shellcheck source=/dev/null
  source "${LIB_DIR}/hypr/shell/lib/hyprshell.completion.bash"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" && "${1:-}" == "app" ]]; then
  export PATH="${HYPR_SCRIPTS_PATH}:${PATH}"
  shift
  exec "${HYPR_LIB_DIR}/system/app2unit.sh" "$@"
fi

for hyprshell_lib in \
  "${LIB_DIR}/hypr/shell/lib/hyprshell.runner.bash" \
  "${LIB_DIR}/hypr/shell/lib/hyprshell.commands.bash"; do
  if [[ ! -r "${hyprshell_lib}" ]]; then
    printf 'Error: missing lib %s\n' "${hyprshell_lib}" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "${hyprshell_lib}" || exit 1
done

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  hyprshell_load_python_helpers || return 1
  hyprshell_load_completion_helpers || return 1
  if ! hypr_runtime_bootstrap; then
    printf 'Error: could not load config, broken installation?\n' >&2
    return 1
  fi
  return 0
fi

export HYPR_SHELL_INIT=1

case "${1:-}" in
  init | --init)
    print_init_env
    ;;
  logout)
    hyprlogout
    ;;
  pip)
    hyprshell_load_python_helpers || exit 1
    run_pip "$@"
    ;;
  -r | reload)
    hyprshell_load_python_helpers || exit 1
    hyprreload
    ;;
  --release-notes | release-notes)
    get_release_notes
    ;;
  --version | version | -v)
    get_version
    ;;
  --help | help | -h)
    usage
    ;;
  "" | list)
    list_script_described
    ;;
  --list-script)
    list_script
    ;;
  --list-script-path)
    list_script_path
    ;;
  completions | --completions)
    shift
    hyprshell_load_completion_helpers || exit 1
    generate_completions "${1:-}"
    ;;
  pyinit)
    hyprshell_load_python_helpers || exit 1
    python_env_rebuild
    ;;
  resolve)
    shift
    resolve_command_target "${1:-}"
    exit $?
    ;;
  *)
    run_command "$@"
    ;;
esac
