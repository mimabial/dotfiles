#!/usr/bin/env bash
set -euo pipefail

TERMINAL_TUI="${TERMINAL_TUI:-kitty}"
HYPR_LIB_ROOT="${HYPR_LIB_DIR:-${LIB_DIR:-$HOME/.local/lib}/hypr}"

usage() {
  printf 'Usage: %s [--hypr-profile NAME] [--hypr-size WIDTH HEIGHT] [--hypr-cells COLUMNS ROWS] [--app-id ID] [--title TITLE] [--] [command [args...]]\n' "${0##*/}"
  printf 'WIDTH and HEIGHT each accept pixels (900), percent (55%%) or cells (40c).\n'
}

require_option_args() {
  local option_name="$1" required_argc="$2" available_argc="$3"

  ((available_argc >= required_argc)) && return 0
  printf 'Missing argument for %s\n' "${option_name}" >&2
  usage >&2
  exit 2
}

set_geometry_pair() {
  local -n geometry_options="$1"
  local option="$2" pair="$3" suffix="${4:-}"

  [[ "${pair}" == *,* && -n "${pair%%,*}" && -n "${pair#*,}" ]] || {
    printf 'Expected %s=WIDTH,HEIGHT\n' "${option}" >&2
    usage >&2
    exit 2
  }
  geometry_options[width]="${pair%%,*}${suffix}"
  geometry_options[height]="${pair#*,}${suffix}"
}

parse_args() {
  local -n parsed_options="$1" parsed_terminal_args="$2" parsed_command="$3"
  local decoded_separator=""
  shift 3
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --hypr-profile=*)
        parsed_options[profile]="${1#--hypr-profile=}"
        shift
        ;;
      --hypr-profile)
        require_option_args "$1" 2 "$#"
        parsed_options[profile]="$2"
        shift 2
        ;;
      --hypr-cells)
        require_option_args "$1" 3 "$#"
        parsed_options[width]="$2c"
        parsed_options[height]="$3c"
        shift 3
        ;;
      --hypr-cells=*)
        set_geometry_pair parsed_options --hypr-cells "${1#*=}" c
        shift
        ;;
      --hypr-size=*)
        set_geometry_pair parsed_options --hypr-size "${1#*=}"
        shift
        ;;
      --hypr-size)
        require_option_args "$1" 3 "$#"
        parsed_options[width]="$2"
        parsed_options[height]="$3"
        shift 3
        ;;
      --app-id=*)
        parsed_options[app_id]="${1#--app-id=}"
        shift
        ;;
      --app-id)
        require_option_args "$1" 2 "$#"
        parsed_options[app_id]="$2"
        shift 2
        ;;
      --title=*)
        parsed_options[title]="${1#--title=}"
        shift
        ;;
      --title)
        require_option_args "$1" 2 "$#"
        parsed_options[title]="$2"
        shift 2
        ;;
      --print-path)
        parsed_options[print_path]=1
        shift
        ;;
      --print-cmd)
        parsed_options[print_command]=1
        shift
        ;;
      --print-cmd=*)
        parsed_options[print_command]=1
        printf -v decoded_separator '%b' "${1#--print-cmd=}"
        parsed_options[separator]="${decoded_separator}"
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        parsed_command=("$@")
        break
        ;;
      -*)
        parsed_terminal_args+=("$1")
        shift
        ;;
      *)
        parsed_command=("$@")
        break
        ;;
    esac
  done
}

validate_geometry() {
  local -n geometry_options="$1"
  local value=""

  [[ -n "${geometry_options[width]}${geometry_options[height]}" ]] || return 0
  for value in "${geometry_options[width]}" "${geometry_options[height]}"; do
    [[ "${value}" =~ ^[1-9][0-9]*[c%]?$ ]] || {
      printf 'Expected a size in pixels (900), percent (55%%) or cells (40c): %s\n' "${value}" >&2
      return 1
    }
  done
  geometry_options[profile]=""
}

load_window_lib() {
  declare -F "$1" >/dev/null 2>&1 && return
  # shellcheck source=/dev/null
  source "${HYPR_LIB_ROOT}/launch/window.common.bash"
}

apply_geometry_profile() {
  local -n geometry_options="$1"
  local profile_name="" resolved_width="" resolved_height=""

  case "${geometry_options[profile]}" in
    "")
      return 0
      ;;
    tui) profile_name="standard" ;;
    dialog) profile_name="compact" ;;
    overlay | compact | standard | large) profile_name="${geometry_options[profile]}" ;;
    *)
      printf 'Unknown hypr profile: %s\n' "${geometry_options[profile]}" >&2
      return 1
      ;;
  esac

  load_window_lib launch_resolve_geometry_profile || return 1
  IFS=$'\t' read -r resolved_width resolved_height \
    <<<"$(launch_resolve_geometry_profile "${profile_name}")" || return 1
  geometry_options[width]="${resolved_width}"
  geometry_options[height]="${resolved_height}"
}

resolve_percentages() {
  local -n geometry_options="$1"
  [[ "${geometry_options[width]}" == *% || "${geometry_options[height]}" == *% ]] || return 0

  local mon_w mon_h ignored

  # Percentages use usable geometry, excluding reserved areas and edge gaps.
  load_window_lib launch_monitor_usable_geometry || return 1
  IFS=$'\t' read -r mon_w mon_h ignored ignored ignored ignored \
    <<<"$(launch_monitor_usable_geometry)" || return 1

  [[ "${mon_w}" =~ ^[0-9]+$ && "${mon_h}" =~ ^[0-9]+$ ]] || {
    printf 'Cannot determine usable monitor area for percentage geometry\n' >&2
    return 1
  }

  if [[ "${geometry_options[width]}" == *% ]]; then
    geometry_options[width]=$((${geometry_options[width]%\%} * mon_w / 100))
  fi
  if [[ "${geometry_options[height]}" == *% ]]; then
    geometry_options[height]=$((${geometry_options[height]%\%} * mon_h / 100))
  fi
}

validate_exec_command() {
  local -n command_ref="$1"
  ((${#command_ref[@]} > 0)) || return 0

  if [[ "${command_ref[0]}" == */* ]]; then
    [[ -x "${command_ref[0]}" ]] && return 0
  elif command -v "${command_ref[0]}" >/dev/null 2>&1; then
    return 0
  fi

  printf 'Command not found: %s\n' "${command_ref[0]}" >&2
  return 127
}

build_terminal_command() {
  local -n launch_options="$1" extra_terminal_args="$2" command_ref="$3" launch_ref="$4"
  local terminal_name="${TERMINAL_TUI##*/}"

  launch_ref=("${TERMINAL_TUI}" "${extra_terminal_args[@]}")

  case "${terminal_name}" in
    kitty)
      [[ -n "${launch_options[app_id]}" ]] && launch_ref+=("--app-id=${launch_options[app_id]}")
      [[ -n "${launch_options[title]}" ]] && launch_ref+=("--title=${launch_options[title]}")
      if [[ -n "${launch_options[width]}" && -n "${launch_options[height]}" ]]; then
        # Lua size rules are inert; kitty accepts pixels and per-axis cell suffixes.
        launch_ref+=(-o "remember_window_size=no" -o "initial_window_width=${launch_options[width]}" -o "initial_window_height=${launch_options[height]}")
      fi
      launch_ref+=("${command_ref[@]}")
      ;;
    alacritty)
      [[ -n "${launch_options[app_id]}" ]] && launch_ref+=(--class "${launch_options[app_id]}")
      [[ -n "${launch_options[title]}" ]] && launch_ref+=(--title "${launch_options[title]}")
      ((${#command_ref[@]} > 0)) && launch_ref+=(-e "${command_ref[@]}")
      ;;
    *)
      if [[ -n "${launch_options[app_id]}" || -n "${launch_options[title]}" ]]; then
        printf 'WARN: terminal backend %s does not support app-id/title metadata\n' "${terminal_name}" >&2
      fi
      launch_ref+=("${command_ref[@]}")
      ;;
  esac
}

terminal_desktop_path() {
  local terminal_name="${TERMINAL_TUI##*/}"
  local candidate="" app_dir=""
  local -a app_dirs=(
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    "/usr/local/share/applications"
    "/usr/share/applications"
  )

  for candidate in \
    "${terminal_name}.desktop" \
    "org.${terminal_name}.${terminal_name}.desktop" \
    "org.${terminal_name}.desktop"; do
    for app_dir in "${app_dirs[@]}"; do
      [[ -f "${app_dir}/${candidate}" ]] || continue
      printf '%s\n' "${app_dir}/${candidate}"
      return 0
    done
  done

  return 1
}

print_terminal_target() {
  local -n print_options="$1" launch_ref="$2"
  local desktop_path="" joined_command=""

  if [[ "${print_options[print_path]}" -eq 1 ]]; then
    desktop_path="$(terminal_desktop_path)" || return 1
    printf '%s' "${desktop_path}"
  fi

  if [[ "${print_options[print_command]}" -eq 1 ]]; then
    ((print_options[print_path] == 1)) && printf '\n'
    if ((${#launch_ref[@]} > 0)); then
      printf -v joined_command "%s${print_options[separator]}" "${launch_ref[@]}"
      printf '%s' "${joined_command%"${print_options[separator]}"}"
    fi
  fi
}

terminate_child() {
  kill -TERM "$1" 2>/dev/null || true
}

main() {
  local -A options=([profile]="" [width]="" [height]="" [app_id]="" [title]="" \
    [print_path]=0 [print_command]=0 [separator]=$'\037')
  local -a terminal_args=() command=() launch_command=()
  local terminal_pid exit_code=0

  parse_args options terminal_args command "$@"
  validate_geometry options || return 2
  apply_geometry_profile options || return 2
  resolve_percentages options || return 2

  if ((options[print_path] == 1 || options[print_command] == 1)); then
    ((options[print_command] == 0)) || build_terminal_command options terminal_args command launch_command
    print_terminal_target options launch_command
    return $?
  fi

  validate_exec_command command || return $?
  build_terminal_command options terminal_args command launch_command

  "${launch_command[@]}" &
  terminal_pid=$!

  trap 'terminate_child "${terminal_pid}"' INT TERM HUP
  wait "${terminal_pid}" || exit_code=$?

  return "${exit_code}"
}

main "$@"
