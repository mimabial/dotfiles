#!/usr/bin/env bash
set -euo pipefail

TERMINAL_TUI="${TERMINAL_TUI:-kitty}"
HYPR_LIB_ROOT="${HYPR_LIB_DIR:-${LIB_DIR:-$HOME/.local/lib}/hypr}"
hypr_profile=""
hypr_width=""
hypr_height=""
app_id=""
title=""
print_executable_path=0
print_command=0
print_command_separator=$'\037'
cmd=()
terminal_args=()
terminal_launch=()

usage() {
  printf 'Usage: %s [--hypr-profile NAME] [--hypr-size WIDTH HEIGHT] [--hypr-cells COLUMNS ROWS] [--app-id ID] [--title TITLE] [--] [command [args...]]\n' "${0##*/}"
  printf 'WIDTH and HEIGHT each accept pixels (900), percent (55%%) or cells (40c).\n'
}

require_option_args() {
  local option_name="$1" required_argc="$2" available_argc="$3"

  ((available_argc >= required_argc)) && return 0
  printf 'Missing argument for %s\n' "${option_name}" >&2
  usage >&2
  exit 2
}

set_geometry_pair() {
  local option="$1" pair="$2" suffix="${3:-}"

  [[ "${pair}" == *,* && -n "${pair%%,*}" && -n "${pair#*,}" ]] || {
    printf 'Expected %s=WIDTH,HEIGHT\n' "${option}" >&2
    usage >&2
    exit 2
  }
  hypr_width="${pair%%,*}${suffix}"
  hypr_height="${pair#*,}${suffix}"
}

parse_args() {
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --hypr-profile=*)
        hypr_profile="${1#--hypr-profile=}"
        shift
        ;;
      --hypr-profile)
        require_option_args "$1" 2 "$#"
        hypr_profile="$2"
        shift 2
        ;;
      --hypr-cells)
        require_option_args "$1" 3 "$#"
        hypr_width="$2c"
        hypr_height="$3c"
        shift 3
        ;;
      --hypr-cells=*)
        set_geometry_pair --hypr-cells "${1#*=}" c
        shift
        ;;
      --hypr-size=*)
        set_geometry_pair --hypr-size "${1#*=}"
        shift
        ;;
      --hypr-size)
        require_option_args "$1" 3 "$#"
        hypr_width="$2"
        hypr_height="$3"
        shift 3
        ;;
      --app-id=*)
        app_id="${1#--app-id=}"
        shift
        ;;
      --app-id)
        require_option_args "$1" 2 "$#"
        app_id="$2"
        shift 2
        ;;
      --title=*)
        title="${1#--title=}"
        shift
        ;;
      --title)
        require_option_args "$1" 2 "$#"
        title="$2"
        shift 2
        ;;
      --print-path)
        print_executable_path=1
        shift
        ;;
      --print-cmd)
        print_command=1
        shift
        ;;
      --print-cmd=*)
        print_command=1
        print_command_separator="$(printf '%b' "${1#--print-cmd=}")"
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        cmd=("$@")
        break
        ;;
      -*)
        terminal_args+=("$1")
        shift
        ;;
      *)
        cmd=("$@")
        break
        ;;
    esac
  done
}

validate_geometry() {
  local value=""

  [[ -n "${hypr_width}${hypr_height}" ]] || return 0
  for value in "${hypr_width}" "${hypr_height}"; do
    [[ "${value}" =~ ^[1-9][0-9]*[c%]?$ ]] || {
      printf 'Expected a size in pixels (900), percent (55%%) or cells (40c): %s\n' "${value}" >&2
      return 1
    }
  done
  hypr_profile=""
}

load_window_lib() {
  declare -F "$1" >/dev/null 2>&1 && return
  # shellcheck source=/dev/null
  source "${HYPR_LIB_ROOT}/launch/window.common.bash"
}

apply_geometry_profile() {
  local profile_name=""

  case "${hypr_profile}" in
    "")
      return 0
      ;;
    tui) profile_name="standard" ;;
    dialog) profile_name="compact" ;;
    overlay | compact | standard | large) profile_name="${hypr_profile}" ;;
    *)
      printf 'Unknown hypr profile: %s\n' "${hypr_profile}" >&2
      return 1
      ;;
  esac

  load_window_lib launch_resolve_geometry_profile || return 1
  IFS=$'\t' read -r hypr_width hypr_height \
    <<<"$(launch_resolve_geometry_profile "${profile_name}")" || return 1
}

resolve_percentages() {
  [[ "${hypr_width}" == *% || "${hypr_height}" == *% ]] || return 0

  local mon_w mon_h ignored

  # Percentages use usable geometry, excluding reserved areas and edge gaps.
  load_window_lib launch_monitor_usable_geometry || return 1
  IFS=$'\t' read -r mon_w mon_h ignored ignored ignored ignored \
    <<<"$(launch_monitor_usable_geometry)" || return 1

  [[ "${mon_w}" =~ ^[0-9]+$ && "${mon_h}" =~ ^[0-9]+$ ]] || {
    printf 'Cannot determine usable monitor area for percentage geometry\n' >&2
    return 1
  }

  if [[ "${hypr_width}" == *% ]]; then
    hypr_width=$((${hypr_width%\%} * mon_w / 100))
  fi
  if [[ "${hypr_height}" == *% ]]; then
    hypr_height=$((${hypr_height%\%} * mon_h / 100))
  fi
}

validate_exec_command() {
  ((${#cmd[@]} > 0)) || return 0

  if [[ "${cmd[0]}" == */* ]]; then
    [[ -x "${cmd[0]}" ]] && return 0
  elif command -v "${cmd[0]}" >/dev/null 2>&1; then
    return 0
  fi

  printf 'Command not found: %s\n' "${cmd[0]}" >&2
  return 127
}

build_terminal_command() {
  local terminal_name="${TERMINAL_TUI##*/}"

  terminal_launch=("${TERMINAL_TUI}" "${terminal_args[@]}")

  case "${terminal_name}" in
    kitty)
      [[ -n "${app_id}" ]] && terminal_launch+=("--app-id=${app_id}")
      [[ -n "${title}" ]] && terminal_launch+=("--title=${title}")
      if [[ -n "${hypr_width}" && -n "${hypr_height}" ]]; then
        # Lua size rules are inert; kitty accepts pixels and per-axis cell suffixes.
        terminal_launch+=(-o "remember_window_size=no" -o "initial_window_width=${hypr_width}" -o "initial_window_height=${hypr_height}")
      fi
      terminal_launch+=("${cmd[@]}")
      ;;
    alacritty)
      [[ -n "${app_id}" ]] && terminal_launch+=(--class "${app_id}")
      [[ -n "${title}" ]] && terminal_launch+=(--title "${title}")
      ((${#cmd[@]} > 0)) && terminal_launch+=(-e "${cmd[@]}")
      ;;
    *)
      if [[ -n "${app_id}" || -n "${title}" ]]; then
        printf 'WARN: terminal backend %s does not support app-id/title metadata\n' "${terminal_name}" >&2
      fi
      terminal_launch+=("${cmd[@]}")
      ;;
  esac
}

terminal_desktop_path() {
  local terminal_name="${TERMINAL_TUI##*/}"
  local candidate="" app_dir=""
  local -a app_dirs=(
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    "/usr/local/share/applications"
    "/usr/share/applications"
  )

  for candidate in \
    "${terminal_name}.desktop" \
    "org.${terminal_name}.${terminal_name}.desktop" \
    "org.${terminal_name}.desktop"; do
    for app_dir in "${app_dirs[@]}"; do
      [[ -f "${app_dir}/${candidate}" ]] || continue
      printf '%s\n' "${app_dir}/${candidate}"
      return 0
    done
  done

  return 1
}

print_terminal_target() {
  local desktop_path=""
  local joined_command=""

  ((print_command == 0)) || build_terminal_command

  if [[ "${print_executable_path}" -eq 1 ]]; then
    desktop_path="$(terminal_desktop_path)" || return 1
    printf '%s' "${desktop_path}"
  fi

  if [[ "${print_command}" -eq 1 ]]; then
    ((print_executable_path == 1)) && printf '\n'
    if ((${#terminal_launch[@]} > 0)); then
      printf -v joined_command "%s${print_command_separator}" "${terminal_launch[@]}"
      printf '%s' "${joined_command%"${print_command_separator}"}"
    fi
  fi
}

terminate_child() {
  kill -TERM "${terminal_pid}" 2>/dev/null || true
}

main() {
  local exit_code=0

  parse_args "$@"
  validate_geometry || return 2
  apply_geometry_profile || return 2
  resolve_percentages || return 2

  if [[ "${print_executable_path}" -eq 1 || "${print_command}" -eq 1 ]]; then
    print_terminal_target
    return $?
  fi

  validate_exec_command || return $?
  build_terminal_command

  "${terminal_launch[@]}" &
  terminal_pid=$!

  trap terminate_child INT TERM HUP
  wait "${terminal_pid}" || exit_code=$?

  return "${exit_code}"
}

main "$@"
