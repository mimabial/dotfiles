#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
source "${HOME}/.local/bin/.common.bash"

PREVIEW_TITLE="${PREVIEW_AI_TITLE:-ai-preview}"
SPLIT_PERCENT="${PREVIEW_AI_SPLIT_PERCENT:-45}"
POPUP_WIDTH="${PREVIEW_AI_POPUP_WIDTH:-80%}"
POPUP_HEIGHT="${PREVIEW_AI_POPUP_HEIGHT:-80%}"
PREVIEW_BIN="${PREVIEW_BIN:-$HOME/.local/bin/preview}"

usage() {
  cat <<'EOF'
Usage:
  preview-ai [--float] [--auto-close-after SECONDS] [--interactive] [TYPE] CONTENT...

Types:
  auto      detect from content or file path
  file      preview an existing path
  image     preview an existing image path
  json      preview inline JSON or a JSON file
  markdown  preview inline markdown or a markdown file
  text      preview inline text or a file
  diff      show repo diff in a separate tmux pane or popup
  codediff  open repo diff in read-only nvim
  log       show repo log
  cmd       run a shell command (prefix content with cmd: or use TYPE cmd)
EOF
}

shell_join() {
  local out=""
  local arg

  for arg in "$@"; do
    printf -v out '%s%q ' "${out}" "${arg}"
  done

  printf '%s\n' "${out% }"
}

current_window_target() {
  tmux display-message -p -t "$1" '#{session_name}:#{window_index}'
}

current_pane_path() {
  tmux display-message -p -t "$1" '#{pane_current_path}'
}

find_preview_pane() {
  tmux list-panes -t "$(current_window_target "$1")" -F "#{pane_id}\t#{pane_title}" 2>/dev/null \
    | awk -F '\t' -v title="${PREVIEW_TITLE}" '$2 == title { print $1; exit }'
}

cleanup_preview_pane() {
  local caller_pane="$1" pane_id="${2:-}"
  [[ -n "${pane_id}" && "${pane_id}" != "${caller_pane}" ]] || return 0
  tmux kill-pane -t "${pane_id}" >/dev/null 2>&1 || true
}

detect_type() {
  local input="${1:-}"
  local expanded=""
  local base_path=""

  case "${input}" in
    cmd:*) printf 'cmd\n' ;;
    "")
      printf 'text\n'
      ;;
    *)
      expanded="$(expand_path "${input}")"
      if [[ -e "${expanded}" || -L "${expanded}" ]]; then
        printf 'file\n'
      elif [[ "${expanded}" =~ ^(.+):([0-9]+)(:([0-9]+))?$ ]]; then
        base_path="${BASH_REMATCH[1]}"
        if [[ -e "${base_path}" || -L "${base_path}" ]]; then
          printf 'file\n'
          return 0
        fi
      elif [[ "${input}" == \{* || "${input}" == \[* ]]; then
        printf 'json\n'
      elif [[ "${input}" == \#* || "${input}" == $'---'* ]]; then
        printf 'markdown\n'
      else
        printf 'text\n'
      fi
      ;;
  esac
}

repo_kind() {
  local start_dir="$1"
  if have jj && (cd "${start_dir}" && jj root >/dev/null 2>&1); then
    printf 'jj\n'
    return 0
  fi

  if have git && (cd "${start_dir}" && git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
    printf 'git\n'
    return 0
  fi

  printf 'none\n'
}

payload_path() {
  printf '%s/payload.%s\n' "$1" "$2"
}

preview_existing_path() {
  shell_join "${PREVIEW_BIN}" "$1"
}

preview_inline_content() {
  local runtime_dir="$1" suffix="$2"
  shift 2
  local path=""

  path="$(payload_path "${runtime_dir}" "${suffix}")"
  printf '%s\n' "$*" > "${path}"
  preview_existing_path "${path}"
}

build_diff_command() {
  local mode="$1" start_dir="$2" runtime_dir="$3"
  shift 3
  local repo joined_args diff_file=""

  repo="$(repo_kind "${start_dir}")"
  [[ "${repo}" != "none" ]] || die "preview-ai diff requires a git or jj repo"
  joined_args="$(shell_join "$@")"

  case "${repo}:${mode}" in
    jj:interactive)
      diff_file="${runtime_dir}/diff.patch"
      printf "cd %s && env PAGER=cat jj diff %s > %s && nvim -R '+setlocal ft=diff nomodifiable' %s\n" \
        "$(shell_join "${start_dir}")" "${joined_args}" "$(shell_join "${diff_file}")" "$(shell_join "${diff_file}")"
      ;;
    jj:plain)
      printf 'cd %s && env PAGER=cat jj diff %s\n' "$(shell_join "${start_dir}")" "${joined_args}"
      ;;
    git:interactive)
      diff_file="${runtime_dir}/diff.patch"
      printf "cd %s && git --no-pager diff --no-ext-diff %s > %s && nvim -R '+setlocal ft=diff nomodifiable' %s\n" \
        "$(shell_join "${start_dir}")" "${joined_args}" "$(shell_join "${diff_file}")" "$(shell_join "${diff_file}")"
      ;;
    git:plain)
      printf 'cd %s && git --no-pager diff --color=always --no-ext-diff %s\n' "$(shell_join "${start_dir}")" "${joined_args}"
      ;;
  esac
}

build_log_command() {
  local start_dir="$1" repo joined_args
  shift

  repo="$(repo_kind "${start_dir}")"
  [[ "${repo}" != "none" ]] || die "preview-ai log requires a git or jj repo"
  joined_args="$(shell_join "$@")"

  case "${repo}" in
    jj) printf 'cd %s && env PAGER=cat jj log %s\n' "$(shell_join "${start_dir}")" "${joined_args}" ;;
    git) printf 'cd %s && git --no-pager log --decorate --graph --oneline %s\n' "$(shell_join "${start_dir}")" "${joined_args}" ;;
  esac
}

build_command() {
  local -n command_result="$1" interactive_result="$2"
  local type="$3" force_interactive="$4" start_dir="$5" runtime_dir="$6"
  shift 6
  local expanded suffix

  command_result=""
  interactive_result="${force_interactive}"

  case "${type}" in
    file|image)
      [[ $# -ge 1 ]] || die "missing path"
      command_result="$(preview_existing_path "$(expand_path "$1")")"
      ;;
    json|markdown|text)
      if [[ $# -eq 1 ]]; then
        expanded="$(expand_path "$1")"
        if [[ -e "${expanded}" || -L "${expanded}" ]]; then
          command_result="$(preview_existing_path "${expanded}")"
          return 0
        fi
      fi
      case "${type}" in json) suffix=json ;; markdown) suffix=md ;; text) suffix=txt ;; esac
      command_result="$(preview_inline_content "${runtime_dir}" "${suffix}" "$@")"
      ;;
    diff)
      command_result="$(build_diff_command plain "${start_dir}" "${runtime_dir}" "$@")"
      ;;
    codediff)
      interactive_result=1
      command_result="$(build_diff_command interactive "${start_dir}" "${runtime_dir}" "$@")"
      ;;
    log)
      command_result="$(build_log_command "${start_dir}" "$@")"
      ;;
    cmd)
      [[ $# -ge 1 ]] || die "missing command"
      if [[ "${1}" == cmd:* ]]; then
        command_result="${1#cmd:}"
        shift
        if [[ $# -gt 0 ]]; then
          command_result+=" $(shell_join "$@")"
        fi
      else
        command_result="$*"
      fi
      ;;
    *)
      die "unknown type: ${type}"
      ;;
  esac
}

create_runner() {
  local command="$1" interactive="$2" runtime_dir="$3" auto_close_after="$4"
  local runner="${runtime_dir}/run" runtime_dir_q=""

  printf -v runtime_dir_q '%q' "${runtime_dir}"

  cat > "${runner}" <<EOF
#!/usr/bin/env bash
set -uo pipefail
trap "rm -rf -- ${runtime_dir_q}" EXIT
set +e
${command}
status=\$?
set -e
if [[ ${interactive} -eq 0 ]]; then
  echo
  if [[ -n "${auto_close_after}" ]]; then
    printf '[Closing in %ss. Press any key to keep open]' "${auto_close_after}"
    if read -r -t "${auto_close_after}" -n 1 </dev/tty 2>/dev/null; then
      echo
      printf '[Press any key to close]'
      read -r -n 1 </dev/tty || true
    fi
  else
    printf '[Press any key to close]'
    read -r -n 1 </dev/tty || true
  fi
fi
exit "\$status"
EOF

  chmod +x "${runner}"
  printf '%s\n' "${runner}"
}

create_preview_target() {
  local runner="$1" caller_pane="$2" start_dir="$3" use_popup="$4" existing

  existing="$(find_preview_pane "${caller_pane}" || true)"
  cleanup_preview_pane "${caller_pane}" "${existing}"

  if (( use_popup )); then
    tmux display-popup \
      -E \
      -T "${PREVIEW_TITLE}" \
      -d "${start_dir}" \
      -w "${POPUP_WIDTH}" \
      -h "${POPUP_HEIGHT}" \
      "${runner}"
    return 0
  fi

  local new_pane=""
  new_pane="$(tmux split-window -h -p "${SPLIT_PERCENT}" -t "${caller_pane}" -c "${start_dir}" -PF '#{pane_id}' "${runner}")"
  tmux select-pane -t "${new_pane}" -T "${PREVIEW_TITLE}"
  tmux select-pane -t "${caller_pane}"
}

main() {
  local type="auto" use_popup=0 force_interactive=0 auto_close_after=""
  local caller_pane start_dir runtime_dir command runner interactive

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --float|--popup)
        use_popup=1
        shift
        ;;
      --interactive)
        force_interactive=1
        shift
        ;;
      --auto-close-after)
        auto_close_after="${2:-}"
        [[ "${auto_close_after}" =~ ^[0-9]+$ ]] || die "auto-close must be an integer"
        shift 2
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  [[ -n "${TMUX:-}" ]] || die "preview-ai must run inside tmux"
  [[ -x "${PREVIEW_BIN}" ]] || die "missing preview script: ${PREVIEW_BIN}"
  [[ $# -gt 0 ]] || die "missing content"

  caller_pane="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}"
  start_dir="$(current_pane_path "${caller_pane}")"
  runtime_dir="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/preview-ai.XXXXXX")"

  type="${1:-auto}"
  shift || true

  if [[ "${type}" == "auto" ]]; then
    type="$(detect_type "${1:-}")"
  elif [[ ! "${type}" =~ ^(file|image|json|markdown|text|diff|codediff|log|cmd)$ ]]; then
    set -- "${type}" "$@"
    type="$(detect_type "${type}")"
  fi

  build_command command interactive "${type}" "${force_interactive}" "${start_dir}" "${runtime_dir}" "$@"
  runner="$(create_runner "${command}" "${interactive}" "${runtime_dir}" "${auto_close_after}")"
  create_preview_target "${runner}" "${caller_pane}" "${start_dir}" "${use_popup}"
}

main "$@"
