#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  hypr-theme apply <pack-name>      # theme mode
  hypr-theme wallpaper <path>       # wallpaper mode

Flags:
  --regen      force re-render even if input hash matches
  --no-cache   don't write cache after rendering (next run also re-renders)
  --variant dark|light
USAGE
}

usage_error() {
  usage >&2
  exit 2
}

subcommand="${1:-}"
[[ -n "${subcommand}" ]] || usage_error
shift
[[ "$subcommand" == --help || "$subcommand" == -h ]] && { usage; exit 0; }

positional=()
variant="${HYPR_COLOR_VARIANT:-dark}"
while (($#)); do
  case "$1" in
    --regen)    export HYPR_FORCE_REGEN=1 ;;
    --no-cache) export HYPR_NO_CACHE=1 ;;
    --variant)
      shift
      [[ "${1:-}" =~ ^(dark|light)$ ]] || { echo "hypr-theme: --variant requires dark|light" >&2; exit 2; }
      variant="$1"
      ;;
    --help|-h)  usage; exit 0 ;;
    --)         shift; positional+=("$@"); break ;;
    -*)         echo "hypr-theme: unknown flag: $1" >&2; exit 2 ;;
    *)          positional+=("$1") ;;
  esac
  shift
done

# shellcheck source=/dev/null
source "${HYPR_LIB_DIR:-$HOME/.local/lib/hypr}/runtime/init.bash" || exit 1
hypr_runtime_require state || exit 1

RENDER_DIR="${HYPR_LIB_DIR}/render"
PALETTE="${HYPR_STATE_HOME}/active-palette.json"

hypr_lock_path_into COLOR_GEN_LOCK color_gen
exec {COLOR_GEN_LOCK_FD}>"${COLOR_GEN_LOCK}"
flock "${COLOR_GEN_LOCK_FD}"

wallpaper_superseded() {
  [[ ! "${WALLPAPER_CACHE_DIR}/current/wall.set" -ef "$1" ]]
}

if [[ "${subcommand}" == "wallpaper" && "${HYPR_THEME_REQUIRE_CURRENT_WALLPAPER:-0}" == 1 ]] \
  && wallpaper_superseded "${positional[0]:-}"; then
  exit 0
fi

prepare_palette() {
  local mode="$1" target="$2" wallpaper_variant="$3"
  case "${mode}" in
    apply)
      [[ -n "${target}" ]] || { echo "hypr-theme apply: pack name required" >&2; exit 2; }
      python3 "${RENDER_DIR}/_palette.py" --theme "${target}" --out "${PALETTE}"
      ;;
    wallpaper)
      [[ -n "${target}" ]] || { echo "hypr-theme wallpaper: image path required" >&2; exit 2; }
      python3 "${RENDER_DIR}/_palette.py" --wallpaper "${target}" --variant "${wallpaper_variant}" --out "${PALETTE}"
      ;;
  esac
}

run_renderers() {
  local -a renderers=()
  local renderer name
  local LC_COLLATE=C
  for renderer in "${RENDER_DIR}"/*; do
    [[ -f "${renderer}" && ! -L "${renderer}" && -x "${renderer}" && "${renderer##*/}" != _* ]] || continue
    [[ "${renderer}" == *.sh || "${renderer}" == *.py ]] && renderers+=("${renderer}")
  done
  ((${#renderers[@]})) || { echo "hypr-theme: no renderers in ${RENDER_DIR}" >&2; return 0; }

  local -a pids=() names=()
  local -i failed=0
  for renderer in "${renderers[@]}"; do
    name="${renderer##*/}"
    name="${name%.*}"
    "$renderer" "${PALETTE}" &
    pids+=($!)
    names+=("$name")
  done
  local i
  for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
      echo "hypr-theme: ${names[$i]} failed" >&2
      [[ -z "${HYPR_THEME_RENDER_FAILURES:-}" ]] || printf '%s\n' "${names[$i]}" >>"${HYPR_THEME_RENDER_FAILURES}"
      ((++failed))
    fi
  done
  return "${failed}"
}

reload_compositor_config_and_published_vars() {
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl reload config-only >/dev/null 2>&1 || true
}

set_desktop_color_scheme() {
  local palette_text=""
  IFS= read -r -d '' palette_text <"${PALETTE}" || true
  [[ "${palette_text}" =~ \"color_variant\":[[:space:]]*\"(dark|light)\" ]] && command -v gsettings >/dev/null 2>&1 || return 0
  gsettings set org.gnome.desktop.interface color-scheme "prefer-${BASH_REMATCH[1]}" >/dev/null 2>&1 || true
}

reload_clients() {
  local client=""
  source "${HYPR_LIB_DIR}/theme/lib/clients.reload.bash"
  set_desktop_color_scheme &
  for client in kitty alacritty cava zathura rmpc tmux; do
    reload_live_theme_client "${client}" &
  done
  [[ ! -x "${HYPR_LIB_DIR}/util/nvim-theme-sync.sh" ]] || "${HYPR_LIB_DIR}/util/nvim-theme-sync.sh" >/dev/null 2>&1 &
  wait
}

case "${subcommand}" in
  apply|wallpaper)
    prepare_palette "${subcommand}" "${positional[0]:-}" "${variant}"
    if [[ "${subcommand}" == apply ]]; then
      state_set "HYPR_THEME" "${positional[0]}" "staterc"
    fi
    render_failed=0
    run_renderers || render_failed=1
    reload_compositor_config_and_published_vars
    [[ "${HYPR_THEME_DEFER_CLIENTS:-0}" == 1 ]] || reload_clients
    exit "${render_failed}"
    ;;
  *)
    usage_error
    ;;
esac
