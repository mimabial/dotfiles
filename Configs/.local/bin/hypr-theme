#!/usr/bin/env bash

set -euo pipefail

RENDER_DIR="${HYPR_LIB_DIR:-${LIB_DIR:-$HOME/.local/lib}/hypr}/render"
PALETTE="${HYPR_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/hypr}/active-palette.json"

usage() {
  cat <<'USAGE'
Usage:
  hypr-theme apply <pack-name>      # theme mode
  hypr-theme wallpaper <path>       # wallpaper mode
  hypr-theme refresh                # re-run renderers on the current palette

Flags:
  --regen      force re-render even if input hash matches
  --no-cache   don't write cache after rendering (next run also re-renders)
  --variant dark|light
USAGE
}

usage_error() {
  usage >&2
  exit 2
}

subcommand="${1:-}"
[[ -n "${subcommand}" ]] || usage_error
shift
[[ "$subcommand" == --help || "$subcommand" == -h ]] && { usage; exit 0; }

positional=()
variant="${HYPR_COLOR_VARIANT:-dark}"
while (($#)); do
  case "$1" in
    --regen)    export HYPR_FORCE_REGEN=1 ;;
    --no-cache) export HYPR_NO_CACHE=1 ;;
    --variant)
      shift
      [[ "${1:-}" =~ ^(dark|light)$ ]] || { echo "hypr-theme: --variant requires dark|light" >&2; exit 2; }
      variant="$1"
      ;;
    --help|-h)  usage; exit 0 ;;
    --)         shift; positional+=("$@"); break ;;
    -*)         echo "hypr-theme: unknown flag: $1" >&2; exit 2 ;;
    *)          positional+=("$1") ;;
  esac
  shift
done

# shellcheck source=/dev/null
source "${HYPR_LIB_DIR:-$HOME/.local/lib/hypr}/runtime/init.bash" || exit 1
hypr_runtime_require state || exit 1

COLOR_GEN_LOCK="$(hypr_lock_path color_gen)"
exec {COLOR_GEN_LOCK_FD}>"${COLOR_GEN_LOCK}"
flock "${COLOR_GEN_LOCK_FD}"

if [[ "${subcommand}" == "wallpaper" && "${HYPR_THEME_REQUIRE_CURRENT_WALLPAPER:-0}" == 1 ]]; then
  current_wall="${XDG_CACHE_HOME:-$HOME/.cache}/hypr/wallpaper/current/wall.set"
  target_wall="${positional[0]:-}"
  [[ -e "${current_wall}" && -e "${target_wall}" ]] || exit 0
  [[ "$(readlink -f -- "${current_wall}")" == "$(readlink -f -- "${target_wall}")" ]] || exit 0
fi

prepare_palette() {
  local subcommand="$1"
  local target="${2:-}"
  case "${subcommand}" in
    apply)
      [[ -n "${target}" ]] || { echo "hypr-theme apply: pack name required" >&2; exit 2; }
      python3 "${RENDER_DIR}/_palette.py" --theme "${target}" --out "${PALETTE}"
      ;;
    wallpaper)
      [[ -n "${target}" ]] || { echo "hypr-theme wallpaper: image path required" >&2; exit 2; }
      python3 "${RENDER_DIR}/_palette.py" --wallpaper "${target}" --variant "${variant}" --out "${PALETTE}"
      ;;
    refresh)
      [[ -f "${PALETTE}" ]] || { echo "hypr-theme refresh: no palette at ${PALETTE}" >&2; exit 1; }
      ;;
  esac
}

run_renderers() {
  local -a renderers=()
  local renderer name
  local LC_COLLATE=C
  for renderer in "${RENDER_DIR}"/*; do
    [[ -f "${renderer}" && ! -L "${renderer}" && -x "${renderer}" && "${renderer##*/}" != _* ]] || continue
    [[ "${renderer}" == *.sh || "${renderer}" == *.py ]] && renderers+=("${renderer}")
  done
  ((${#renderers[@]})) || { echo "hypr-theme: no renderers in ${RENDER_DIR}" >&2; return 0; }

  local -a pids=() names=()
  local -i failed=0
  for renderer in "${renderers[@]}"; do
    name="${renderer##*/}"
    name="${name%.*}"
    "$renderer" "${PALETTE}" &
    pids+=($!)
    names+=("$name")
  done
  local i
  for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
      echo "hypr-theme: ${names[$i]} failed" >&2
      ((++failed))
    fi
  done
  return "${failed}"
}

reload_clients() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload config-only >/dev/null 2>&1 || true
  fi
  [[ "${HYPR_THEME_DEFER_CLIENTS:-0}" == 1 ]] && return
  source "${HYPR_LIB_DIR:-$HOME/.local/lib/hypr}/theme/color.apply.sh"

  local background=""
  background="$(jq -r '.background // empty' "${PALETTE}" 2>/dev/null || true)"

  if [[ "${background}" =~ ^(dark|light)$ ]] && command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme "prefer-${background}" >/dev/null 2>&1 || true
  fi

  reload_live_theme_client kitty
  reload_live_theme_client alacritty
  reload_live_theme_client rmpc
  reload_live_theme_client tmux

  # FileView re-arms across the renderers' mv, so the palette lands on its own;
  # this only re-reads the font sources, which a soft reload would miss.
  if command -v quickshell >/dev/null 2>&1; then
    quickshell ipc --any-display call bar refresh >/dev/null 2>&1 || true
  fi

  if [[ -x "$HOME/.local/lib/hypr/util/nvim-theme-sync.sh" ]]; then
    "$HOME/.local/lib/hypr/util/nvim-theme-sync.sh" >/dev/null 2>&1 || true
  fi
}

case "${subcommand}" in
  apply|wallpaper|refresh)
    prepare_palette "${subcommand}" "${positional[0]:-}"
    if [[ "${subcommand}" == apply ]]; then
      state_set "HYPR_THEME" "${positional[0]}" "staterc"
    fi
    if [[ "${subcommand}" == refresh ]]; then
      render_change_dir="$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/hypr-theme.XXXXXX")"
      export HYPR_THEME_CHANGED_FILE="${render_change_dir}/rendered"
      trap 'rm -rf -- "${render_change_dir}"' EXIT
    fi
    render_failed=0
    run_renderers || render_failed=1
    if [[ "${subcommand}" != refresh || -e "${HYPR_THEME_CHANGED_FILE:-}" || "${render_failed}" -ne 0 ]]; then
      reload_clients
    fi
    exit "${render_failed}"
    ;;
  *)
    usage_error
    ;;
esac
