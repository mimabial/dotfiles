#!/usr/bin/env python3
"""Monitor profile daemon for Hyprland."""
import sys
from pathlib import Path

if sys.argv[1:] in (["-h"], ["--help"]):
    print("Usage: hyprmoncfgd\nRun the monitor profile daemon in the foreground.")
    raise SystemExit(0)

SYSTEM_LIB_DIR = Path(__file__).resolve().parent.parent / "lib/hypr/system"
sys.path.insert(0, str(SYSTEM_LIB_DIR))

from moncfg.daemon import main

if __name__ == "__main__":
    raise SystemExit(main())
