#!/usr/bin/env bash
set -euo pipefail

[[ "${1:-}" == -h || "${1:-}" == --help ]] && { printf 'Usage: %s\nWrite explicitly installed packages to ~/installed_packages.txt.\n' "${0##*/}"; exit; }

output_file="${HOME}/installed_packages.txt"

{
  if command -v pacman >/dev/null 2>&1; then
    printf '# Pacman packages (explicit, native)\n'
    pacman -Qenq
    printf '\n# AUR packages (explicit, foreign)\n'
    pacman -Qemq
  fi

  printf '\n# Flatpak packages\n'
  if command -v flatpak >/dev/null 2>&1; then
    flatpak list --app --columns=application
  fi
} >"${output_file}"
