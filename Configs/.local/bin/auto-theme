#!/usr/bin/env bash
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
HYPR_LIB_DIR="${HYPR_LIB_DIR:-$HOME/.local/lib/hypr}"
DAEMON_SCRIPT="${HYPR_LIB_DIR}/theme/auto_theme.py"
AUTO_THEME_SERVICE="auto-theme"

resolve_auto_theme_python() {
  local venv_python="${XDG_STATE_HOME}/hypr/pip_env/bin/python"

  if [[ -x "${venv_python}" ]]; then
    printf '%s\n' "${venv_python}"
    return 0
  fi

  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return 0
  fi

  printf 'auto-theme: no Python found. Run `hyprshell pyinit` to bootstrap %s.\n' "${venv_python}" >&2
  return 1
}

usage() {
  cat <<'EOF'
Auto-theme control script

Usage: auto-theme <command>

Commands:
  start    - Start the daemon
  stop     - Stop the daemon
  restart  - Restart the daemon
  enable   - Enable daemon at login
  disable  - Disable daemon at login
  status   - Show daemon status and current mode
  toggle   - Manually toggle light/dark (with override timer)
  refresh  - Force refresh (clear manual override)
  once     - Run single check without daemon
  config   - Edit configuration file
EOF
}

run_daemon() {
  local python
  python="$(resolve_auto_theme_python)"
  "$python" "$DAEMON_SCRIPT" "$@"
}

load_service_api() {
  declare -F hypr_svc_user >/dev/null 2>&1 && return
  # shellcheck source=/dev/null
  source "${HYPR_LIB_DIR}/runtime/init.bash"
}

service_call() {
  load_service_api
  hypr_svc_user "$1" "${AUTO_THEME_SERVICE}"
}

signal_daemon_or_run_once() {
  local signal="$1" run_once_flag="$2" action="$3"

  load_service_api
  if hypr_svc_user is-active "${AUTO_THEME_SERVICE}"; then
    hypr_svc_user_signal "${AUTO_THEME_SERVICE}" "${signal}"
    printf '%s signal sent to daemon\n' "${action^}"
  else
    printf 'Daemon not running, applying %s once...\n' "${action}"
    run_daemon "${run_once_flag}"
  fi
}

main() {
  case "${1:-}" in
    start | stop | restart | enable | disable)
      service_call "$1"
      ;;
    status)
      service_call status || true
      printf '\n'
      run_daemon --status
      ;;
    toggle)
      signal_daemon_or_run_once USR1 --toggle toggle
      ;;
    refresh)
      signal_daemon_or_run_once USR2 --once refresh
      ;;
    once)
      run_daemon --once
      ;;
    config)
      "${EDITOR:-nvim}" "${XDG_CONFIG_HOME}/hypr/auto_theme.conf"
      ;;
    -h | --help)
      usage
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
