#!/usr/bin/env bash
# Sync configuration files to dotfiles directory
# Usage: dotfiles-sync [--dry-run|--list] [--manifest <file>]

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles/Configs}"
SYNC_MODE="apply"
HOST_PROFILE_STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/host-profile"
DEFAULT_SYNC_MANIFEST_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/dotfiles-sync.conf"
if [[ -n "${DOTFILES_SYNC_MANIFEST:-}" ]]; then
  SYNC_MANIFEST_SOURCE="${DOTFILES_SYNC_MANIFEST}"
  PRUNE_HOST_ORPHANS=false
else
  SYNC_MANIFEST_SOURCE="${DEFAULT_SYNC_MANIFEST_FILE}"
  PRUNE_HOST_ORPHANS=true
fi
SYNC_MANIFEST_FILE=""
SYNC_MANIFEST_TEMP_FILE=""
ACTIVE_HOST_PROFILE=""
declare -a SYNC_MANIFEST_RECORDS=()

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options]
Options:
  --dry-run   Preview actual sync changes without writing
  --list      List configured sync mappings only
  --manifest  Use a specific manifest file (disables host orphan pruning)
  -h, --help  Show this help
USAGE
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) SYNC_MODE="dry-run" ;;
      --list) SYNC_MODE="list" ;;
      --manifest)
        [[ $# -ge 2 ]] || { echo "--manifest requires a file path" >&2; usage >&2; exit 1; }
        SYNC_MANIFEST_SOURCE="$2"
        PRUNE_HOST_ORPHANS=false
        shift
        ;;
      -h | --help) usage; exit 0 ;;
      *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
  done
}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { printf '%b[INFO]%b %s\n' "${BLUE}" "${NC}" "$1"; }
log_success() { printf '%b[OK]%b %s\n' "${GREEN}" "${NC}" "$1"; }
log_warn() { printf '%b[WARN]%b %s\n' "${YELLOW}" "${NC}" "$1"; }
log_error() { printf '%b[ERROR]%b %s\n' "${RED}" "${NC}" "$1"; }

cleanup_temp_manifest() {
  [[ -n "${SYNC_MANIFEST_TEMP_FILE}" ]] || return 0
  rm -f -- "${SYNC_MANIFEST_TEMP_FILE}"
}

trap cleanup_temp_manifest EXIT

path_is_within_root() {
  local path="$1"
  local root="$2"

  [[ "${path}" == "${root}" || "${path}" == "${root}/"* ]]
}

relative_path_from() {
  local base_dir="$1"
  local target_path="$2"

  realpath -m --relative-to="${base_dir}" "${target_path}"
}

normalize_synced_symlink() {
  local src_root="$1"
  local dest_root="$2"
  local dest_link="$3"
  local link_target=""
  local mapped_target=""
  local relative_target=""

  [[ -L "${dest_link}" ]] || return 0
  link_target="$(readlink -- "${dest_link}")" || return 1
  [[ "${link_target}" == /* ]] || return 0
  path_is_within_root "${link_target}" "${src_root}" || return 0

  mapped_target="${dest_root}${link_target#"${src_root}"}"
  relative_target="$(relative_path_from "$(dirname -- "${dest_link}")" "${mapped_target}")"
  ln -snf -- "${relative_target}" "${dest_link}"
}

normalize_synced_internal_symlinks() {
  local src_root="$1"
  local dest_root="$2"
  local path=""

  if [[ -L "${dest_root}" ]]; then
    normalize_synced_symlink "${src_root}" "${dest_root}" "${dest_root}"
    return
  fi

  [[ -d "${dest_root}" ]] || return 0

  while IFS= read -r -d '' path; do
    normalize_synced_symlink "${src_root}" "${dest_root}" "${path}"
  done < <(find "${dest_root}" -type l -print0)

  return 0
}

normalize_changed_symlinks_from_rsync_output() {
  local src_root="$1"
  local dest_root="$2"
  local rsync_output="$3"
  local line=""
  local rel_path=""

  [[ -d "${dest_root}" ]] || return 0

  while IFS= read -r line; do
    [[ "${line}" == *" -> "* ]] || continue
    [[ "${line}" =~ ^.[L] ]] || continue
    rel_path="${line#* }"
    rel_path="${rel_path%% -> *}"
    normalize_synced_symlink "${src_root}" "${dest_root}" "${dest_root%/}/${rel_path}"
  done <<< "${rsync_output}"

  return 0
}

emit_preview_result() {
  local name="$1"
  local output="$2"

  log_info "Preview $name"
  if [[ -n "$output" ]]; then
    printf '%s\n' "$output"
  else
    echo "No changes."
  fi
}

emit_apply_result() {
  local name="$1"
  local output="$2"

  if [[ -n "$output" ]]; then
    log_success "Updated $name"
  else
    log_info "Unchanged $name"
  fi
}

run_rsync_transfer() {
  local name="$1"
  local log_failures="${2:-true}"
  local output_var="${3:-}"
  shift 3
  local output=""
  local -a rsync_args=("$@")

  if [[ "${SYNC_MODE}" == "dry-run" ]]; then
    rsync_args+=(--dry-run --itemize-changes)
    if ! output=$(rsync "${rsync_args[@]}" 2>&1); then
      if [[ "${log_failures}" == true ]]; then
        log_error "Preview failed for $name"
        printf '%s\n' "$output" >&2
      fi
      return 1
    fi
    emit_preview_result "$name" "$output"
    return 0
  fi

  rsync_args+=(--itemize-changes)
  if ! output=$(rsync "${rsync_args[@]}" 2>&1); then
    if [[ "${log_failures}" == true ]]; then
      log_error "Sync failed for $name"
      printf '%s\n' "$output" >&2
    fi
    return 1
  fi

  if [[ -n "${output_var}" ]]; then
    printf -v "${output_var}" '%s' "$output"
  else
    emit_apply_result "$name" "$output"
  fi
}

require_rsync() {
  if ! command -v rsync &>/dev/null; then
    log_error "rsync is required (cp fallback removed). Install rsync and rerun."
    exit 1
  fi
}

require_sync_manifest() {
  if [[ -r "${SYNC_MANIFEST_SOURCE}" ]]; then
    SYNC_MANIFEST_FILE="${SYNC_MANIFEST_SOURCE}"
    return 0
  fi

  if [[ "${SYNC_MANIFEST_SOURCE}" == *$'\n'* || "${SYNC_MANIFEST_SOURCE}" =~ ^[[:space:]]*(#|dir\||file\||host\|) ]]; then
    SYNC_MANIFEST_TEMP_FILE="$(mktemp "${TMPDIR:-/tmp}/dotfiles-sync.manifest.XXXXXX")" || {
      log_error "Failed to create temporary manifest"
      exit 1
    }
    printf '%s\n' "${SYNC_MANIFEST_SOURCE}" > "${SYNC_MANIFEST_TEMP_FILE}"
    SYNC_MANIFEST_FILE="${SYNC_MANIFEST_TEMP_FILE}"
    return 0
  fi

  log_error "Sync manifest not found: ${SYNC_MANIFEST_SOURCE}"
  exit 1
}

load_sync_manifest() {
  local kind=""
  local rel_path=""
  local excludes=""
  local extra=""

  SYNC_MANIFEST_RECORDS=()
  while IFS='|' read -r kind rel_path excludes extra; do
    [[ -n "${kind}${rel_path}${excludes}${extra}" ]] || continue
    [[ "${kind}" == \#* ]] && continue
    [[ -z "${extra}" ]] || {
      log_error "Invalid manifest entry: ${kind}|${rel_path}|${excludes}|${extra}"
      exit 1
    }
    [[ -n "${rel_path}" ]] || {
      log_error "Invalid manifest entry: ${kind}|${rel_path}|${excludes}"
      exit 1
    }
    case "${rel_path}" in
      /* | *$'\n'* | *$'\r'*)
        log_error "Manifest path must be relative and single-line: ${rel_path}"
        exit 1
        ;;
      ..|../*|*/../*|*/..)
        log_error "Manifest path must not contain '..' segments: ${rel_path}"
        exit 1
        ;;
    esac

    case "${kind}" in
      dir | file | host)
        SYNC_MANIFEST_RECORDS+=("${kind}|${rel_path}|${excludes}")
        ;;
      *)
        log_error "Unknown manifest kind: ${kind}"
        exit 1
        ;;
    esac
  done < "${SYNC_MANIFEST_FILE}"
}

host_profile_is_valid() {
  local profile="${1:-}"
  [[ -n "${profile}" && "${profile}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

get_host_profile() {
  local profile=""

  if [[ -f "${HOST_PROFILE_STATE_FILE}" ]]; then
    read -r profile <"${HOST_PROFILE_STATE_FILE}" || true
  fi

  if [[ -n "${profile}" ]] && ! host_profile_is_valid "${profile}"; then
    log_warn "Ignoring invalid host profile in ${HOST_PROFILE_STATE_FILE}: ${profile}"
    return 1
  fi

  [[ -n "${profile}" ]] || return 1
  printf '%s\n' "${profile}"
}

remove_path() {
  local dest="$1"
  local name="$2"
  local rel_dest="${dest#"${DOTFILES_DIR}"/}"

  if [[ "${SYNC_MODE}" == "list" ]]; then
    echo "PLAN ABSENT ${dest}"
    return
  fi

  if [[ ! -e "${dest}" && ! -L "${dest}" ]]; then
    return
  fi

  if [[ "${SYNC_MODE}" == "dry-run" ]]; then
    emit_preview_result "${name}" "*deleting   ${rel_dest}"
    return
  fi

  rm -rf -- "${dest}"
  log_success "Removed ${name}"
}

purge_orphaned_host_files() {
  local host_root="$1"
  shift
  local hosts_root="${DOTFILES_DIR}/hosts"
  local host_entry=""
  local rel_path=""
  local host_dir=""
  local -A managed_paths=()

  path_is_within_root "${host_root}" "${hosts_root}" && [[ "${host_root}" != "${hosts_root}" ]] || {
    log_error "Refusing to prune invalid host root: ${host_root}"
    return 1
  }
  [[ ! -L "${host_root}" ]] || {
    log_error "Refusing to prune symlinked host root: ${host_root}"
    return 1
  }
  [[ -d "${host_root}" ]] || return 0

  for rel_path in "$@"; do
    managed_paths["${rel_path}"]=1
  done

  while IFS= read -r -d '' host_entry; do
    rel_path="${host_entry#"${host_root}/"}"
    [[ -z "${managed_paths["${rel_path}"]+managed}" ]] || continue

    if [[ "${SYNC_MODE}" == "list" ]]; then
      printf 'PLAN ABSENT %s\n' "${host_entry}"
    elif [[ "${SYNC_MODE}" == "dry-run" ]]; then
      emit_preview_result "orphaned host file ${rel_path}" \
        "*deleting   ${host_entry#"${DOTFILES_DIR}/"}"
    else
      rm -f -- "${host_entry}"
      log_success "Removed orphaned host file ${rel_path}"
    fi
  done < <(find -P "${host_root}" -mindepth 1 ! -type d -print0)

  if [[ "${SYNC_MODE}" == "apply" ]]; then
    while IFS= read -r -d '' host_dir; do
      rmdir -- "${host_dir}" 2>/dev/null || true
    done < <(find -P "${host_root}" -depth -mindepth 1 -type d -empty -print0)
  fi
}

sync_host_profile_files() {
  local profile="${ACTIVE_HOST_PROFILE}"
  local host_root=""
  local kind=""
  local rel_path=""
  local excludes=""
  local record=""
  local -a host_paths=()

  if [[ -n "${profile}" ]]; then
    host_root="${DOTFILES_DIR}/hosts/${profile}"
  else
    log_warn "No host profile selected; managed host-specific files will not be saved. Use dotfiles-host-profile set <profile>."
  fi

  for record in "${SYNC_MANIFEST_RECORDS[@]}"; do
    IFS='|' read -r kind rel_path excludes <<< "${record}"
    [[ "${kind}" == "host" ]] || continue
    host_paths+=("${rel_path}")
  done

  if [[ -z "${host_root}" ]]; then
    return
  fi

  for rel_path in "${host_paths[@]}"; do
    remove_path "${DOTFILES_DIR}/${rel_path}" "root host file ${rel_path}"
  done

  case "${SYNC_MODE}" in
    list) log_info "Planning host profile mappings (${profile})..." ;;
    dry-run) log_info "Previewing host profile '${profile}'..." ;;
    apply) log_info "Syncing host profile '${profile}'..." ;;
  esac

  for rel_path in "${host_paths[@]}"; do
    copy_path file "${HOME}/${rel_path}" "${host_root}/${rel_path}" "hosts/${profile}/${rel_path}"
  done

  if $PRUNE_HOST_ORPHANS; then
    purge_orphaned_host_files "${host_root}" "${host_paths[@]}"
  else
    log_info "Skipping host orphan pruning for alternate manifest"
  fi
}

create_dirs() {
  local dirs=(
    "$DOTFILES_DIR/.config"
    "$DOTFILES_DIR/.local/bin"
    "$DOTFILES_DIR/.local/lib"
    "$DOTFILES_DIR/.local/share"
    "$DOTFILES_DIR/hosts"
  )

  for dir in "${dirs[@]}"; do
    if [[ "${SYNC_MODE}" == "list" ]]; then
      echo "PLAN DIR    $dir"
    elif [[ "${SYNC_MODE}" == "dry-run" ]]; then
      echo "Would create: $dir"
    else
      mkdir -p "$dir"
    fi
  done
}

plan_copy_path() {
  local kind="$1" src="$2" dest="$3"
  shift 3
  local exclude_preview=""

  if [[ "${kind}" == "dir" ]] && (($#)); then
    exclude_preview="$(printf '%s, ' "$@")"
    printf 'PLAN DIR    %s -> %s (exclude: %s)\n' "$src" "$dest" "${exclude_preview%, }"
  else
    printf 'PLAN %-6s %s -> %s\n' "${kind^^}" "$src" "$dest"
  fi
}

sync_directory_path() {
  local src="$1" dest="$2" name="$3" exclude_pattern transfer_output=""
  shift 3
  local -a rsync_args=(-a --mkpath --delete --delete-excluded \
    --exclude='.git' --exclude='__pycache__' --exclude='.ruff_cache' --exclude='*.pyc' \
    --exclude='node_modules' --exclude='.cache' --exclude='lazy-lock.json')

  for exclude_pattern in "$@"; do
    rsync_args+=(--exclude="${exclude_pattern}")
  done
  run_rsync_transfer "$name" true transfer_output "${rsync_args[@]}" "$src"/ "$dest"/
  [[ "${SYNC_MODE}" == "dry-run" ]] && return
  normalize_changed_symlinks_from_rsync_output "$src" "$dest" "$transfer_output"
  emit_apply_result "$name" "$transfer_output"
}

remove_stale_destination() {
  local src="$1" dest="$2" name="$3"

  if [[ ! -e "$dest" && ! -L "$dest" ]]; then
    log_warn "Skipping $name (not found: $src)"
  elif [[ "${SYNC_MODE}" == "dry-run" ]]; then
    emit_preview_result "$name" "*deleting   $(basename "$dest")"
  else
    rm -rf -- "$dest"
    log_success "Removed stale $name"
  fi
}

sync_file_path() {
  local src="$1" dest="$2" name="$3" transfer_output=""

  if [[ -d "$dest" && ! -L "$dest" ]]; then
    if [[ "${SYNC_MODE}" == "dry-run" ]]; then
      emit_preview_result "$name" $'*deleting   '"$(basename "$dest")"$'\n>f+++++++++ '"$(basename "$dest")"
      return
    fi
    rm -rf -- "$dest"
  fi

  run_rsync_transfer "$name" false transfer_output -a --mkpath "$src" "$dest" || return
  [[ "${SYNC_MODE}" == "dry-run" ]] && return
  normalize_synced_internal_symlinks "$src" "$dest"
  emit_apply_result "$name" "$transfer_output"
}

copy_path() {
  local kind="$1" src="$2" dest="$3" name="$4"
  shift 4

  if [[ "${SYNC_MODE}" == "list" ]]; then
    plan_copy_path "$kind" "$src" "$dest" "$@"
    return
  fi
  if [[ "$kind" == "dir" ]]; then
    [[ -e "$src" ]] || { log_warn "Skipping $name (not found: $src)"; return; }
    if [[ -d "$src" ]]; then
      sync_directory_path "$src" "$dest" "$name" "$@"
      return
    fi
  fi
  if [[ ! -e "$src" && ! -L "$src" ]]; then
    remove_stale_destination "$src" "$dest" "$name"
    return
  fi
  sync_file_path "$src" "$dest" "$name"
}

sync_manifest_mappings() {
  local section="${1:-all}"
  local kind=""
  local rel_path=""
  local excludes=""
  local record=""
  local -a extra_excludes=()

  for record in "${SYNC_MANIFEST_RECORDS[@]}"; do
    IFS='|' read -r kind rel_path excludes <<< "${record}"
    case "${section}" in
      config)
        [[ "${rel_path}" == .local/* ]] && continue
        ;;
      local)
        [[ "${rel_path}" == .local/* ]] || continue
        ;;
    esac

    extra_excludes=()
    if [[ -n "${excludes}" ]]; then
      IFS=',' read -r -a extra_excludes <<< "${excludes}"
    fi

    case "${kind}" in
      dir)
        copy_path dir "${HOME}/${rel_path}" "${DOTFILES_DIR}/${rel_path}" "${rel_path}" "${extra_excludes[@]}"
        ;;
      file)
        copy_path file "${HOME}/${rel_path}" "${DOTFILES_DIR}/${rel_path}" "${rel_path}"
        ;;
      host)
        ;;
    esac
  done
}

sync_manifest_section() {
  local section="$1" label="${HOME}/$2"
  case "${SYNC_MODE}" in
    list) log_info "Planning ${label} mappings..." ;;
    dry-run) log_info "Previewing ${label}..." ;;
    apply) log_info "Syncing ${label}..." ;;
  esac
  sync_manifest_mappings "${section}"
}

main() {
  parse_args "$@"
  printf '=========================================\n  Dotfiles Sync\n=========================================\nTarget: %s\n' "$DOTFILES_DIR"
  if ACTIVE_HOST_PROFILE="$(get_host_profile)"; then
    echo "Host profile: ${ACTIVE_HOST_PROFILE}"
  else
    ACTIVE_HOST_PROFILE=""
    echo "Host profile: (not set)"
  fi
  case "${SYNC_MODE}" in
    dry-run) echo "(DRY RUN - no changes will be made)" ;;
    list) echo "(LIST MODE - plan only, no checks or filesystem writes)" ;;
  esac
  echo

  [[ "${SYNC_MODE}" == "list" ]] || require_rsync
  require_sync_manifest
  load_sync_manifest

  case "${SYNC_MODE}" in
    list) log_info "Planning directory structure..." ;;
    dry-run) log_info "Previewing directory structure..." ;;
    apply) log_info "Creating directory structure..." ;;
  esac
  create_dirs
  echo
  sync_manifest_section config '.config'
  sync_host_profile_files
  echo
  sync_manifest_section local '.local'

  printf '\n=========================================\n'
  case "${SYNC_MODE}" in
    list) echo "List complete." ;;
    dry-run) echo "Dry run complete. Run without --dry-run to apply." ;;
    apply) log_success "Dotfiles sync complete!"; echo "Location: $DOTFILES_DIR" ;;
  esac
  echo "========================================="
}

main "$@"
