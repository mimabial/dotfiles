#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=/dev/null
source "${HYPR_LIB_DIR:-$HOME/.local/lib/hypr}/system/dotfiles.lib.bash"

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles/Configs}"
RESTORE_ONLY_HOST_DIR=".system"
SYNC_MODE="apply"
ACTIVE_HOST_PROFILE=""
declare -a SYNC_MANIFEST_RECORDS=()

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options]
Options:
  --dry-run   Preview actual sync changes without writing
  --list      List configured sync mappings only
  -h, --help  Show this help
USAGE
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) SYNC_MODE="dry-run" ;;
      --list) SYNC_MODE="list" ;;
      -h | --help) usage; exit 0 ;;
      *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
    shift
  done
}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { printf '%b[INFO]%b %s\n' "${BLUE}" "${NC}" "$1"; }
log_success() { printf '%b[OK]%b %s\n' "${GREEN}" "${NC}" "$1"; }
log_warn() { printf '%b[WARN]%b %s\n' "${YELLOW}" "${NC}" "$1"; }
log_error() { printf '%b[ERROR]%b %s\n' "${RED}" "${NC}" "$1"; }

path_is_within_root() {
  local path="$1"
  local root="$2"

  [[ "${path}" == "${root}" || "${path}" == "${root}/"* ]]
}

relative_path_from() {
  local base_dir="$1"
  local target_path="$2"

  realpath -m --relative-to="${base_dir}" "${target_path}"
}

normalize_synced_symlink() {
  local src_root="$1"
  local dest_root="$2"
  local dest_link="$3"
  local link_target=""
  local mapped_target=""
  local relative_target=""

  [[ -L "${dest_link}" ]] || return 0
  link_target="$(readlink -- "${dest_link}")" || return 1
  [[ "${link_target}" == /* ]] || return 0
  path_is_within_root "${link_target}" "${src_root}" || return 0

  mapped_target="${dest_root}${link_target#"${src_root}"}"
  relative_target="$(relative_path_from "$(dirname -- "${dest_link}")" "${mapped_target}")"
  ln -snf -- "${relative_target}" "${dest_link}"
}

is_itemized_symlink() {
  [[ "$1" =~ ^.L && "$1" == *" -> "* ]]
}

normalize_changed_symlinks_from_rsync_output() {
  local src_root="$1"
  local dest_root="$2"
  local rsync_output="$3"
  local line=""
  local rel_path=""

  [[ -d "${dest_root}" ]] || return 0

  while IFS= read -r line; do
    is_itemized_symlink "${line}" || continue
    rel_path="${line#* }"
    rel_path="${rel_path%% -> *}"
    normalize_synced_symlink "${src_root}" "${dest_root}" "${dest_root%/}/${rel_path}"
  done <<< "${rsync_output}"

  return 0
}

emit_preview_result() {
  local name="$1"
  local output="$2"

  log_info "Preview $name"
  if [[ -n "$output" ]]; then
    printf '%s\n' "$output"
  else
    echo "No changes."
  fi
}

emit_apply_result() {
  local name="$1"
  local output="$2"

  if [[ -n "$output" ]]; then
    log_success "Updated $name"
  else
    log_info "Unchanged $name"
  fi
}

run_rsync_transfer() {
  local -n transfer_output_ref="$1"
  local name="$2" action="Sync"
  shift 2
  local -a rsync_args=("$@")

  if [[ "${SYNC_MODE}" == "dry-run" ]]; then
    rsync_args+=(--dry-run)
    action="Preview"
  fi

  rsync_args+=(--itemize-changes)
  if ! transfer_output_ref=$(rsync "${rsync_args[@]}" 2>&1); then
    log_error "${action} failed for $name" >&2
    printf '%s\n' "$transfer_output_ref" >&2
    return 1
  fi
}

require_rsync() {
  if ! command -v rsync &>/dev/null; then
    log_error "rsync is required. Install rsync and rerun."
    exit 1
  fi
}

get_host_profile() {
  local profile=""

  if [[ -f "${HOST_PROFILE_STATE_FILE}" ]]; then
    read -r profile <"${HOST_PROFILE_STATE_FILE}" || true
  fi

  if [[ -n "${profile}" ]] && ! host_profile_is_valid "${profile}"; then
    log_warn "Ignoring invalid host profile in ${HOST_PROFILE_STATE_FILE}: ${profile}"
    return 1
  fi

  [[ -n "${profile}" ]] || return 1
  printf '%s\n' "${profile}"
}

remove_managed_path() {
  local dest="$1"
  local name="$2"
  local rel_dest="${dest#"${DOTFILES_DIR}"/}"

  if [[ "${SYNC_MODE}" == "list" ]]; then
    echo "PLAN ABSENT ${dest}"
    return
  fi

  if [[ ! -e "${dest}" && ! -L "${dest}" ]]; then
    return
  fi

  if [[ "${SYNC_MODE}" == "dry-run" ]]; then
    emit_preview_result "${name}" "*deleting   ${rel_dest}"
    return
  fi

  rm -rf -- "${dest}"
  log_success "Removed ${name}"
}

purge_orphaned_host_files() {
  local host_root="$1"
  shift
  local hosts_root="${DOTFILES_DIR}/hosts"
  local host_entry=""
  local rel_path=""
  local host_dir=""
  local -A managed_paths=()

  path_is_within_root "${host_root}" "${hosts_root}" && [[ "${host_root}" != "${hosts_root}" ]] || {
    log_error "Refusing to prune invalid host root: ${host_root}"
    return 1
  }
  [[ ! -L "${host_root}" ]] || {
    log_error "Refusing to prune symlinked host root: ${host_root}"
    return 1
  }
  [[ -d "${host_root}" ]] || return 0

  for rel_path in "$@"; do
    managed_paths["${rel_path}"]=1
  done

  while IFS= read -r -d '' host_entry; do
    rel_path="${host_entry#"${host_root}/"}"
    [[ -z "${managed_paths["${rel_path}"]+managed}" ]] || continue

    if [[ "${SYNC_MODE}" == "list" ]]; then
      printf 'PLAN ABSENT %s\n' "${host_entry}"
    elif [[ "${SYNC_MODE}" == "dry-run" ]]; then
      emit_preview_result "orphaned host file ${rel_path}" \
        "*deleting   ${host_entry#"${DOTFILES_DIR}/"}"
    else
      rm -f -- "${host_entry}"
      log_success "Removed orphaned host file ${rel_path}"
    fi
  done < <(find -P "${host_root}" -mindepth 1 -path "${host_root}/${RESTORE_ONLY_HOST_DIR}" -prune -o ! -type d -print0)

  if [[ "${SYNC_MODE}" == "apply" ]]; then
    while IFS= read -r -d '' host_dir; do
      rmdir -- "${host_dir}" 2>/dev/null || true
    done < <(find -P "${host_root}" -depth -mindepth 1 -type d -empty -print0)
  fi
}

sync_host_profile_files() {
  local profile="${ACTIVE_HOST_PROFILE}"
  local host_root=""
  local rel_path=""
  local -a host_paths=()

  if [[ -n "${profile}" ]]; then
    host_root="${DOTFILES_DIR}/hosts/${profile}"
  else
    log_warn "No host profile selected; managed host-specific files will not be saved. Use dotfiles-host-profile set <profile>."
  fi

  manifest_host_paths SYNC_MANIFEST_RECORDS host_paths

  if [[ -z "${host_root}" ]]; then
    return
  fi

  for rel_path in "${host_paths[@]}"; do
    remove_managed_path "${DOTFILES_DIR}/${rel_path}" "root host file ${rel_path}"
  done

  case "${SYNC_MODE}" in
    list) log_info "Planning host profile mappings (${profile})..." ;;
    dry-run) log_info "Previewing host profile '${profile}'..." ;;
    apply) log_info "Syncing host profile '${profile}'..." ;;
  esac

  for rel_path in "${host_paths[@]}"; do
    sync_mapped_path file "${HOME}/${rel_path}" "${host_root}/${rel_path}" "hosts/${profile}/${rel_path}"
  done

  purge_orphaned_host_files "${host_root}" "${host_paths[@]}"
}

plan_copy_path() {
  local kind="$1" src="$2" dest="$3"
  shift 3
  local exclude_preview=""

  if [[ "${kind}" == "dir" ]] && (($#)); then
    exclude_preview="$(printf '%s, ' "$@")"
    printf 'PLAN DIR    %s -> %s (exclude: %s)\n' "$src" "$dest" "${exclude_preview%, }"
  else
    printf 'PLAN %-6s %s -> %s\n' "${kind^^}" "$src" "$dest"
  fi
}

sync_directory_path() {
  local src="$1" dest="$2" name="$3" exclude_pattern transfer_output=""
  shift 3
  local -a rsync_args=(-a --mkpath --delete --delete-excluded \
    --exclude='.git' --exclude='__pycache__' --exclude='.ruff_cache' --exclude='.pytest_cache' --exclude='*.pyc' \
    --exclude='node_modules' --exclude='.cache' --exclude='lazy-lock.json')

  for exclude_pattern in "$@"; do
    rsync_args+=(--exclude="${exclude_pattern}")
  done
  run_rsync_transfer transfer_output "$name" "${rsync_args[@]}" "$src"/ "$dest"/ || return
  if [[ "${SYNC_MODE}" == "dry-run" ]]; then
    emit_preview_result "$name" "$transfer_output"
    return
  fi
  normalize_changed_symlinks_from_rsync_output "$src" "$dest" "$transfer_output"
  emit_apply_result "$name" "$transfer_output"
}

remove_stale_destination() {
  local src="$1" dest="$2" name="$3"

  if [[ ! -e "$dest" && ! -L "$dest" ]]; then
    log_warn "Skipping $name (not found: $src)"
  elif [[ "${SYNC_MODE}" == "dry-run" ]]; then
    emit_preview_result "$name" "*deleting   $(basename "$dest")"
  else
    rm -rf -- "$dest"
    log_success "Removed stale $name"
  fi
}

sync_file_path() {
  local src="$1" dest="$2" name="$3" transfer_output=""

  if [[ -d "$dest" && ! -L "$dest" ]]; then
    if [[ "${SYNC_MODE}" == "dry-run" ]]; then
      emit_preview_result "$name" $'*deleting   '"$(basename "$dest")"$'\n>f+++++++++ '"$(basename "$dest")"
      return
    fi
    rm -rf -- "$dest"
  fi

  run_rsync_transfer transfer_output "$name" -a --mkpath "$src" "$dest" || return
  if [[ "${SYNC_MODE}" == "dry-run" ]]; then
    emit_preview_result "$name" "$transfer_output"
    return
  fi
  emit_apply_result "$name" "$transfer_output"
}

sync_mapped_path() {
  local kind="$1" src="$2" dest="$3" name="$4"
  shift 4

  if [[ "${SYNC_MODE}" == "list" ]]; then
    plan_copy_path "$kind" "$src" "$dest" "$@"
    return
  fi
  if [[ "$kind" == "dir" ]]; then
    [[ -e "$src" ]] || { log_warn "Skipping $name (not found: $src)"; return; }
    if [[ -d "$src" ]]; then
      sync_directory_path "$src" "$dest" "$name" "$@"
      return
    fi
  fi
  if [[ ! -e "$src" && ! -L "$src" ]]; then
    remove_stale_destination "$src" "$dest" "$name"
    return
  fi
  sync_file_path "$src" "$dest" "$name"
}

sync_manifest_mappings() {
  local section="$1"
  local kind=""
  local rel_path=""
  local excludes=""
  local record=""
  local -a extra_excludes=()

  for record in "${SYNC_MANIFEST_RECORDS[@]}"; do
    IFS='|' read -r kind rel_path excludes <<< "${record}"
    case "${section}" in
      home)
        [[ "${rel_path}" == .local/* ]] && continue
        ;;
      local)
        [[ "${rel_path}" == .local/* ]] || continue
        ;;
    esac

    extra_excludes=()
    if [[ -n "${excludes}" ]]; then
      IFS=',' read -r -a extra_excludes <<< "${excludes}"
    fi

    case "${kind}" in
      dir)
        sync_mapped_path dir "${HOME}/${rel_path}" "${DOTFILES_DIR}/${rel_path}" "${rel_path}" "${extra_excludes[@]}"
        ;;
      file)
        sync_mapped_path file "${HOME}/${rel_path}" "${DOTFILES_DIR}/${rel_path}" "${rel_path}"
        ;;
      host)
        ;;
    esac
  done
}

sync_manifest_section() {
  local section="$1" label="$2"
  case "${SYNC_MODE}" in
    list) log_info "Planning ${label} mappings..." ;;
    dry-run) log_info "Previewing ${label}..." ;;
    apply) log_info "Syncing ${label}..." ;;
  esac
  sync_manifest_mappings "${section}"
}

main() {
  parse_args "$@"
  printf '=========================================\n  Dotfiles Sync\n=========================================\nTarget: %s\n' "$DOTFILES_DIR"
  if ACTIVE_HOST_PROFILE="$(get_host_profile)"; then
    echo "Host profile: ${ACTIVE_HOST_PROFILE}"
  else
    ACTIVE_HOST_PROFILE=""
    echo "Host profile: (not set)"
  fi
  case "${SYNC_MODE}" in
    dry-run) echo "(DRY RUN - no changes will be made)" ;;
    list) echo "(LIST MODE - plan only, no checks or filesystem writes)" ;;
  esac
  echo

  [[ "${SYNC_MODE}" == "list" ]] || require_rsync
  read_sync_manifest SYNC_MANIFEST_RECORDS || exit 1

  sync_manifest_section home "${HOME} (outside .local)"
  sync_host_profile_files
  echo
  sync_manifest_section local "${HOME}/.local"

  printf '\n=========================================\n'
  case "${SYNC_MODE}" in
    list) echo "List complete." ;;
    dry-run) echo "Dry run complete. Run without --dry-run to apply." ;;
    apply) log_success "Dotfiles sync complete!"; echo "Location: $DOTFILES_DIR" ;;
  esac
  echo "========================================="
}

main "$@"
