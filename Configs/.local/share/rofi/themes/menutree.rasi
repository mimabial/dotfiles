@import "~/.config/rofi/colors.rasi"
@import "shared/header.rasi"

* {
    /* rofi/menu/dialog.bash overrides element-border-radius per launch */
    element-border-radius:       8px;
    window-border-radius:        @element-border-radius;
    menu-padding:                @popup-padding;
    menu-icon-padding:           @control-padding;
    menu-list-margin:            @section-margin;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       400px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               @window-border-radius;
    border-color:                @border;
    background-color:            var(background-alpha);
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    /* The gap to the listview lives on the listview (see below), not here: a
       box emits its spacing even for a child of zero height, so a listview
       hidden by require-input would leave the gap behind and push the input
       row off centre. Identical layout once the listview has rows. */
    spacing:                     0px;
    margin:                      0px;
    padding:                     @menu-padding;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "message" ];
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;

    spacing:                     @row-gap;
    margin:                      @menu-list-margin;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

scrollbar {
    handle-rounded-corners:      true;
}

element {
    enabled:                     true;
    spacing:                     @control-gap;
    margin:                      0px;
    padding:                     @control-padding;
    border:                      0px solid;
    border-radius:               @element-border-radius;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected-background;
    text-color:                  @selected-foreground;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element-icon {
    enabled:                     false;
    size:                        0px;
    background-color:            transparent;
}

message {
    enabled:                     true;
    margin:                      @section-margin;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @separator;
}

textbox {
    padding:                     @control-padding-y;
    border:                      0px solid;
    border-radius:               @element-border-radius;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

error-message {
    padding:                     @popup-padding;
    border:                      2px solid;
    border-radius:               @window-border-radius;
    border-color:                @border;
    background-color:            @background-alpha;
    text-color:                  @foreground;
}
