/**
 * Omarchy Menu Theme
 *
 * Clean dmenu theme for omarchy system menus
 * Uses pywal16-generated colors and system fonts
 **/

/*****----- Global Properties -----*****/
@import "~/.config/rofi/colors.rasi"

* {
    /* Border settings - dynamically set from omarchy-launch-rofi */
    element-border-radius:       8px;
    window-border-radius:        12px;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       295px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               @window-border-radius;
    border-color:                @border;
    background-color:            var(background-alpha);
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    /* The gap to the listview lives on the listview (see below), not here: a
       box emits its spacing even for a child of zero height, so a listview
       hidden by require-input would leave the gap behind and push the input
       row off centre. Identical layout once the listview has rows. */
    spacing:                     0px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "message" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "entry", "textbox-prompt-colon" ];
}

entry {
    enabled:                     true;
    padding:                     8px;
    border-radius:               @element-border-radius;
    background-color:            transparent;
    text-color:                  @foreground;
    placeholder:                 "";
    placeholder-color:           @active;
}

textbox-prompt-colon {
    border:                      1px;
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     8px 12px;
    text-color:                  @separator;
    border-radius:               @element-border-radius;
    background-color:            @background-alpha;
    border-color:            @accent;
}

prompt {
    enabled:                     true;
    padding:                     8px;
    border-radius:               @element-border-radius;
    background-color:            transparent;
    text-color:                  @foreground;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;

    spacing:                     5px;
    margin:                      20px 0px 0px 0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

scrollbar {
    handle-width:                4px;
    handle-color:                @separator;
    handle-rounded-corners:      false;
    background-color:            @background;
    border-color:                @border;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px solid;
    border-radius:               @element-border-radius;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected-background;
    text-color:                  @selected-foreground;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element-icon {
    enabled:                     false;
    size:                        0px;
    background-color:            transparent;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      12px 0px 0px 0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @separator;
}

textbox {
    padding:                     6px;
    border:                      0px solid;
    border-radius:               @element-border-radius;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

error-message {
    padding:                     12px;
    border:                      2px solid;
    border-radius:               @window-border-radius;
    border-color:                @border;
    background-color:            @background;
    text-color:                  @foreground;
}
