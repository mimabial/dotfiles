@import "~/.config/rofi/colors.rasi"

* {
    /* rofi/menu.engine.bash overrides element-border-radius per launch */
    element-border-radius:       8px;
    window-border-radius:        12px;
    menu-padding:                20px;
    menu-spacing:                10px;
    menu-icon-padding:           10px 12px;
    menu-list-margin:            10px 0px 0px 0px;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       400px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               @window-border-radius;
    border-color:                @border;
    background-color:            var(background-alpha);
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    /* The gap to the listview lives on the listview (see below), not here: a
       box emits its spacing even for a child of zero height, so a listview
       hidden by require-input would leave the gap behind and push the input
       row off centre. Identical layout once the listview has rows. */
    spacing:                     0px;
    margin:                      0px;
    padding:                     @menu-padding;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "message" ];
}

inputbar {
    enabled:                     true;
    spacing:                     @menu-spacing;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 vertical;
    children:                    [ "promptbar", "entry" ];
}

promptbar {
    orientation:                 horizontal;
    expand:                      false;
    spacing:                     @menu-spacing;
    margin:                      0px;
    background-color:            transparent;
    children:                    [ "textbox-prompt-colon", "textbox-prompt-label" ];
}

entry {
    border:                      0px;
    enabled:                     true;
    padding:                     @menu-spacing;
    border-radius:               @element-border-radius;
    background-color:            @background;
    border-color:                transparent;
    text-color:                  @foreground;
    placeholder:                 "";
    placeholder-color:           @separator;
}

textbox-prompt-colon {
    expand:                      false;
    border:                      2px;
    padding:                     @menu-icon-padding;
    border-radius:               @element-border-radius;
    border-color:                @accent;
    background-color:            transparent;
    text-color:                  @foreground;
    str:                         "";
}

textbox-prompt-colon, textbox-prompt-label {
    horizontal-align:            0.5;
    vertical-align:              0.5;
}

textbox-prompt-label {
    border:                      2px;
    expand:                      false;
    padding:                     @menu-spacing;
    border-radius:               @element-border-radius;
    border-color:                @selected-background;
    background-color:            transparent;
    text-color:                  @selected-foreground;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;

    spacing:                     5px;
    margin:                      @menu-list-margin;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

scrollbar {
    handle-width:                4px;
    handle-color:                @separator;
    handle-rounded-corners:      false;
    background-color:            @background;
    border-color:                @border;
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     14px;
    border:                      0px solid;
    border-radius:               @element-border-radius;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    border:                      2px;
    border-color:            @selected-background;
    text-color:                  @selected-foreground;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element-icon {
    enabled:                     false;
    size:                        0px;
    background-color:            transparent;
}

message {
    enabled:                     true;
    margin:                      12px 0px 0px 0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @separator;
}

textbox {
    padding:                     6px;
    border:                      0px solid;
    border-radius:               @element-border-radius;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

error-message {
    padding:                     12px;
    border:                      2px solid;
    border-radius:               @window-border-radius;
    border-color:                @border;
    background-color:            @background;
    text-color:                  @foreground;
}
