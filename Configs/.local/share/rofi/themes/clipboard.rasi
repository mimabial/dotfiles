configuration {
    modes:                       "drun";
    show-icons:                 false;
}

@import "~/.config/rofi/colors.rasi"

window {
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border-color:                @border;
    background-color:            @background-alpha;
}
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     @popup-padding;
    orientation:                 vertical;
    children:                    [ "wallbox" , "listbox" ];
    background-color:            transparent;
}
wallbox {
    spacing:                     0em;
    padding:                     0em;
    expand:                      false;
    orientation:                 horizontal;
    background-color:            transparent;
    background-image:            url("~/.cache/hypr/wallpaper/current/wall.blur", width);
    children:                    [ "wallframe" , "inputbar" ];
}
wallframe {
    width:                       5em;
    spacing:                     0em;
    padding:                     0em;
    expand:                      false;
    background-color:            transparent;
    background-image:            url("~/.cache/hypr/wallpaper/current/wall.quad", width);
}

inputbar {
    enabled:                     true;
    padding:                     0em;
    children:                    [ "entry" ];
    background-color:            transparent;
    expand:                      true;
}
entry {
    enabled:                     true;
    padding:                     @control-padding;
    text-color:                  @foreground;
    border:                      1px;
    border-color:                @field-border;
    border-radius:               @element-border-radius;
    background-color:            @field-background;
}

listbox {
    spacing:                     0em;
    padding:                     0em;
    orientation:                 vertical;
    children:                    [ "spacer" , "listview" , "spacer" ];
    background-color:            transparent;
}
listview {
    spacing:                     @row-gap;
    scrollbar:                   true;
    enabled:                     true;
    padding:                     @popup-padding-top;
    columns:                     1;
    lines:                       11; 
    show-icons:                  false;
    cycle:                       true;
    fixed-height:                true;
    fixed-columns:               false;
    expand:                      false;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @foreground;
}
spacer {
    spacing:                     0em;
    padding:                     0em;
    background-color:            transparent;
}

element {
    enabled:                     true;
    padding:                     @control-padding;
    orientation:                 horizontal;
    children:                    [ "element-text" ];
    show-icons:                  false;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            @selected-background;
    text-color:                  @selected-foreground;
}
element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
element-icon {
    enabled:                     false;
    size:                        0em;
    width:                       0em;
    padding:                     0;
    margin:                      0;
    border:                      0;
}
element-text {
    vertical-align:              0.0;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
