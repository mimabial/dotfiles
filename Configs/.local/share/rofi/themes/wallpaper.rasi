@import "shared/thumbnail-grid.rasi"

window {
    fullscreen:                  true;
    width:                       100%;
    height:                      100%;
}
listview {
    spacing:                     2em;
    margin:                      0em;
    padding:                     0em 0em 2em;
    columns:                     10;
    lines:                       1;
    reverse:                     true;
}
element {
    orientation:                 vertical;
}
element-icon {
    size:                        33em;
    border-radius:               0em;
}
element-text {
    padding:                     1em;
}
