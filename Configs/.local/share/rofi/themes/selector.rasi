@import "shared/thumbnail-grid.rasi"

window {
    fullscreen:                  true;
    width:                       100%;
    height:                      100%;
    x-offset:                    0px;
    y-offset:                    0px;
}
listview {
    spacing:                     2.5em;
    padding:                     1.5em;
    lines:                       1;
}
spacer {
    width:                       1em;
}
