{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "output": ["*"],
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,
  "ipc": true,
  "include": [
    "$XDG_CONFIG_HOME/waybar/modules/*json*",
    "$XDG_DATA_HOME/waybar/modules/*json*",
    "$XDG_CONFIG_HOME/waybar/includes/includes.json"
  ],
  "modules-left": ["custom/hyprmenu", "hyprland/workspaces#winbar", "group/active-group"],
  "modules-center": ["ext/workspaces#kanji"],
  "modules-right": ["group/tray-group", "clock#datetime-winbar"],
  "group/active-group": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true
    },
    "modules": [
      "hyprland/workspaces#kanji-active",
      "custom/weather#sunrise-alt",
      "custom/weather#minmax-only-alt",
      "custom/weather#alt"
    ]
  },
  "group/tray-group": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": ["tray#winbar", "custom/cpuinfo#alt", "custom/gpuinfo#alt"]
  }
}
