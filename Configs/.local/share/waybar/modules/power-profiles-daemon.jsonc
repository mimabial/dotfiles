{
  "power-profiles-daemon": {
    "justify": "center",
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "on-click": "hyprshell system/powerprofiles.sh --cycle",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": " ",
      "power-saver": ""
    }
  }
}
