{
  "custom/screenrecord": {
    "justify": "center",
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "signal": 10,
    "exec": "hyprshell screenrecord --status",
    "on-click": "hyprshell screenrecord --toggle --smart",
    "on-click-right": "hyprshell screenrecord --quit"
  }
}
